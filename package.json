{
  "name": "teleschmie-de",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-assets.mjs && date +%s > public/build.txt",
    "build": "node scripts/glossary-linker.mjs && bash scripts/generate-llms-full.sh && astro build && npm run analyze-logs",
