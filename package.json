    "preview": "astro preview",
    "lint": "astro check",
    "check-links": "node scripts/check-links.mjs",
    "analyze-logs": "node scripts/analyze-logs.mjs --generate"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
