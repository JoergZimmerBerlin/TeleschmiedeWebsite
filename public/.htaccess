ErrorDocument 404 /404.html
# Repaired Golden Version - Final IONOS Loop-Fix (Lauf #584)

# 1. Encodings & MIME Types
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .json .html .css .js

<FilesMatch "\.(txt|md)$">
    ForceType 'text/plain; charset=UTF-8'
</FilesMatch>

# 2. Redirects
RewriteEngine On

# A. WWW zu Non-WWW erzwingen (Sicherer Pattern)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://teleschmie.de/$1 [L,R=301]

# B. HTTPS erzwingen (Standard-Check basierend auf $_SERVER Diagnose)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://teleschmie.de%{REQUEST_URI} [L,R=301]

# C. Permanente Weiterleitungen
Redirect 301 /html/impressum.html https://teleschmie.de/impressum/
Redirect 301 /html/antworten.html https://teleschmie.de/leistungen/
Redirect 301 /berlin/adwords-optimierung-sea.html https://teleschmie.de/google-ads-freelancer-berlin/
Redirect 301 /berlin/suchmaschinen-optimierung-seo/seo-agentur-berlin.html https://teleschmie.de/seo-freelancer-berlin/

# 3. Security Headers (Härtung auf A+ Niveau)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS Pro (1 Jahr + Preload für maximale Sicherheit)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Modern Security Policies
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP: Maximale Einschränkung für statische Astro-Seiten (optimiert für GA)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self';"
</IfModule>

# 4. Kompression (Speed-Boost für SEO)
<IfModule mod_deflate.c>
    # Kompression nach MIME-Type (Umfassende Liste)
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/ecmascript
    AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
    
    # Fallback-Kompression für Dateiendungen (Sicher ist sicher)
    <FilesMatch "\.(js|css|xml|json|svg)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# 5. Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|png|jpg|jpeg|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 6. Veraltete Sitemaps (410 Gone)
Redirect 410 /sitemap-index.xml
Redirect 410 /sitemap-0.xml
