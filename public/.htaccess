ErrorDocument 404 /404.html

# Repaired Golden Version - Stable IONOS Pattern (Lauf #574)
<IfModule mod_headers.c>
    Header always set X-Golden-Status "Active-Lauf-574"
</IfModule>

# 1. Encodings & MIME Types
AddDefaultCharset UTF-8
AddType "text/plain; charset=UTF-8" .txt
AddType "text/markdown; charset=UTF-8" .md
AddCharset UTF-8 .txt .md .json .html .css .js

# Force MIME type for AI Crawler files
<Files "llms.txt">
    ForceType 'text/plain; charset=UTF-8'
</Files>
<Files "llms-full.txt">
    ForceType 'text/plain; charset=UTF-8'
</Files>

# 2. Redirects
RewriteEngine On

# A. HTTPS erzwingen (Separate Regelsatz für maximale Kompatibilität)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# B. WWW zu Non-WWW erzwingen
RewriteCond %{HTTP_HOST} ^www\.teleschmie\.de [NC]
RewriteRule ^(.*)$ https://teleschmie.de/$1 [L,R=301]

# C. Permanente Weiterleitungen für Alt-URLs
Redirect 301 /html/impressum.html https://teleschmie.de/impressum/
Redirect 301 /html/antworten.html https://teleschmie.de/leistungen/
Redirect 301 /berlin/adwords-optimierung-sea.html https://teleschmie.de/google-ads-freelancer-berlin/
Redirect 301 /berlin/suchmaschinen-optimierung-seo/seo-agentur-berlin.html https://teleschmie.de/seo-freelancer-berlin/

# 3. Security Headers (Always Set Pattern)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google.com https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 4. Kompression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 5. Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|png|jpg|jpeg|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 6. Veraltete Sitemaps (410 Gone)
Redirect 410 /sitemap-index.xml
Redirect 410 /sitemap-0.xml
