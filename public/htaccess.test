ErrorDocument 404 /404.html
# Repaired Golden Version - Final IONOS Loop-Fix (Lauf #584)

# 1. Encodings & MIME Types
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .md .json .html .css .js

<FilesMatch "\.txt$">
    ForceType 'text/plain; charset=UTF-8'
</FilesMatch>

<FilesMatch "\.md$">
    ForceType 'text/markdown; charset=UTF-8'
</FilesMatch>

<Files "api-catalog">
    ForceType 'application/linkset+json; charset=UTF-8'
</Files>

# 2. Security Headers (Best-in-Class A+ Härtung)
# Hinweis: Wir nutzen 'always set' für maximale Abdeckung, aber 'set' für CSP zur Kompatibilität.
<IfModule mod_headers.c>
    # Basis Härtung
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    
    # HSTS (1 Jahr + Preload)
    # Wir nutzen 'set' statt 'always set' für HSTS, da IONOS 'always' bei 200 OK oft verschluckt.
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Modern Isolation Policies
    Header always set Cross-Origin-Embedder-Policy "unsafe-none"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    
    # Permissions-Policy
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    
    # Content-Security-Policy (Standardisierte Absicherung)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;"
    
    # AI/Agent Discovery (RFC 8288)
    Header add Link "</llms.txt>; rel=\"llms\""
    Header add Link "</llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\""
    Header add Link "</.well-known/mcp.json>; rel=\"service-doc\""
    Header add Link "</.well-known/ai-plugin.json>; rel=\"service-doc\""
    Header add Link "<https://teleschmie.de/sitemap.xml>; rel=\"sitemap\""
</IfModule>

# 3. Redirects & Options
Options -MultiViews
RewriteEngine On

# Markdown Content Negotiation für KI-Agenten
# WICHTIG: Vary: Accept muss gesetzt sein, damit CDNs/Browser-Caches HTML und Markdown sauber trennen
Header append Vary "Accept"

# 1. Root URL (/)
RewriteCond %{HTTP:Accept} text/markdown [NC,OR]
RewriteCond %{HTTP:Accept} text/x-markdown [NC]
RewriteCond %{REQUEST_URI} !\.md$ [NC]
RewriteRule ^$ /index.md [L,T=text/markdown]

# 2. Direkte .html Aufrufe
RewriteCond %{HTTP:Accept} text/markdown [NC,OR]
RewriteCond %{HTTP:Accept} text/x-markdown [NC]
RewriteCond %{REQUEST_URI} !\.md$ [NC]
RewriteRule ^(.*)\.html$ /$1.md [L,T=text/markdown]

# 3. Verzeichnis-URLs mit Trailing Slash (z.B. /ueber-mich/)
RewriteCond %{HTTP:Accept} text/markdown [NC,OR]
RewriteCond %{HTTP:Accept} text/x-markdown [NC]
RewriteCond %{REQUEST_URI} !\.md$ [NC]
RewriteRule ^(.*)/$ /$1/index.md [L,T=text/markdown]

# 4. Verzeichnis-URLs ohne Trailing Slash (z.B. /ueber-mich)
RewriteCond %{HTTP:Accept} text/markdown [NC,OR]
RewriteCond %{HTTP:Accept} text/x-markdown [NC]
RewriteCond %{REQUEST_URI} !\.md$ [NC]
RewriteRule ^(.*[^/])$ /$1/index.md [L,T=text/markdown]

# 5. Direkte .md Aufrufe (Fallback für Crawler/Nutzer)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)\.md$ /$1/index.md [L,T=text/markdown]

# A. WWW zu Non-WWW erzwingen
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://teleschmie.de/$1 [L,R=301]

# B. HTTPS erzwingen
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://teleschmie.de%{REQUEST_URI} [L,R=301]

# C. Permanente Weiterleitungen
Redirect 301 /html/impressum.html https://teleschmie.de/impressum/
Redirect 301 /html/antworten.html https://teleschmie.de/leistungen/
Redirect 301 /berlin/adwords-optimierung-sea.html https://teleschmie.de/google-ads-freelancer-berlin/
Redirect 301 /berlin/suchmaschinen-optimierung-seo/seo-agentur-berlin.html https://teleschmie.de/seo-freelancer-berlin/
Redirect 301 /webdesigner-programmierer-berlin-spandau.html https://teleschmie.de/ueber-mich/


# 4. Kompression (Speed-Boost für SEO)
<IfModule mod_deflate.c>
    # Kompression nach MIME-Type (Umfassende Liste)
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/ecmascript
    AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
    
    # Fallback-Kompression für Dateiendungen (Sicher ist sicher)
    <FilesMatch "\.(js|css|xml|json|svg)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# 5. Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|png|jpg|jpeg|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 6. Veraltete Sitemaps (410 Gone)
Redirect 410 /sitemap-index.xml
Redirect 410 /sitemap-0.xml
