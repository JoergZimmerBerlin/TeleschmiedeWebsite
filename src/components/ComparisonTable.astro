---
interface Props {
  title: string;
  subtitle?: string;
  columns: {
    name: string;
    isPrimary?: boolean;
  }[];
  rows: {
    feature: string;
    values: (string | boolean)[];
  }[];
}

const { title, subtitle, columns, rows } = Astro.props;
---

<div class="my-16">
  <div class="text-center mb-10">
    <h3 class="text-2xl font-bold mb-2">{title}</h3>
    {subtitle && <p class="text-gray-muted text-sm">{subtitle}</p>}
  </div>

  <div class="overflow-x-auto rounded-3xl border border-gray-100 shadow-sm bg-white">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-gray-50/50">
          <th class="p-6 text-sm font-bold text-gray-muted border-b border-gray-100 italic">Funktion / Tool</th>
          {columns.map(col => (
            <th class={`p-6 text-sm font-bold border-b border-gray-100 text-center ${col.isPrimary ? 'bg-lime-accent/5 text-dark' : 'text-gray-muted'}`}>
              <div class="flex flex-col items-center">
                {col.isPrimary && <span class="text-[10px] uppercase tracking-widest text-lime-700 mb-1">Empfohlen</span>}
                {col.name}
              </div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="p-6 text-sm font-bold text-dark border-b border-gray-50" data-label="Funktion / Tool">{row.feature}</td>
            {row.values.map((val, idx) => (
              <td class={`p-6 text-sm text-center border-b border-gray-50 ${columns[idx].isPrimary ? 'bg-lime-accent/5' : ''}`} data-label={columns[idx].name}>
                {typeof val === 'boolean' ? (
                  val ? (
                    <div class="flex justify-center">
                      <div class="w-6 h-6 bg-lime-accent/20 text-lime-700 flex items-center justify-center rounded-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                    </div>
                  ) : (
                    <div class="flex justify-center">
                      <div class="w-6 h-6 bg-gray-100 text-gray-300 flex items-center justify-center rounded-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      </div>
                    </div>
                  )
                ) : (
                  <span class="font-medium text-gray-text">{val}</span>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
