import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
  image?: any;
  tags?: string[];
}

const { title, description, buttonText, buttonLink, image, tags = ['Exklusiv', 'GRATIS'] } = Astro.props;
---

<div class="my-16 p-1 bg-gradient-to-br from-lime-accent/50 to-dark/5 rounded-[2rem] shadow-xl group">
  <div class="bg-white rounded-[1.8rem] p-8 md:p-10 flex flex-col md:flex-row gap-10 items-center">
    <!-- Visual Preview -->
    <div class="w-full md:w-1/3 relative flex justify-center">
      <div class="absolute inset-0 bg-lime-accent/10 blur-3xl rounded-full scale-150 group-hover:scale-175 transition-transform duration-700"></div>
      {image ? (
        <Image src={image} alt={title} width={200} class="relative z-10 w-48 h-auto shadow-2xl rounded-lg group-hover:-translate-y-2 transition-transform duration-500" />
      ) : (
        <div class="relative z-10 w-40 h-56 bg-gray-100 rounded-lg shadow-2xl flex flex-col p-4 group-hover:-translate-y-2 transition-transform duration-500 overflow-hidden">
           <div class="w-full h-4 bg-gray-200 rounded mb-4"></div>
           <div class="space-y-2">
             <div class="w-full h-2 bg-gray-200 rounded"></div>
             <div class="w-3/4 h-2 bg-gray-200 rounded"></div>
             <div class="w-5/6 h-2 bg-gray-200 rounded"></div>
           </div>
           <div class="mt-auto flex justify-between">
              <div class="w-10 h-10 bg-lime-accent/30 rounded-full"></div>
              <div class="w-12 h-2 bg-gray-200 rounded self-end"></div>
           </div>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="w-full md:w-2/3 text-center md:text-left">
      <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-4">
        {tags.map(tag => (
          <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-1 bg-lime-accent/20 text-lime-800 rounded-md">
            {tag}
          </span>
        ))}
      </div>
      <h3 class="text-2xl md:text-3xl font-bold mb-4 text-dark m-0 !mt-0">{title}</h3>
      <p class="text-gray-muted text-lg mb-8 leading-relaxed">
        {description}
      </p>
      
      <a 
        href={buttonLink} 
        class="btn-primary inline-flex items-center gap-3 shadow-lg shadow-lime-accent/20 group/btn"
        target="_blank"
      >
        {buttonText}
        <svg class="w-5 h-5 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </a>
    </div>
  </div>
</div>
