---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="section">
  <div class="container-narrow">
    <p class="subheadline mb-4">Was ich anbiete</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-12">
      Meine <span class="highlight">Expertise</span>
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      <a href={`${baseUrl}/seo-freelancer-berlin/`} class="group p-6 rounded-2xl bg-gray-50 border border-transparent hover:border-lime-accent hover:bg-white hover:shadow-xl transition-all duration-300" title="SEO-Strategie Tiefgehende Analysen und Konzepte für nachhaltige Sichtbarkeit bei Google. Keyword-Potenzialanalysen und technische Optimierung.">
        <h3 class="text-xl font-bold mb-3 group-hover:text-lime-600">SEO-Strategie</h3>
        <p class="text-gray-muted leading-relaxed">
          Tiefgehende Analysen und Konzepte für nachhaltige Sichtbarkeit bei Google.
          Keyword-Potenzialanalysen und technische Optimierung.
        </p>
      </a>

      <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="group p-6 rounded-2xl bg-gray-50 border border-transparent hover:border-lime-accent hover:bg-white hover:shadow-xl transition-all duration-300" title="Google Ads Performance-optimierte Kampagnen mit Fokus auf ROI. Von der Strategie bis zur täglichen Optimierung.">
        <h3 class="text-xl font-bold mb-3 group-hover:text-lime-600">Google Ads</h3>
        <p class="text-gray-muted leading-relaxed">
          Performance-optimierte Kampagnen mit Fokus auf ROI.
          Von der Strategie bis zur täglichen Optimierung.
        </p>
      </a>

      <a href={`${baseUrl}/seo-sprechstunde/`} class="group p-6 rounded-2xl bg-gray-50 border border-transparent hover:border-lime-accent hover:bg-white hover:shadow-xl transition-all duration-300" title="SEO-Sprechstunde 2-stündiger Videocall für 400€. Deine Fragen, meine Antworten. Alles was ich in 20 Jahren gelernt habe.">
        <h3 class="text-xl font-bold mb-3 group-hover:text-lime-600">SEO-Sprechstunde</h3>
        <p class="text-gray-muted leading-relaxed">
          2-stündiger Videocall für 400€. Deine Fragen, meine Antworten.
          Alles was ich in 20 Jahren gelernt habe.
        </p>
      </a>

      <a href={`${baseUrl}/leistungen/`} class="group p-6 rounded-2xl bg-gray-50 border border-transparent hover:border-lime-accent hover:bg-white hover:shadow-xl transition-all duration-300" title="Zweite Meinung Unabhängige Einschätzung deiner bisherigen Agenturarbeit. Ehrlich, fair und respektvoll.">
        <h3 class="text-xl font-bold mb-3 group-hover:text-lime-600">Zweite Meinung</h3>
        <p class="text-gray-muted leading-relaxed">
          Unabhängige Einschätzung deiner bisherigen Agenturarbeit.
          Ehrlich, fair und respektvoll.
        </p>
      </a>
    </div>

    <div class="mt-12 text-center">
      <a href={`${baseUrl}/leistungen/`} class="btn-secondary" title="Alle Leistungen ansehen →">
        Alle Leistungen ansehen →
      </a>
    </div>
  </div>
</section>
