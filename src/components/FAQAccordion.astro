---
interface Props {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { faqs } = Astro.props;
---

<div class="my-12 space-y-4">
  <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
    <span class="w-8 h-8 bg-dark text-white flex items-center justify-center rounded-lg text-sm">?</span>
    Häufig gestellte Fragen (FAQ)
  </h2>
  
  <div class="space-y-4">
    {faqs.map((faq, index) => (
      <details class="group bg-gray-50 border border-gray-100 rounded-2xl overflow-hidden transition-all duration-300 open:bg-white open:shadow-md">
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
          <span class="font-bold text-dark pr-8">{faq.question}</span>
          <span class="relative flex-shrink-0 w-6 h-6 transform transition-transform duration-300 group-open:rotate-45">
            <span class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-400 -translate-y-1/2 rounded-full"></span>
            <span class="absolute top-0 left-1/2 w-0.5 h-full bg-gray-400 -translate-x-1/2 rounded-full"></span>
          </span>
        </summary>
        <div class="px-6 pb-6 text-gray-muted leading-relaxed prose prose-sm max-w-none" set:html={faq.answer} />

      </details>
    ))}
  </div>
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
