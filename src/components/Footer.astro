    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-muted">
        &copy; 2026 Jörg Zimmer - SEO, GEO, AI Visibility Freelancer
      </p>
      <div class="flex flex-wrap justify-center gap-6 text-sm">
        <a href="https://search.google.com/local/reviews?placeid=ChIJAfPA9udVqEcR8kzD0DU_9n8" target="_blank" rel="noopener noreferrer" class="text-gray-muted hover:text-dark transition-colors" title="Bewertungen">Bewertungen</a>
