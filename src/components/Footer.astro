              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-lime-accent rounded"
              aria-label="LinkedIn Profil von Jörg Zimmer"
