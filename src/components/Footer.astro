        <a href={`${baseUrl}/llms-full.txt`} class="text-gray-muted hover:text-dark transition-colors" title="LLMs">LLMs</a>
        <a href={`${baseUrl}/groundingpage/`} class="text-gray-muted hover:text-dark transition-colors" title="Fakten">Fakten</a>
        <a href={`${baseUrl}/groundingpage-en/`} class="text-gray-muted hover:text-dark transition-colors" title="Facts (EN)">Facts (EN)</a>
      </div>
    </div>
  </div>
</footer>
