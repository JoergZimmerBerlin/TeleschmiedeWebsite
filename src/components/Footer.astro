              Xing
            </a>
          </li>
          <li>
            <a href="https://linktr.ee/jorgzimmer"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-lime-accent rounded"
              aria-label="Linktree von Jörg Zimmer"
             title="Linktree">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              Linktree
            </a>
          </li>
          <li>
            <a href="https://youtube.com/playlist?list=PLgdsdoDkv_fp2z0vni5F3reEYqeUA-6PZ&si=LpQHJP5sH2SvIvEr"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-lime-accent rounded"
              aria-label="YouTube Playlist von Jörg Zimmer"
             title="YouTube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              YouTube
