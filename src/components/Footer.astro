---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo-teleschmiede.webp';
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-gray-50 border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <a href={`${baseUrl}/`} class="flex items-center gap-2.5" title="TELESCHMIE.DE">
          <Image
            src={logoImage}
            alt="SEO, GEO, AI Visibility Freelancer mit 25 Jahren Erfahrung als Algorithmus Experte und heute Unternehmensberater für digitale Sichtbarkeit."
            title="Teleschmiede Logo"
            width={54}
            height={54}
            class="w-8 h-8 rounded-full object-cover"
            loading="lazy"
          />
          <span class="text-xl font-bold text-dark">TELESCHMIE<span class="text-lime-accent">.</span>DE</span>
        </a>
        <p class="mt-3 text-gray-muted text-sm">
          Jörg Zimmer<br />
          SEO, GEO, AI Freelancer<br />
          Zu den Fichtewiesen 16<br />
          13587 Berlin Spandau<br />
          Tel: <a href="tel:+493049208184" class="hover:text-dark transition-colors" title="030 49208184">030 49208184</a><br />
          Email: <a href="mailto:info@teleschmie.de" class="hover:text-dark transition-colors" title="info@teleschmie.de">info@teleschmie.de</a>
        </p>
      </div>

      <!-- Kategorien & Wissen -->
      <div>
        <p class="font-semibold text-dark mb-3">Kategorien & Wissen</p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${baseUrl}/blog/`} class="text-dark font-bold hover:text-lime-600 transition-colors" title="Blog">Zum SEO Blog</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/blog/seo-praxis/`} class="text-gray-muted hover:text-dark transition-colors" title="SEO Praxis">SEO Praxis</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/blog/ai-seo/`} class="text-gray-muted hover:text-dark transition-colors" title="AI SEO">AI & Agentic SEO</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/blog/events-and-networking/`} class="text-gray-muted hover:text-dark transition-colors" title="Events & Networking">Events & Networking</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/blog/tech-seo-and-tools/`} class="text-gray-muted hover:text-dark transition-colors" title="Tech SEO & Tools">Tech SEO & Tools</a></li>
          <li class="mt-4"><a href={`${baseUrl}/glossar/`} class="text-dark font-bold hover:text-lime-600 transition-colors" title="Glossar">Zum SEO Glossar</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/glossar/seo-basics-onpage/`} class="text-gray-muted hover:text-dark transition-colors" title="SEO Basics & Onpage">SEO Basics & Onpage</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/glossar/technisches-seo-ux/`} class="text-gray-muted hover:text-dark transition-colors" title="Technisches SEO & UX">Technisches SEO & UX</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/glossar/ai-seo-generative-search/`} class="text-gray-muted hover:text-dark transition-colors" title="AI SEO & Generative Search">AI SEO & Generative Search</a></li>
          <li class="pl-3 border-l border-gray-200"><a href={`${baseUrl}/glossar/e-e-a-t-offpage/`} class="text-gray-muted hover:text-dark transition-colors" title="E-E-A-T & Offpage">E-E-A-T & Offpage</a></li>
        </ul>
      </div>

      <!-- Navigation -->
      <div>
        <p class="font-semibold text-dark mb-3">Navigation</p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="text-gray-muted hover:text-dark transition-colors" title="Google Ads Freelancer Berlin">Google Ads Freelancer Berlin</a></li>
          <li><a href={`${baseUrl}/seo-freelancer-berlin/`} class="text-gray-muted hover:text-dark transition-colors" title="SEO Freelancer Berlin">SEO Freelancer Berlin</a></li>
          <li><a href={`${baseUrl}/seo-sprechstunde/`} class="text-gray-muted hover:text-dark transition-colors" title="SEO Sprechstunde">SEO Sprechstunde</a></li>
          <li><a href={`${baseUrl}/ueber-mich/`} class="text-gray-muted hover:text-dark transition-colors" title="Über mich">Über mich</a></li>
