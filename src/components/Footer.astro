          <li><a href={`${baseUrl}/freelancer-team/`} class="text-gray-muted hover:text-dark transition-colors" title="Freelancer Team">Freelancer Team</a></li>
          <li><a href={`${baseUrl}/videos/`} class="text-gray-muted hover:text-dark transition-colors" title="Videos & Podcasts">Videos & Podcasts</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="font-semibold text-dark mb-3">Kontakt</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`${baseUrl}/kontakt/`} 
               class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1 focus:outline-none focus:ring-2 focus:ring-lime-accent rounded" 
               title="Kontakt aufnehmen">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" /><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" /></svg>
              Kontakt aufnehmen
