---
interface Props {
  takeaways: string[];
}

const { takeaways } = Astro.props;
---

<div class="my-12 p-8 bg-lime-accent/5 rounded-3xl relative overflow-hidden group">
  <!-- Decorative 3D-ish element -->
  <div class="absolute -top-4 -right-4 w-24 h-24 bg-lime-accent/10 rounded-full blur-3xl group-hover:scale-110 transition-transform duration-500"></div>
  
  <div class="relative z-10">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 bg-lime-accent flex items-center justify-center rounded-xl shadow-sm rotate-3 group-hover:rotate-0 transition-transform">
        <svg class="w-6 h-6 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-dark m-0 !mt-0">Wichtigste Erkenntnisse</h3>
    </div>
    
    <ul class="space-y-4 m-0 p-0 list-none">
      {takeaways.map((item) => (
        <li class="flex items-start gap-3 m-0">
          <svg class="w-5 h-5 text-lime-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-gray-text font-medium leading-relaxed">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
