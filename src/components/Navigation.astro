---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo-teleschmiede.webp';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${baseUrl}/`, label: 'Jörg Zimmer' },
  { href: `${baseUrl}/ueber-mich/`, label: 'Über mich' },
  { href: `${baseUrl}/leistungen/`, label: 'Leistungen' },
  { href: `${baseUrl}/seo-freelancer-berlin/`, label: 'SEO Berlin' },
  { href: `${baseUrl}/blog/`, label: 'Blog' },
];

const isActive = (href: string) => {
  const normalizedPath = currentPath.replace(/\/$/, '') || '/';
  const normalizedHref = href.replace(/\/$/, '') || '/';
  if (normalizedHref === baseUrl || normalizedHref === `${baseUrl}/`) {
    return normalizedPath === baseUrl || normalizedPath === `${baseUrl}/`;
  }
  return normalizedPath.startsWith(normalizedHref);
};
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 py-4">
    <nav class="flex items-center justify-between">
      <!-- Logo -->
      <a href={`${baseUrl}/`} class="flex items-center gap-2.5 group" title="TELESCHMIE.DE">
        <Image
          src={logoImage}
          alt="SEO, GEO, AI Visibility Freelancer mit 25 Jahren Erfahrung als Algorithmus Experte und heute Unternehmensberater für digitale Sichtbarkeit."
          title="Teleschmiede Logo"
          width={100}
          height={100}
          class="w-10 h-10 rounded-full object-cover"
        />
        <span class="text-xl font-bold text-dark group-hover:text-lime-600 transition-colors">TELESCHMIE<span class="text-lime-accent">.</span>DE</span>
      </a>

      <!-- Desktop Navigation (Pill-Style wie lau.do) -->
      <div class="hidden md:flex items-center gap-1 bg-gray-50 rounded-full p-1.5">
        {navItems.map((item) => (
          <a href={item.href}
            data-astro-prefetch
            class:list={[
              'px-4 py-2 rounded-full text-sm font-medium transition-all duration-200',
              isActive(item.href)
                ? 'bg-white text-dark shadow-sm'
                : 'text-gray-muted hover:text-dark hover:bg-gray-100'
            ]}
           title={item.label}>
            {item.label}
          </a>
        ))}
      </div>

      <a href={`${baseUrl}/kontakt/`}
        class="hidden md:inline-flex btn-primary"
       title="Kontakt">
        Kontakt
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-dark hover:bg-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-lime-accent"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
      <div class="flex flex-col gap-2">
        {navItems.map((item) => (
          <a href={item.href}
            data-astro-prefetch
            class:list={[
              'px-4 py-3 rounded-lg font-medium transition-colors',
              isActive(item.href)
                ? 'bg-gray-100 text-dark'
                : 'text-gray-muted hover:bg-gray-50'
            ]}
           title={item.label}>
            {item.label}
          </a>
        ))}
        <a href={`${baseUrl}/kontakt/`} class="btn-primary text-center mt-2" title="Kontakt">
          Kontakt
        </a>
      </div>
    </div>
  </div>
</header>

<script src="/js/navigation.js" is:inline></script>
