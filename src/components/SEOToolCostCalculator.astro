---
// src/components/SEOToolCostCalculator.astro
// Pure Vanilla-JS, touch-optimized, zero external dependencies
---

<div class="w-full my-8 p-6 md:p-10 bg-dark text-white rounded-[2.5rem] shadow-2xl relative overflow-hidden border border-white/10" id="kostenrechner">
  <!-- Glow Accents -->
  <div class="absolute -top-32 -left-32 w-72 h-72 bg-lime-accent/15 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-72 h-72 bg-lime-accent/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <!-- Compact Calculator Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-lime-accent text-dark flex items-center justify-center font-bold text-base">🎛️</span>
        <h2 class="text-xl md:text-2xl font-bold text-white font-headings">Dein Team-Setup konfigurieren:</h2>
      </div>
      <span class="text-xs text-lime-accent/80 font-medium">⚡ Live-Vergleich aller 8 SEO-Suiten</span>
    </div>

    <!-- Sliders Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 bg-white/5 p-6 md:p-8 rounded-3xl border border-white/10">
      <!-- Slider 1: Projekte -->
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <label for="slider-projects" class="text-sm font-medium text-gray-300">Kundenprojekte / Domains</label>
          <span id="val-projects" class="text-lime-accent font-bold text-xl">15</span>
        </div>
        <input 
          type="range" 
          id="slider-projects" 
          min="1" 
          max="50" 
          value="15" 
          step="1"
          class="w-full h-2.5 bg-white/15 rounded-lg appearance-none cursor-pointer accent-lime-accent focus:outline-none"
        />
        <div class="flex justify-between text-xs text-gray-400">
          <span>1 Projekt</span>
          <span>25</span>
          <span>50 Projekte</span>
        </div>
      </div>

      <!-- Slider 2: Mitarbeiter / Seats -->
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <label for="slider-seats" class="text-sm font-medium text-gray-300">Mitarbeiter-Sitze im Team</label>
          <span id="val-seats" class="text-lime-accent font-bold text-xl">3</span>
        </div>
        <input 
          type="range" 
          id="slider-seats" 
          min="1" 
          max="10" 
          value="3" 
          step="1"
          class="w-full h-2.5 bg-white/15 rounded-lg appearance-none cursor-pointer accent-lime-accent focus:outline-none"
        />
        <div class="flex justify-between text-xs text-gray-400">
          <span>1 Nutzer</span>
          <span>5</span>
          <span>10 Nutzer</span>
        </div>
      </div>

      <!-- Slider 3: Keywords -->
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <label for="slider-keywords" class="text-sm font-medium text-gray-300">Keywords im Tracking</label>
          <span id="val-keywords" class="text-lime-accent font-bold text-xl">3.000</span>
        </div>
        <input 
          type="range" 
          id="slider-keywords" 
          min="500" 
          max="10000" 
          value="3000" 
          step="500"
          class="w-full h-2.5 bg-white/15 rounded-lg appearance-none cursor-pointer accent-lime-accent focus:outline-none"
        />
        <div class="flex justify-between text-xs text-gray-400">
          <span>500</span>
          <span>5.000</span>
          <span>10.000</span>
        </div>
      </div>
    </div>

    <!-- Savings Highlight Box -->
    <div class="bg-gradient-to-br from-lime-accent/20 to-lime-accent/5 border-2 border-lime-accent/40 rounded-3xl p-6 md:p-8 mb-10 text-center relative overflow-hidden">
      <div class="inline-block px-3 py-1 bg-lime-accent text-dark text-xs font-black uppercase tracking-wider rounded-full mb-2">
        Deine jährliche Maximal-Ersparnis
      </div>
      <div class="text-4xl md:text-6xl font-extrabold text-lime-accent font-headings tracking-tight my-2" id="max-savings-display">
        2.772 €
      </div>
      <p class="text-gray-200 text-sm md:text-base max-w-xl mx-auto" id="savings-subtitle">
        So viel Budget spart deine Agentur pro Jahr beim Wechsel von Sistrix Professional auf SE Ranking Growth (inkl. 3 Sitzen und unbegrenzten Gast-Links).
      </p>
    </div>

    <!-- Live Cost Comparison Table / Cards -->
    <div class="mb-10">
      <h3 class="text-xl md:text-2xl font-bold mb-4 flex items-center gap-2">
        <span>📊</span> Jährliche Gesamtkosten im direkten Vergleich
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm md:text-base border-collapse">
          <thead>
            <tr class="border-b border-white/10 text-gray-400 text-xs uppercase tracking-wider">
              <th class="py-3 px-4">Tool</th>
              <th class="py-3 px-4">Passender Tarif</th>
              <th class="py-3 px-4">Inklusive Mitarbeiter-Sitze</th>
              <th class="py-3 px-4 text-right">Kosten / Jahr (netto)</th>
              <th class="py-3 px-4 text-right">Differenz zu SE Ranking</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <!-- SE Ranking (Hero Row) -->
            <tr class="bg-lime-accent/15 text-white font-bold border-l-4 border-lime-accent">
              <td class="py-4 px-4 flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-lime-accent animate-pulse"></span>
                <span>SE Ranking (Empfehlung)</span>
              </td>
              <td class="py-4 px-4" id="seranking-plan-label">Growth (188 €/Mo)</td>
              <td class="py-4 px-4" id="seranking-seats-label">3 Manager-Sitze inkl.</td>
              <td class="py-4 px-4 text-right text-lime-accent font-mono text-lg" id="cost-seranking">2.256 €</td>
              <td class="py-4 px-4 text-right">
                <a 
                  href="https://seranking.com/de/subscription.html?ga=4169588&source=kostenrechner" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-block bg-lime-accent text-dark text-xs font-bold px-3 py-1 rounded-full hover:bg-white hover:scale-105 transition-all shadow-sm cursor-pointer whitespace-nowrap"
                  title="Offizielle Tarife & Preise von SE Ranking ansehen"
                >
                  Referenz
                </a>
              </td>
            </tr>

            <!-- Sistrix -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">SISTRIX</td>
              <td class="py-3.5 px-4 text-gray-400" id="sistrix-plan-label">Professional (419 €/Mo)</td>
              <td class="py-3.5 px-4 text-gray-400">Bis zu 6 Profile</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-sistrix">5.028 €</td>
              <td class="py-3.5 px-4 text-right text-red-400 font-bold" id="diff-sistrix">+ 2.772 €</td>
            </tr>

            <!-- Semrush -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">Semrush</td>
              <td class="py-3.5 px-4 text-gray-400" id="semrush-plan-label">Guru (249 $ + Sitze)</td>
              <td class="py-3.5 px-4 text-gray-400">Nur 1 Sitz inkl. (+80 $/Sitz)</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-semrush">4.520 €</td>
              <td class="py-3.5 px-4 text-right text-red-400 font-bold" id="diff-semrush">+ 2.264 €</td>
            </tr>

            <!-- Ahrefs -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">Ahrefs</td>
              <td class="py-3.5 px-4 text-gray-400" id="ahrefs-plan-label">Standard (249 $ + Sitze)</td>
              <td class="py-3.5 px-4 text-gray-400">Nur 1 Sitz inkl. (+60 $/Sitz)</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-ahrefs">4.070 €</td>
              <td class="py-3.5 px-4 text-right text-red-400 font-bold" id="diff-ahrefs">+ 1.814 €</td>
            </tr>

            <!-- Seobility -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">Seobility</td>
              <td class="py-3.5 px-4 text-gray-400" id="seobility-plan-label">Agency (179,90 €/Mo)</td>
              <td class="py-3.5 px-4 text-gray-400">Auf Anfrage</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-seobility">1.728 €</td>
              <td class="py-3.5 px-4 text-right text-lime-400 font-medium" id="diff-seobility">- 528 € *</td>
            </tr>

            <!-- XOVI -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">XOVI</td>
              <td class="py-3.5 px-4 text-gray-400" id="xovi-plan-label">Business (149 €/Mo)</td>
              <td class="py-3.5 px-4 text-gray-400">3 Voll- + 3 Lese-Zugänge</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-xovi">1.608 €</td>
              <td class="py-3.5 px-4 text-right text-lime-400 font-medium" id="diff-xovi">- 648 € *</td>
            </tr>

            <!-- Mangools -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">Mangools</td>
              <td class="py-3.5 px-4 text-gray-400" id="mangools-plan-label">Agency (~89 $ jährl.)</td>
              <td class="py-3.5 px-4 text-gray-400">5 Sitze inkl.</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-mangools">984 €</td>
              <td class="py-3.5 px-4 text-right text-lime-400 font-medium" id="diff-mangools">- 1.272 € *</td>
            </tr>

            <!-- Ubersuggest -->
            <tr class="hover:bg-white/5 transition-colors">
              <td class="py-3.5 px-4 font-semibold text-gray-200">Ubersuggest</td>
              <td class="py-3.5 px-4 text-gray-400" id="ubersuggest-plan-label">Enterprise (99 €/Mo)</td>
              <td class="py-3.5 px-4 text-gray-400">Mehrere Nutzer</td>
              <td class="py-3.5 px-4 text-right font-mono text-gray-200" id="cost-ubersuggest">1.188 €</td>
              <td class="py-3.5 px-4 text-right text-lime-400 font-medium" id="diff-ubersuggest">- 1.068 € *</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-gray-400 mt-3 italic">
        * Hinweis zu günstigeren Tools: Seobility, XOVI, Mangools und Ubersuggest sind nominell günstiger, bieten jedoch für Agenturen stark limitierte Keyword-Grenzen (z. B. max. 1.500 Keywords bei Seobility Agency vs. 5.000 bei SE Ranking), keine vollwertigen Top-100-Rankings oder keine modernen API- und MCP-Schnittstellen.
      </p>
    </div>

    <!-- Smart CTA Dual Action -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-white/10">
      <a 
        href="https://seranking.com/de/?ga=4169588&source=kostenrechner" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center bg-lime-accent text-dark font-extrabold py-4 px-6 rounded-2xl hover:bg-lime-400 transition-all text-center shadow-lg hover:scale-[1.02] transform duration-200 text-base md:text-lg"
      >
        SE Ranking 14 Tage kostenlos testen
      </a>

      <a 
        href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center justify-center bg-white/10 text-white font-bold py-4 px-6 rounded-2xl hover:bg-white/20 transition-all text-center border border-white/15 text-base md:text-lg"
      >
        15% Agentur-Rabattcode anfragen (LinkedIn)
      </a>
    </div>

    <div class="mt-4 text-center">
      <p class="text-xs text-gray-400">
        Keine Kreditkarte für den Test erforderlich • 14 Tage voller Funktionsumfang • Bei Jahresabo inkl. kostenlosem Migrationsservice
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const slProjects = document.getElementById('slider-projects');
    const slSeats = document.getElementById('slider-seats');
    const slKeywords = document.getElementById('slider-keywords');

    const valProjects = document.getElementById('val-projects');
    const valSeats = document.getElementById('val-seats');
    const valKeywords = document.getElementById('val-keywords');

    const maxSavingsDisplay = document.getElementById('max-savings-display');
    const savingsSubtitle = document.getElementById('savings-subtitle');

    const costSERankingEl = document.getElementById('cost-seranking');
    const costSistrixEl = document.getElementById('cost-sistrix');
    const costSemrushEl = document.getElementById('cost-semrush');
    const costAhrefsEl = document.getElementById('cost-ahrefs');
    const costSeobilityEl = document.getElementById('cost-seobility');
    const costXoviEl = document.getElementById('cost-xovi');
    const costMangoolsEl = document.getElementById('cost-mangools');
    const costUbersuggestEl = document.getElementById('cost-ubersuggest');

    const diffSistrixEl = document.getElementById('diff-sistrix');
    const diffSemrushEl = document.getElementById('diff-semrush');
    const diffAhrefsEl = document.getElementById('diff-ahrefs');
    const diffSeobilityEl = document.getElementById('diff-seobility');
    const diffXoviEl = document.getElementById('diff-xovi');
    const diffMangoolsEl = document.getElementById('diff-mangools');
    const diffUbersuggestEl = document.getElementById('diff-ubersuggest');

    const serankingPlanLabel = document.getElementById('seranking-plan-label');
    const serankingSeatsLabel = document.getElementById('seranking-seats-label');

    function updateCalculator() {
      const projects = parseInt(slProjects.value, 10);
      const seats = parseInt(slSeats.value, 10);
      const keywords = parseInt(slKeywords.value, 10);

      valProjects.textContent = projects;
      valSeats.textContent = seats;
      valKeywords.textContent = keywords.toLocaleString('de-DE');

      // 1. SE Ranking Calculation
      let costSERanking = 0;
      if (projects <= 10 && seats === 1 && keywords <= 2000) {
        costSERanking = 87.20 * 12; // 1046 €
        serankingPlanLabel.textContent = 'Core (87,20 €/Mo)';
        serankingSeatsLabel.textContent = '1 Manager-Sitz inkl.';
      } else {
        const baseGrowth = 188 * 12; // 2256 €
        const extraSeats = Math.max(0, seats - 3);
        costSERanking = baseGrowth + (extraSeats * 15 * 12);
        serankingPlanLabel.textContent = 'Growth (188 €/Mo)';
        serankingSeatsLabel.textContent = seats <= 3 ? '3 Manager-Sitze inkl.' : `3 inkl. + ${extraSeats} Zusatz-Sitze`;
      }

      // 2. SISTRIX Calculation
      let costSistrix = 0;
      if (seats === 1 && keywords <= 1000 && projects <= 3) {
        costSistrix = 119 * 12;
      } else if (seats <= 3 && keywords <= 2500 && projects <= 6) {
        costSistrix = 239 * 12;
      } else if (seats <= 6) {
        costSistrix = 419 * 12;
      } else {
        costSistrix = 799 * 12;
      }

      // 3. Semrush Calculation
      let costSemrush = 0;
      if (projects <= 5 && keywords <= 500) {
        costSemrush = (129 + Math.max(0, seats - 1) * 41) * 12;
      } else if (projects <= 15 && keywords <= 1500) {
        costSemrush = (230 + Math.max(0, seats - 1) * 74) * 12;
      } else {
        costSemrush = (460 + Math.max(0, seats - 1) * 92) * 12;
      }

      // 4. Ahrefs Calculation
      let costAhrefs = 0;
      if (projects <= 5 && keywords <= 750 && seats <= 3) {
        costAhrefs = (119 + Math.max(0, seats - 1) * 37) * 12;
      } else if (projects <= 20 && keywords <= 2000) {
        costAhrefs = (230 + Math.max(0, seats - 1) * 55) * 12;
      } else {
        costAhrefs = (415 + Math.max(0, seats - 1) * 74) * 12;
      }

      // 5. Seobility
      let costSeobility = (projects <= 3 && keywords <= 300) ? Math.round(49.90 * 12) : 1728;

      // 6. XOVI
      let costXovi = 0;
      if (seats === 1 && projects <= 5) {
        costXovi = 1188;
      } else if (seats <= 3) {
        costXovi = 1608;
      } else {
        costXovi = 5388;
      }

      // 7. Mangools
      let costMangools = 0;
      if (seats === 1 && keywords <= 200) {
        costMangools = 358;
      } else if (seats <= 3 && keywords <= 700) {
        costMangools = 538;
      } else {
        const extraMangoolsSeats = Math.max(0, seats - 5);
        costMangools = 984 + (extraMangoolsSeats * 11 * 12);
      }

      // 8. Ubersuggest
      let costUbersuggest = 0;
      if (projects <= 3 && seats === 1) {
        costUbersuggest = 348;
      } else if (projects <= 7 && seats <= 2) {
        costUbersuggest = 588;
      } else {
        costUbersuggest = 1188;
      }

      const formatEur = (num) => Math.round(num).toLocaleString('de-DE') + ' €';

      costSERankingEl.textContent = formatEur(costSERanking);
      costSistrixEl.textContent = formatEur(costSistrix);
      costSemrushEl.textContent = formatEur(costSemrush);
      costAhrefsEl.textContent = formatEur(costAhrefs);
      costSeobilityEl.textContent = formatEur(costSeobility);
      costXoviEl.textContent = formatEur(costXovi);
      costMangoolsEl.textContent = formatEur(costMangools);
      costUbersuggestEl.textContent = formatEur(costUbersuggest);

      const formatDiff = (toolCost) => {
        const diff = Math.round(toolCost - costSERanking);
        if (diff > 0) {
          return '+ ' + diff.toLocaleString('de-DE') + ' €';
        } else if (diff < 0) {
          return '- ' + Math.abs(diff).toLocaleString('de-DE') + ' € *';
        }
        return '0 €';
      };

      diffSistrixEl.textContent = formatDiff(costSistrix);
      diffSemrushEl.textContent = formatDiff(costSemrush);
      diffAhrefsEl.textContent = formatDiff(costAhrefs);
      diffSeobilityEl.textContent = formatDiff(costSeobility);
      diffXoviEl.textContent = formatDiff(costXovi);
      diffMangoolsEl.textContent = formatDiff(costMangools);
      diffUbersuggestEl.textContent = formatDiff(costUbersuggest);

      const benchmarkCost = Math.max(costSistrix, costSemrush);
      const maxSavings = Math.max(0, benchmarkCost - costSERanking);
      maxSavingsDisplay.textContent = formatEur(maxSavings);

      const benchmarkTool = costSistrix >= costSemrush ? 'Sistrix' : 'Semrush';
      savingsSubtitle.textContent = `So viel Budget spart dein Team pro Jahr beim Einsatz von SE Ranking im Vergleich zu ${benchmarkTool} bei deinem gewählten Setup (${seats} Nutzer, ${projects} Projekte, ${keywords.toLocaleString('de-DE')} Keywords).`;
    }

    slProjects.addEventListener('input', updateCalculator);
    slSeats.addEventListener('input', updateCalculator);
    slKeywords.addEventListener('input', updateCalculator);

    updateCalculator();
  })();
</script>
