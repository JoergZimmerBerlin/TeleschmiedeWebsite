    }
  ]
};

// Central Business Entity
const businessEntity: any = {
  "@type": ["Organization", "ProfessionalService", "LocalBusiness"],
  "@id": businessId,
  "name": "Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau",
  "description": description || "Individuelle SEO & SEA Beratung mit über 24 Jahren Erfahrung.",
  "url": siteUrl,
  "sameAs": [
    "https://www.google.com/maps?cid=7968593441639017414",
    "https://search.google.com/local/reviews?placeid=ChIJAfPA9udVqEcR8kzD0DU_9n8"
  ],
  "telephone": "+493049208184",
  "email": "info@teleschmie.de",
  "priceRange": "€€",
  "vatID": "DE232939553",
  "foundingDate": "2001-07-23",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Zu den Fichtewiesen 16",
    "addressLocality": "Berlin",
    "addressRegion": "Berlin",
    "postalCode": "13587",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.5591,
    "longitude": 13.1883
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "hasMap": "https://www.google.com/maps?cid=7968593441639017414",
  "founder": { "@id": personId },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "reviewCount": "24"
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Patrick They"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      },
      "reviewBody": "Down to earth, fair, hilfreich - in der ganzen Welt der SEO \"Experten\" jemand der einem einfach unkompliziert weiterhilft. Ich bin froh, dass ich ihn gefunden hab. Meine Website hat Traffic, meine Google Ads Kampagene funktioniert - ich kann Jörg Zimmer nur empfehlen.",
      "publisher": {
        "@type": "Organization",
        "name": "Google"
      }
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Martin Meng"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      },
      "reviewBody": "Jörg ist herausragend: In wenigen Minuten hat er meine drängendsten Probleme in Sachen SEA und SEO identifiziert, Lösungsvorschläge gemacht und mich nicht, wie so oft bei anderen Dienstleistern erlebt, mit unklaren Aufgaben zurückgelassen. Er vertraut darauf, dass seine Dienstleistung so viel Wert bringt, dass die Kunden gerne wieder buchen - und genau das ist auch der Fall. TOP EMPFEHLUNG!",
      "publisher": {
        "@type": "Organization",
        "name": "Google"
      }
    },
    {
      "@type": "Review",
      "author": {
        "@type": "Organization",
        "name": "Menzel Motors"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      },
      "reviewBody": "Wir pflegen seit vielen Jahren eine enge und sehr gute Zusammenarbeit. Seit dem hat sich in unseren SEA und SEO-Bereich wirklich viel getan. Jörg hat uns über sämtliche Stolpersteine geholfen und bestens beraten. Die beste Entscheidung war, ihn damals noch vor dem eigentlichen Relaunch mit ins Boot zu holen. Herzlichen Dank dafür.",
      "publisher": {
        "@type": "Organization",
        "name": "Google"
      }
    }
  ],
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/images/logo-teleschmiede.webp`
  }
};

const extractPrice = (name: string) => {
  const match = name.match(/(\d+(?:\.\d+)?)\s*€/);
  return match ? match[1].replace('.', '') : null;
};

// Add Offers if provided
if (offers && offers.length > 0) {
  businessEntity.hasOfferCatalog = {
    "@type": "OfferCatalog",
    "name": "Dienstleistungen von Jörg Zimmer",
    "itemListElement": offers.map(offer => {
      const price = extractPrice(offer.name) || extractPrice(offer.description);
      return {
        "@type": "Offer",
        "price": price || undefined,
        "priceCurrency": price ? "EUR" : undefined,
        "itemOffered": {
          "@type": "Service",
          "name": offer.name,
          "description": offer.description
        }
      };
    })
  };
}

const graph: any[] = [
  personEntity,
  businessEntity,
  {
    "@type": "WebSite",
    "@id": websiteId,
    "url": siteUrl,
    "name": "Jörg Zimmer - SEO / GEO / AI Visibility Freelancer",
    "publisher": { "@id": personId },
    "author": { "@id": personId }
  },
  {
    "@type": "WebPage",
    "@id": url,
    "url": url,
    "name": title,
    "description": description,
    "author": { "@id": personId },
    "reviewedBy": { "@id": personId },
    "publisher": { "@id": businessId },
    "breadcrumb": { "@id": breadcrumbId },
    "datePublished": datePublishedISO,
    "dateModified": dateModifiedISO,
    "lastReviewed": lastReviewedISO,
    "isPartOf": { "@id": websiteId },
    "primaryImageOfPage": imageId ? { "@id": imageId } : undefined,
    "about": type === 'default' ? { "@id": businessId } : undefined,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", "main p:first-of-type"]
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": breadcrumbId,
    "itemListElement": breadcrumbItems
  }
];

// Add ImageObject if image is present
if (image) {
  graph.push({
    "@type": "ImageObject",
    "@id": imageId,
    "url": image.startsWith('http') ? image : (image.startsWith('/') ? `${siteUrl}${image}` : `${siteUrl}/${image}`),
    "caption": title
  });
}

// Add Article/Glossary/About specific data to graph
if (type === 'article') {
  graph.push({
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": imageId ? { "@id": imageId } : undefined,
    "datePublished": datePublishedISO,
    "dateModified": dateModifiedISO,
    "author": { "@id": personId },
    "publisher": { "@id": businessId },
    "mainEntityOfPage": { "@id": url }
  } as any);
} else if (type === 'glossary') {
  const termId = `${url}#term`;
  const glossaryArticleId = `${url}#article`;
  const termSetId = `${siteUrl}/glossar/#termset`;
  
  // The DefinedTermSet represents the entire Glossary, linking all terms directly to Jörg as the author
  graph.push({
    "@type": "DefinedTermSet",
    "@id": termSetId,
    "name": "Jörg Zimmer SEO / GEO / AI Visibility Glossar",
    "description": "Experten-Glossar für Suchmaschinenoptimierung und Performance Marketing",
    "url": `${siteUrl}/glossar/`,
    "author": { "@id": personId },
    "publisher": { "@id": businessId }
  });

  // The Article serves as the container for the knowledge, attributing it to the Person
  graph.push({
    "@type": "Article",
    "@id": glossaryArticleId,
    "headline": `Glossar: ${title}`,
    "description": description,
    "author": { "@id": personId },
    "publisher": { "@id": businessId },
    "datePublished": datePublishedISO,
    "dateModified": dateModifiedISO,
    "mainEntity": { "@id": termId },
    "image": imageId ? { "@id": imageId } : undefined
  });

  // The DefinedTerm is the core knowledge piece, nested in the TermSet
  graph.push({
    "@type": "DefinedTerm",
    "@id": termId,
    "name": title,
    "description": description,
    "inDefinedTermSet": { "@id": termSetId },
    "url": url,
    "sameAs": sameAs || undefined,
    "alternateName": alternateNames && alternateNames.length > 0 ? alternateNames : undefined,
    "image": imageId ? { "@id": imageId } : undefined,
    "mainEntityOfPage": { "@id": url }
  } as any);

  // Link WebPage to the Article instead of the term directly
  const webPage = graph.find(e => e["@type"] === "WebPage");
  if (webPage) {
    webPage.mainEntity = { "@id": glossaryArticleId };
  }
} else if (type === 'about') {
  graph.push({
    "@type": "AboutPage",
    "name": title,
    "description": description,
    "url": url,
    "mainEntity": mainEntity || { "@id": personId }
  } as any);
} else if (type === 'software') {
  graph.push({
    "@type": "SoftwareApplication",
    "name": title,
    "description": description,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "url": url,
    ...(mainEntity || {}),
    "offers": mainEntity?.offers || {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    }
  } as any);
}

// Add FAQ if provided
if (faqs && faqs.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": cleanText(faq.question),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": cleanText(faq.answer)
      }
    }))
  } as any);
}

// Wrap in context
const schema = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

