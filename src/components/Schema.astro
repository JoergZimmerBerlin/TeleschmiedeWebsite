  "@id": blogId,
  "name": "Jörg Zimmer SEO & AI Search Blog",
  "description": "Tiefgründige Case Studies, bewährte SEO-Strategien, technische Analysen und Insights aus 25 Jahren Performance Marketing",
  "url": `${siteUrl}/blog/`,
  "author": { "@id": personId },
  "publisher": { "@id": personId },
  "isPartOf": { "@id": websiteId }
};

// Determine page-level schema type (Google Search & Schema.org best practice)
let pageTypes: string[] = ["WebPage"];
if (type === 'profile') pageTypes = ["WebPage", "ProfilePage"];
else if (type === 'about') pageTypes = ["WebPage", "AboutPage"];
else if (type === 'contact') pageTypes = ["WebPage", "ContactPage"];
else if (type === 'collection' || type === 'videos') pageTypes = ["WebPage", "CollectionPage"];

const webPageNode: any = {
  "@type": pageTypes.length === 1 ? pageTypes[0] : pageTypes,
  "@id": url,
  "url": url,
  "name": title,
  "description": description,
  "author": { "@id": personId },
  "reviewedBy": { "@id": personId },
  "publisher": { "@id": personId },
  "breadcrumb": { "@id": breadcrumbId },
  "datePublished": datePublishedISO,
  "dateModified": dateModifiedISO,
  "lastReviewed": lastReviewedISO,
  "isPartOf": { "@id": websiteId },
  "primaryImageOfPage": imageId ? { "@id": imageId } : undefined,
  "about": type === 'default' ? { "@id": businessId } : undefined,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "main p:first-of-type"]
  },
  "isAccessibleForFree": true
};

if (type === 'profile') {
  webPageNode.mainEntity = { "@id": personId };
  webPageNode.about = { "@id": personId };
} else if (type === 'about') {
  webPageNode.mainEntity = mainEntity || { "@id": personId };
  webPageNode.about = { "@id": personId };
} else if (type === 'contact') {
  webPageNode.mainEntity = { "@id": businessId };
  webPageNode.about = { "@id": businessId };
}

const graph: any[] = [
  personEntity,
  businessEntity,
  definedTermSetNode,
  blogNode,
  {
    "@type": "WebSite",
    "@id": websiteId,
    "url": siteUrl,
    "name": "Jörg Zimmer - SEO / GEO / AI Visibility Freelancer",
    "alternateName": "Teleschmiede",
    "publisher": { "@id": personId },
    "author": { "@id": personId },
    "hasPart": [
      {
        "@type": "DefinedTermSet",
        "@id": termSetId,
        "name": "Jörg Zimmer SEO / GEO / AI Visibility Glossar",
        "url": `${siteUrl}/glossar/`
