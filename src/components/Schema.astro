---
import fs from "node:fs";
import path from "node:path";

const getTranscriptSchema = (id: string, fallbackDesc: string): string => {
  try {
    const filePath = path.join(process.cwd(), "src", "data", "transcripts", id + ".txt");
    if (fs.existsSync(filePath)) {
      const text = fs.readFileSync(filePath, "utf-8");
      if (text.length > 2048) return text.substring(0, 2045) + "...";
      return text;
    }
  } catch (e) {}
  return fallbackDesc;
};

/**
 * Schema.astro
 * Centralized JSON-LD Schema component to ensure consistency and high audit scores.
 */
interface Props {
  title?: string;
  description?: string;
  lastReviewed?: string;
  url?: string;
  type?: 'article' | 'glossary' | 'about' | 'profile' | 'service' | 'collection' | 'contact' | 'software' | 'videos' | 'default';
  image?: string;
  datePublished?: string;
  dateModified?: string;
  faqs?: any[];
  offers?: any[];
  mainEntity?: any;
  sameAs?: string;
  alternateNames?: string[];
  quote?: string;
  category?: string;
  tags?: string[];
  keyTakeaways?: string[];
  collectionItems?: { name: string; url: string; description?: string }[];
  isTechArticle?: boolean;
  item?: any;
}

const { 
  title, 
  description, 
  lastReviewed,
  url = Astro.url.href,
  type = 'default',
  image,
  datePublished,
  dateModified,
  offers,
  faqs,
  mainEntity,
  sameAs,
  alternateNames,
  quote,
  category,
  tags,
  keyTakeaways,
  collectionItems,
  isTechArticle,
  item
} = Astro.props;

const siteUrl = 'https://teleschmie.de';
const personId = `${siteUrl}/#person`;
const businessId = `${siteUrl}/#localbusiness`;
const websiteId = `${siteUrl}/#website`;
const termSetId = `${siteUrl}/glossar/#termset`;
const blogId = `${siteUrl}/blog/#blog`;
const breadcrumbId = `${url}#breadcrumb`;
const imageId = image ? `${url}#primaryimage` : undefined;

// Helper to strip HTML for clean JSON-LD strings
const cleanText = (html: string) => html ? html.replace(/<[^>]*>?/gm, '').trim() : '';

// Helper to ensure dates are in valid ISO 8601 format for Google/LLMs
const formatISO = (dateStr?: string) => {
  if (!dateStr) return undefined;
  try {
    const d = new Date(dateStr);
    return isNaN(d.getTime()) ? dateStr : d.toISOString().split('T')[0];
  } catch (e) {
    return dateStr;
  }
};

const datePublishedISO = formatISO(datePublished);
const dateModifiedISO = formatISO(dateModified || lastReviewed || datePublished);
const lastReviewedISO = formatISO(lastReviewed);

// --- Breadcrumb Logic ---
const pathSegments = new URL(url).pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", "position": 1, "name": "Basis", "item": siteUrl }
];

let currentPath = siteUrl;
pathSegments.forEach((segment, index) => {
  currentPath += `/${segment}/`;
  let name = segment.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
  
  // Custom mapping for prettier labels
  if (segment === 'glossar') name = 'Glossar';
  if (segment === 'blog') name = 'Blog & News';
  if (segment === 'tools') name = 'KI Tools';
  
  // Use the title for the last item if it's a specific page
  if (index === pathSegments.length - 1 && title) {
    name = title;
  }

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": index + 2,
    "name": name,
    "item": currentPath
  });
});

