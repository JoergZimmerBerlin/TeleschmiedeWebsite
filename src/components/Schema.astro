}

// Service Page First-Class Entity
const isServicePage = type === 'service' || (offers && offers.length > 0 && (url.includes('/seo-') || url.includes('/google-ads-') || url.includes('/leistungen/')));
if (isServicePage) {
  const serviceId = `${url}#service`;
  const serviceEntity: any = {
    "@type": "Service",
    "@id": serviceId,
    "name": title,
    "description": description,
    "url": url,
    "provider": { "@id": personId },
    "brand": { "@id": websiteId },
    "serviceType": (title && title.includes('Google Ads')) ? "Search Engine Advertising & Google Ads Consulting" : "Search Engine Optimization & AI Visibility Consulting",
    "areaServed": dachAreaServed,
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceUrl": `${siteUrl}/kontakt/`,
      "servicePhone": "+493049208184",
