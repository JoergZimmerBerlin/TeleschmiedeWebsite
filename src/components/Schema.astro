    "datePublished": datePublishedISO,
    "dateModified": dateModifiedISO,
    "author": { "@id": personId },
    "publisher": { "@id": personId },
    "mainEntityOfPage": { "@id": url },
    "isPartOf": { "@id": blogId },
    "isAccessibleForFree": true
  };
  if (isTechnical) {
    blogPostingNode.proficiencyLevel = "Expert";
  }
  if (category) blogPostingNode.articleSection = category;
  if (tags && tags.length > 0) {
    blogPostingNode.keywords = tags.join(", ");
    blogPostingNode.about = tags.map(tag => ({
      "@type": "DefinedTerm",
      "name": tag,
      "inDefinedTermSet": { "@id": termSetId }
    }));
  }
  if (keyTakeaways && keyTakeaways.length > 0) blogPostingNode.abstract = keyTakeaways.map(t => cleanText(t)).join(" ");
  graph.push(blogPostingNode);
  webPageNode.mainEntity = { "@id": articleId };
} else if (type === 'glossary') {
  const termId = `${url}#term`;
  const glossaryArticleId = `${url}#article`;

  // The Article serves as the container for the knowledge, attributing it to the Person
  graph.push({
    "@type": ["Article", "TechArticle"],
    "@id": glossaryArticleId,
    "headline": title,
    "description": description,
    "author": { "@id": personId },
    "publisher": { "@id": personId },
    "datePublished": datePublishedISO,
    "dateModified": dateModifiedISO,
    "mainEntity": { "@id": termId },
    "isPartOf": { "@id": termSetId },
    "image": absoluteImageUrl ? {
      "@type": "ImageObject",
      "@id": imageId,
      "url": absoluteImageUrl,
      "width": 1200,
      "height": 630
    } : undefined,
    "isAccessibleForFree": true,
    "proficiencyLevel": "Expert"
  });

  // The DefinedTerm is the core knowledge piece, nested in the TermSet
  graph.push({
    "@type": "DefinedTerm",
    "@id": termId,
    "name": title,
    "description": description,
    "inDefinedTermSet": { "@id": termSetId },
    "url": url,
    "sameAs": sameAs || undefined,
    "alternateName": alternateNames && alternateNames.length > 0 ? alternateNames : undefined,
    "image": absoluteImageUrl || undefined,
    "mainEntityOfPage": { "@id": url }
  } as any);

  webPageNode.mainEntity = { "@id": glossaryArticleId };
} else if (type === 'software') {
  graph.push({
    "@type": "SoftwareApplication",
    "name": title,
    "description": description,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Any",
    "url": url,
    ...(mainEntity || {}),
    "offers": mainEntity?.offers || {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR"
    }
  } as any);
} else if (type === 'videos') {
  if (mainEntity) {
    webPageNode.mainEntity = mainEntity;
  }
}

// Push custom item if passed directly
if (item) {
  graph.push(item);
  if (item["@id"]) {
    webPageNode.mainEntity = { "@id": item["@id"] };
  }
}

// Add FAQ if provided
if (faqs && faqs.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": cleanText(faq.question),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": cleanText(faq.answer)
      }
    }))
  } as any);
}

// Add Quotation to graph if quote is provided
if (quote) {
  const quotationId = `${url}#quotation`;
  graph.push({
    "@type": "Quotation",
    "@id": quotationId,
    "name": `Experten-Zitat von Jörg Zimmer: ${title}`,
    "text": cleanText(quote),
    "creator": { "@id": personId },
    "spokenByCharacter": { "@id": personId },
    "isPartOf": { "@id": url }
  } as any);

  // Link to Article or BlogPosting if present
  const contentNode = graph.find(e => e["@type"] === "Article" || e["@type"] === "BlogPosting");
  if (contentNode) {
    if (!contentNode.hasPart) contentNode.hasPart = [];
    contentNode.hasPart.push({ "@id": quotationId });
  }
}

// Wrap in context
const schema = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

