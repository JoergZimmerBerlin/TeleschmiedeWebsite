  if (businessEntity.hasOfferCatalog) {
    serviceEntity.hasOfferCatalog = businessEntity.hasOfferCatalog;
  }
  graph.push(serviceEntity);
  webPageNode.mainEntity = { "@id": serviceId };
  webPageNode.about = { "@id": serviceId };
}

// CollectionPage ItemList (for Category Hubs & Archives)
if (type === 'collection' && collectionItems && collectionItems.length > 0) {
  const itemListId = `${url}#itemlist`;
  const itemListNode = {
    "@type": "ItemList",
    "@id": itemListId,
    "name": title,
    "description": description,
    "numberOfItems": collectionItems.length,
    "itemListElement": collectionItems.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "url": item.url
    }))
  };
  graph.push(itemListNode);
  webPageNode.mainEntity = { "@id": itemListId };
}

// Add Article/Glossary/About specific data to graph
if (type === 'article') {
  const isTechnical = isTechArticle || category === 'Tech SEO & Tools' || category === 'AI SEO' || tags?.some(t => ['Schema.org', 'API', 'Crawling', 'Core Web Vitals', 'PageSpeed', 'Python', 'Technisches SEO'].includes(t));
  const articleTypes = isTechnical ? ["BlogPosting", "TechArticle"] : "BlogPosting";
  const articleId = `${url}#article`;

  const blogPostingNode: any = {
    "@type": articleTypes,
    "@id": articleId,
    "headline": title,
    "description": description,
    "image": absoluteImageUrl ? {
      "@type": "ImageObject",
      "@id": imageId,
      "url": absoluteImageUrl,
      "width": 1200,
      "height": 630
