---
interface Props {
  tool?: 'visualizer' | 'generator' | 'grounding';
  title?: string;
  description?: string;
}

const { 
  tool = 'visualizer', 
  title, 
  description 
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const configs = {
  visualizer: {
    badge: 'Kostenloser Live-Scanner',
    icon: '🌐',
    defaultTitle: 'Deinen Schema.org Graph live im Visualizer prüfen',
    defaultDesc: 'Erkenne isolierte Dateninseln, prüfe den 3-Ebenen Entity Health Score und vergleiche deinen Ist- mit dem Soll-Zustand für moderne Answer Engines.',
    buttonText: 'Domain im Visualizer prüfen',
    url: `${baseUrl}/tools/schema-graph-visualizer/`
  },
  generator: {
    badge: 'JSON-LD Generator',
    icon: '⚡',
    defaultTitle: 'Vernetzten Entitäten-Graph Code generieren',
    defaultDesc: 'Erstelle monolithischen Schema.org JSON-LD Code nach modernsten Ontologie-Standards – ohne isolierte Dateninseln, mit Wikidata sameAs Verankerung.',
    buttonText: 'Entitäten Graph Generator öffnen',
    url: `${baseUrl}/tools/entitaeten-graph-generator/`
  },
  grounding: {
    badge: 'AI Grounding Tool',
    icon: '🤖',
    defaultTitle: 'Grounding Page für KI-Agenten & LLMs erstellen',
    defaultDesc: 'Generiere strukturierte Source-of-Truth Prompts für ChatGPT, Claude und Cursor zur fehlerfreien KI-Verankerung.',
    buttonText: 'Grounding Page Generator starten',
    url: `${baseUrl}/tools/groundingpage-generator/`
  }
};

const current = configs[tool] || configs.visualizer;
const displayTitle = title || current.defaultTitle;
const displayDesc = description || current.defaultDesc;
---

<div class="my-10 bg-dark text-white p-6 md:p-8 rounded-3xl border border-white/10 shadow-md relative not-prose">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-lime-400/10 border border-lime-400/30 text-lime-accent text-xs font-bold">
      <span>{current.icon}</span>
      <span>{current.badge}</span>
    </div>
    <span class="text-xs text-gray-400 font-mono hidden sm:inline">100% kostenlos & ohne Registrierung</span>
  </div>

  <h3 class="text-xl md:text-2xl font-bold text-white mb-2 !mt-0 !border-none !pb-0 leading-snug">
    {displayTitle}
  </h3>
  
  <p class="text-gray-300 text-sm md:text-base leading-relaxed max-w-2xl mb-6">
    {displayDesc}
  </p>

  <div class="flex flex-wrap items-center gap-4">
    <a href={current.url} class="btn-primary">
      <span>{current.buttonText}</span>
      <span aria-hidden="true">→</span>
    </a>
    <a href={`${baseUrl}/tools/`} class="text-xs font-semibold text-gray-400 hover:text-white transition-colors">
      Alle Tools ansehen →
    </a>
  </div>
</div>
