---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Jörg Zimmer ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer der individuelle Strategien und persönliche Beratung anbietet.', ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = import.meta.env.SITE || 'https://teleschmie.de';
const ogImageUrl = ogImage ? `${siteUrl}${baseUrl}${ogImage}` : `${siteUrl}${baseUrl}/images/pages/hero-pose.jpg`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Security -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO -->
    <meta name="author" content="Jörg Zimmer" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Jörg Zimmer - SEO Freelancer" />
    <meta property="og:url" content={`${siteUrl}${currentPath}`} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${baseUrl}/images/logo-teleschmiede.png`} />

    <!-- Preload critical font -->
    <link rel="preload" href={`${baseUrl}/fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />

    <!-- Self-hosted Inter Font -->
    <style set:html={`
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${baseUrl}/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${baseUrl}/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    `} />

    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="dns-prefetch" href="https://www.youtube.com" />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#D4FF00" />

    <!-- Canonical -->
    <link rel="canonical" href={`${siteUrl}${currentPath}`} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <!-- Global Reading Progress Bar -->
    <div id="progress-container" class="fixed top-0 left-0 w-full h-2 z-[9999] pointer-events-none">
      <div id="progress-bar" class="h-full bg-lime-accent w-0 transition-all duration-150 shadow-[0_0_12px_rgba(217,255,0,0.8)]"></div>
    </div>
    <Navigation currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Global Progress Bar Script -->
    <script>
      const updateProgress = () => {
        const progressBar = document.getElementById('progress-bar');
        if (!progressBar) return;

        const content = document.getElementById('blog-content');
        const scrollPos = window.scrollY;
        const windowHeight = window.innerHeight;
        let progress = 0;

        if (content) {
          // Refined reading logic for blog posts
          const totalHeight = content.offsetHeight;
          const contentTop = content.offsetTop;
          progress = ((scrollPos - contentTop + windowHeight / 2) / totalHeight) * 100;
        } else {
          // Fallback logic for normal pages
          const totalHeight = document.documentElement.scrollHeight - windowHeight;
          progress = totalHeight > 0 ? (scrollPos / totalHeight) * 100 : 0;
        }

        progress = Math.max(0, Math.min(100, progress));
        progressBar.style.width = `${progress}%`;
      };

      window.addEventListener('scroll', updateProgress);
      window.addEventListener('resize', updateProgress);
      // Initialize
      updateProgress();
    </script>
  </body>
</html>
