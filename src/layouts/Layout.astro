---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lcpImage?: string;
  lang?: string;
}

const { title, description = 'Jörg Zimmer ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer der individuelle Strategien und persönliche Beratung anbietet.', ogImage, lcpImage, lang = 'de' } = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = import.meta.env.SITE || 'https://teleschmie.de';

// Absolute URL logic for OG Image
let ogImageUrl = '';
if (ogImage) {
  if (ogImage.startsWith('http')) {
    ogImageUrl = ogImage;
  } else {
    // Ensure it starts with / if it's a relative path
    const cleanOgImage = ogImage.startsWith('/') ? ogImage : `/${ogImage}`;
    ogImageUrl = `${siteUrl}${cleanOgImage}`;
  }
} else {
  // Default Fallback
  ogImageUrl = `${siteUrl}/assets/hero-pose.webp`; // This assumes the build moves it here, or we use a static one
}
// SEO Truncation Helper
const truncate = (text: string, limit: number) => {
  if (!text) return '';
  if (text.length <= limit) return text;
  // Try to cut at last space within limit
  const sub = text.substring(0, limit);
  const lastSpace = sub.lastIndexOf(' ');
  return lastSpace > 0 ? sub.substring(0, lastSpace) : sub;
};

const displayTitle = truncate(title, 50);
const displayDescription = truncate(description, 150);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={displayDescription} />

    <!-- Security -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO -->
    <meta name="author" content="Jörg Zimmer" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={displayDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${currentPath}`} />
    <meta property="og:image" content={ogImageUrl} />

    {/* Preload Hero Image for LCP */}
    {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}

    {/* CSS is already injected by Astro, but preloading fonts/assets can help */}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={displayDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg?v=2`} sizes="any" />
    <link rel="icon" type="image/webp" href={`${baseUrl}/favicon.webp?v=2`} />
    <link rel="apple-touch-icon" href={`${baseUrl}/images/logo-teleschmiede.webp?v=2`} />

    <!-- Preload critical font -->
    <link rel="preload" href={`${baseUrl}/fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />

    <!-- Self-hosted Inter Font -->
    <style set:html={`
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${baseUrl}/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${baseUrl}/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    `} />

    <!-- DNS Prefetch -->
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="dns-prefetch" href="https://www.youtube.com" />

    <!-- Theme color for mobile browsers -->
    <meta name="theme-color" content="#D4FF00" />

    <!-- Canonical -->
    <link rel="canonical" href={`${siteUrl}${currentPath}`} />

    <!-- AI Discovery (llms.txt) -->
    <link rel="llms" href={`${siteUrl}/llms.txt`} />
    <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms-full.txt`} />

    <title>{displayTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <!-- Global Reading Progress Bar -->
    <div id="progress-container" class="fixed top-0 left-0 w-full h-2 z-[9999] pointer-events-none">
      <div id="progress-bar" class="h-full bg-lime-accent w-0 transition-all duration-150 shadow-[0_0_12px_rgba(217,255,0,0.8)]"></div>
    </div>
    <Navigation currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

<script>
      let ticking = false;
      const updateProgress = () => {
        const progressBar = document.getElementById('progress-bar');
        if (!progressBar) return;

        const content = document.getElementById('blog-content');
        const scrollPos = window.scrollY;
        const windowHeight = window.innerHeight;
        let progress = 0;

        if (content) {
          const totalHeight = content.offsetHeight;
          const contentTop = content.offsetTop;
          progress = ((scrollPos - contentTop + windowHeight / 2) / totalHeight) * 100;
        } else {
          const totalHeight = document.documentElement.scrollHeight - windowHeight;
          progress = totalHeight > 0 ? (scrollPos / totalHeight) * 100 : 0;
        }

        progress = Math.max(0, Math.min(100, progress));
        progressBar.style.width = `${progress}%`;
        ticking = false;
      };

      const requestTick = () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      };

      (() => {
        // Table labeling for responsive cards
        document.querySelectorAll('.blog-content table').forEach(table => {
          const headers = Array.from(table.querySelectorAll('th')).map(th => th.textContent.trim());
          if (headers.length > 0) {
            table.querySelectorAll('tr').forEach(tr => {
              tr.querySelectorAll('td').forEach((td, i) => {
                if (headers[i]) td.setAttribute('data-label', headers[i]);
              });
            });
          }
        });

        window.addEventListener('scroll', requestTick);
        window.addEventListener('resize', requestTick);
        updateProgress();

        // --- High-End Glossary Tooltips (Lightweight Display-Only) ---
        const initGlossaryTooltips = () => {
          // Create Tooltip Element if doesn't exist
          let tooltip = document.getElementById('glossary-tooltip');
          if (!tooltip) {
            tooltip = document.createElement('div');
            tooltip.id = 'glossary-tooltip';
            tooltip.innerHTML = '<span class="tooltip-title"></span><p class="tooltip-body"></p>';
            document.body.appendChild(tooltip);
          }

          const titleEl = tooltip.querySelector('.tooltip-title');
          const bodyEl = tooltip.querySelector('.tooltip-body');

          const updatePos = (e: any, targetTooltip: HTMLElement) => {
            const x = e.clientX || (e.touches && e.touches[0].clientX);
            const y = e.clientY || (e.touches && e.touches[0].clientY);
            const offset = 25;
            
            let left = x + offset;
            let top = y + offset;
            
            if (left + targetTooltip.offsetWidth > window.innerWidth) {
              left = x - targetTooltip.offsetWidth - offset;
            }
            if (top + targetTooltip.offsetHeight > window.innerHeight) {
              top = y - targetTooltip.offsetHeight - offset;
            }
            
            targetTooltip.style.left = `${Math.max(10, left)}px`;
            targetTooltip.style.top = `${Math.max(10, top)}px`;
          };

          // Tooltip Event Listeners for pre-linked terms
          document.querySelectorAll('.glossary-link').forEach(link => {
            const showTooltip = (e: any) => {
              const title = link.getAttribute('data-tooltip-title');
              const body = link.getAttribute('data-tooltip-body');
              if (tooltip.classList.contains('visible') && titleEl && titleEl.textContent === title) {
                return;
              }
              if (titleEl) titleEl.textContent = title;
              if (bodyEl) bodyEl.textContent = body;
              tooltip.classList.add('visible');
              updatePos(e, tooltip);
            };

            const hideTooltip = () => {
              tooltip.classList.remove('visible');
            };

            link.addEventListener('mouseenter', showTooltip);
            link.addEventListener('mousemove', (e: any) => updatePos(e, tooltip));
            link.addEventListener('mouseleave', hideTooltip);
            
            // Mobile Support
            link.addEventListener('touchstart', (e: any) => {
              const title = link.getAttribute('data-tooltip-title');
              const body = link.getAttribute('data-tooltip-body');
              
              const isVisible = tooltip.classList.contains('visible');
              const isSame = titleEl && titleEl.textContent === title;

              if (isVisible && isSame) {
                hideTooltip();
              } else {
                showTooltip(e);
              }
            });
          });

          // Close on outside click
          document.addEventListener('click', (e: any) => {
            const target = e.target as HTMLElement;
            if (target && !target.closest('.glossary-link') && !target.closest('#glossary-tooltip')) {
              tooltip.classList.remove('visible');
            }
          });
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initGlossaryTooltips);
        } else {
          initGlossaryTooltips();
        }
      })();
    </script>
  </body>
</html>
