---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImage from '../assets/images/pages/hero-pose.webp';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lcpImage?: string;
  lang?: string;
  maxTitleLength?: number;
}

const { title, description = 'Jörg Zimmer ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer der individuelle Strategien und persönliche Beratung anbietet.', ogImage, lcpImage, lang = 'de', maxTitleLength = 50 } = Astro.props;
const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = import.meta.env.SITE || 'https://teleschmie.de';

// Optimized fallback image
const optimizedHero = await getImage({ src: heroImage, format: 'webp', width: 1200, height: 630 });
const fallbackUrl = `${siteUrl}${optimizedHero.src}`;

// Absolute URL logic for OG Image
let ogImageUrl = '';
if (ogImage) {
  if (ogImage.startsWith('http')) {
    ogImageUrl = ogImage;
  } else {
    // Ensure it starts with / if it's a relative path
    const cleanOgImage = ogImage.startsWith('/') ? ogImage : `/${ogImage}`;
    ogImageUrl = `${siteUrl}${cleanOgImage}`;
  }
} else {
  ogImageUrl = fallbackUrl;
}
// SEO Truncation Helper
const truncate = (text: string, limit: number) => {
  if (!text) return '';
  if (text.length <= limit) return text;
  // Try to cut at last space within limit
  const sub = text.substring(0, limit);
  const lastSpace = sub.lastIndexOf(' ');
  return lastSpace > 0 ? sub.substring(0, lastSpace) : sub;
};

const displayTitle = truncate(title, maxTitleLength);
const displayDescription = truncate(description, 150);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={displayDescription} />

    <!-- DNS Prefetch (Early Discovery) -->
    <!-- Preload critical font (High Priority) -->

    <!-- Preload critical font (High Priority) -->
    <link rel="preload" href={`${baseUrl}/fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
    
    <!-- Canonical -->
    <link rel="canonical" href={`${siteUrl}${currentPath}`} />

    <!-- Security -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO -->
    <meta name="author" content="Jörg Zimmer" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={displayDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${currentPath}`} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={displayDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${baseUrl}/favicon.png`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${baseUrl}/apple-touch-icon.png`} />

    <!-- Styles -->
    <link rel="stylesheet" href={`${baseUrl}/styles/font-faces.css`} />

    <!-- AI Discovery (llms.txt) -->
    <link rel="llms" href={`${siteUrl}/llms.txt`} />
    <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms-full.txt`} />

    <!-- Theme color -->
    <meta name="theme-color" content="#D4FF00" />

    <title>{displayTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <!-- Global Reading Progress Bar -->
    <div id="progress-container" class="fixed top-0 left-0 w-full h-2 z-[9999] pointer-events-none">
      <div id="progress-bar" class="h-full bg-lime-accent w-0 transition-all duration-150 shadow-[0_0_12px_rgba(217,255,0,0.8)]"></div>
    </div>
    <Navigation currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <script src={`${baseUrl}/js/site-scripts.js`} defer></script>
  </body>
</html>
