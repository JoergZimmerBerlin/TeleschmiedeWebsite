---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Stats from '../components/Stats.astro';
import Expertise from '../components/Expertise.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/pages/hero-pose.jpg';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="404 - Seite nicht gefunden | Jörg Zimmer" description="Diese Seite konnte leider nicht gefunden werden.">
  <!-- Hero Section -->
  <section class="section">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">SEO & SEA Freelancer Berlin Spandau</p>
          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            404 
            <span class="highlight">Diese Seite</span>
            ist leider nicht erreichbar
          </h1>
          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            Ups! Die Seite, die du gesucht hast, gibt es nicht (mehr)
            oder der verwendete Link war fehlerhaft.<br>
            Aber keine Sorge – vielleicht helfen dir diese Wege weiter
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary">
              Jetzt Kontakt aufnehmen
            </a>
            <a href={`${baseUrl}/leistungen/`} class="btn-secondary">
              Leistungen ansehen
            </a>
          </div>
        </div>
        <div class="md:w-1/3">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer aus Berlin Spandau"
            width={552}
            height={896}
            class="w-full h-auto rounded-2xl shadow-lg"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <Stats />
  <Expertise />
  <CTASection />
</Layout>
