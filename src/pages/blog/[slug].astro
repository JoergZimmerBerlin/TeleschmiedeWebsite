---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Reading Time Calculation
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200); // Avg 200 wpm

const shareUrl = `https://teleschmie.de/blog/${post.slug}/`;
const shareTitle = encodeURIComponent(post.data.title);

// Get related posts with scoring
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug) // Exclude current
  .map(p => {
    let score = 0;
    
    // Category match (highest weight)
    if (p.data.category && post.data.category && p.data.category === post.data.category) {
      score += 5;
    }
    
    // Tag matches
    const commonTags = p.data.tags?.filter(tag => post.data.tags?.includes(tag)) || [];
    score += commonTags.length * 2;
    
    return { ...p, score };
  })
  .filter(p => p.score > 0) // Only show the ones that have some relation
  .sort((a, b) => {
    // 1. Higher score first
    if (b.score !== a.score) return b.score - a.score;
    // 2. Newer date first for same score
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3); // Top 3

// Fallback to most recent posts if no thematic matches found
const finalRelatedPosts = relatedPosts.length >= 3 
  ? relatedPosts 
  : [
      ...relatedPosts,
      ...allPosts
        .filter(p => p.slug !== post.slug && !relatedPosts.find(r => r.slug === p.slug))
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
        .slice(0, 3 - relatedPosts.length)
    ];
---

<Layout
  title={`${post.data.title} | Jörg Zimmer Blog`}
  description={post.data.description}
  ogImage={post.data.image?.src}
>
  <!-- Reading Progress Bar -->
  <div id="progress-container" class="fixed top-0 left-0 w-full h-1.5 z-50 pointer-events-none">
    <div id="progress-bar" class="h-full bg-lime-accent w-0 transition-all duration-150 shadow-[0_0_10px_rgba(217,255,0,0.5)]"></div>
  </div>

  <article class="section pt-8">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <!-- Back Link -->
        <a href={`${baseUrl}/blog/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Blog
        </a>

        <!-- Reading Time -->
        <div class="flex items-center gap-4 text-sm text-gray-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} Min. Lesezeit
          </span>
        </div>
      </div>

      <!-- Featured Image -->
      {post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.image_alt || post.data.title}
          class="w-full rounded-2xl mb-8 shadow-sm h-auto"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      )}

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Sidebar (Sticky on Desktop) -->
        <aside class="lg:col-span-4 order-2 lg:order-1 lg:sticky lg:top-24 space-y-8">
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <nav class="p-6 bg-gray-50 border border-gray-100 rounded-3xl">
              <h2 class="text-lg font-bold mb-4 flex items-center gap-2 !mt-0 !mb-4 border-none !pb-0">
                <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Inhalt
              </h2>
              <ul class="space-y-3">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                    <a 
                      href={`#${heading.slug}`} 
                      class="text-sm text-gray-muted hover:text-lime-600 transition-colors flex items-start gap-2 group"
                    >
                      <span class="w-1 h-1 bg-gray-300 rounded-full mt-2 group-hover:bg-lime-500 transition-colors"></span>
                      <span class="flex-1">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <!-- Social Sharing -->
          <div class="p-6 bg-white border border-gray-100 rounded-3xl shadow-sm">
            <h3 class="text-sm font-bold text-dark uppercase tracking-wider mb-4 !mt-0">Artikel teilen</h3>
            <div class="flex flex-wrap gap-2">
              <!-- LinkedIn -->
              <a 
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center bg-[#0077b5] text-white rounded-xl hover:brightness-110 transition-all shadow-sm"
                title="Auf LinkedIn teilen"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <!-- WhatsApp -->
              <a 
                href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center bg-[#25D366] text-white rounded-xl hover:brightness-110 transition-all shadow-sm"
                title="Per WhatsApp teilen"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </a>
              <!-- Email -->
              <a 
                href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}
                class="w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-all shadow-sm"
                title="Per E-Mail teilen"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
              <!-- Copy Link -->
              <button 
                id="copy-link"
                class="w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-all shadow-sm relative"
                title="Link kopieren"
                data-url={shareUrl}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span id="copy-feedback" class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-[10px] px-2 py-1 rounded opacity-0 transition-opacity pointer-events-none">Kopiert!</span>
              </button>
            </div>
          </div>
        </aside>

        <!-- Main Content -->
        <div class="lg:col-span-8 order-1 lg:order-2">
          <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg" id="blog-content">
            {post.data.key_takeaways && <KeyTakeaways takeaways={post.data.key_takeaways} />}
            <Content />
            {post.data.show_roi_calculator && <ROICalculator />}
            {post.data.download_card && <DownloadCard {...post.data.download_card} />}
            {post.data.faqs && <FAQAccordion faqs={post.data.faqs} />}
          </div>
        </div>
      </div>

      <!-- Back to Top Button -->
      <button 
        id="back-to-top" 
        class="fixed bottom-8 right-8 w-12 h-12 bg-white border border-gray-100 text-dark rounded-full shadow-lg flex items-center justify-center opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:bg-lime-accent hover:border-lime-accent group z-40"
        aria-label="Nach oben scrollen"
      >
        <svg class="w-6 h-6 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>

      <script>
        // Reading Progress Bar & Back to Top Visibility
        const updateScrollingUI = () => {
          const content = document.getElementById('blog-content');
          const progressBar = document.getElementById('progress-bar');
          const backToTop = document.getElementById('back-to-top');
          
          if (!content || !progressBar || !backToTop) return;

          const totalHeight = content.offsetHeight;
          const contentTop = content.offsetTop;
          const scrollPos = window.scrollY;
          const windowHeight = window.innerHeight;

          // Progress Bar
          let progress = ((scrollPos - contentTop + windowHeight / 2) / totalHeight) * 100;
          progress = Math.max(0, Math.min(100, progress));
          progressBar.style.width = `${progress}%`;

          // Back to Top Visibility
          if (scrollPos > 500) {
            backToTop.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            backToTop.classList.add('opacity-100', 'translate-y-0');
          } else {
            backToTop.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            backToTop.classList.remove('opacity-100', 'translate-y-0');
          }
        };

        // Back to Top Click
        document.getElementById('back-to-top')?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Copy Link Logic
        const copyBtn = document.getElementById('copy-link');
        const feedback = document.getElementById('copy-feedback');
        
        if (copyBtn && feedback) {
          copyBtn.addEventListener('click', async () => {
            const url = copyBtn.dataset.url;
            try {
              if (url) {
                await navigator.clipboard.writeText(url);
                feedback.classList.remove('opacity-0');
                feedback.classList.add('opacity-100');
                setTimeout(() => {
                  feedback.classList.remove('opacity-100');
                  feedback.classList.add('opacity-0');
                }, 2000);
              }
            } catch (err) {
              console.error('Failed to copy: ', err);
            }
          });
        }

        window.addEventListener('scroll', updateScrollingUI);
        window.addEventListener('resize', updateScrollingUI);
        updateScrollingUI();
      </script>

      <!-- Custom Blog Styles -->
      <style is:global>
        .blog-content h2 {
          @apply text-2xl md:text-3xl font-bold mt-20 mb-8 border-b border-gray-100 pb-4 !important;
        }
        .blog-content h3 {
          @apply text-xl md:text-2xl font-bold mt-16 mb-6 !important;
        }
        .blog-content p {
          @apply mb-8 leading-relaxed !important;
        }
        .blog-content li {
          @apply mb-4 !important;
        }
        /* Pseudo-headings: Paragraphs starting with bold text */
        .blog-content p > strong:first-child:only-child,
        .blog-content p > strong:first-child {
          @apply block mt-12 mb-4 text-dark text-lg !important;
        }
        .blog-cta-box {
          @apply my-16 p-8 bg-gray-50 border border-gray-100 rounded-2xl text-center;
        }
        .blog-cta-box h3 {
          @apply mt-0 !important;
        }
      </style>

      <!-- Author Box Update -->
      <footer class="mt-20 pt-12 border-t border-gray-100">
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer - SEO & SEA Experte"
            width={96}
            height={96}
            class="w-24 h-24 rounded-full object-cover shadow-sm border-2 border-white"
          />
          <div class="flex-1 text-center md:text-left">
            <h4 class="text-xl font-bold text-dark mb-2">Über den Autor: Jörg Zimmer</h4>
            <p class="text-gray-muted mb-4 leading-relaxed">
              Jörg Zimmer ist SEO- und SEA-Freelancer aus Berlin Spandau mit über 20 Jahren Erfahrung. 
              Er hilft Unternehmen dabei, in einer KI-getriebenen Welt sichtbar zu bleiben und nachhaltig Suchtraffic aufzubauen.
            </p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
              <a
                href={`${baseUrl}/ueber-mich/`}
                class="text-lime-600 font-bold hover:underline underline-offset-4"
              >
                Mehr über Jörg erfahren →
              </a>
              <a
                href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </footer>

      <!-- Related Posts -->
      {finalRelatedPosts.length > 0 && (
        <div class="mt-20 pt-12 border-t border-gray-100">
          <h3 class="text-2xl font-bold mb-8">Das könnte dich auch interessieren</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {finalRelatedPosts.map(p => (
              <a href={`${baseUrl}/blog/${p.slug}/`} class="group block bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-md transition-all">
                <div class="aspect-video overflow-hidden">
                  {p.data.image && (
                    <Image 
                      src={p.data.image} 
                      alt={p.data.image_alt || p.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      format="webp"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-4">
                  <span class="text-[10px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                    {p.data.category || 'SEO'}
                  </span>
                  <h4 class="font-bold text-sm line-clamp-2 group-hover:text-lime-600 transition-colors">
                    {p.data.title}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["Article", post.data.faqs ? "FAQPage" : null].filter(Boolean),
    "headline": post.data.title,
    "description": post.data.description,
    "image": post.data.image ? `https://teleschmie.de${post.data.image.src}` : undefined,
    "datePublished": post.data.date,
    "author": {
      "@type": "Person",
      "@id": "https://teleschmie.de/ueber-mich/#person",
      "name": "Jörg Zimmer",
      "url": "https://teleschmie.de/ueber-mich/",
      "jobTitle": "SEO & SEA Freelancer",
      "sameAs": [
        "https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/",
        "https://www.xing.com/profile/Joerg_Zimmer6"
      ]
    },
    "publisher": {
      "@type": "Organization",
      "name": "Teleschmiede",
      "logo": {
        "@type": "ImageObject",
        "url": "https://teleschmie.de/assets/images/logo-teleschmiede.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://teleschmie.de/blog/${post.slug}/`
    },
    ...(post.data.faqs ? {
      "mainEntity": post.data.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    } : {})
  })} />
</Layout>

<style>
  .prose blockquote {
    font-style: normal;
  }
</style>
