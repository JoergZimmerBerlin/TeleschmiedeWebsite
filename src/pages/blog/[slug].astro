---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import logoImage from '../../assets/images/logo-teleschmiede.webp';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const logoWebp = await getImage({ src: logoImage, format: 'webp' });
let postImageWebp = null;
if (post.data.image) {
  postImageWebp = await getImage({ src: post.data.image, format: 'webp' });
}

// Reading Time Calculation
const wordCount = (post.body || '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 180); // Avg 180 wpm (German Standard)

// Get related posts with scoring
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id) // Exclude current
  .map(p => {
    let score = 0;
    
    // Category match (highest weight)
    if (p.data.category && post.data.category && p.data.category === post.data.category) {
      score += 5;
    }
    
    // Tag matches
    const commonTags = p.data.tags?.filter(tag => post.data.tags?.includes(tag)) || [];
    score += commonTags.length * 3;
    
    // Title/Description partial matches (contextual)
    const titleWords = post.data.title.toLowerCase().split(/\W+/).filter(w => w.length > 3);
    const otherText = (p.data.title + ' ' + (p.data.description || '')).toLowerCase();
    const wordMatches = titleWords.filter(w => otherText.includes(w));
    score += wordMatches.length * 1;
    
    return { ...p, score };
  })
  .filter(p => p.score > 1) // Higher threshold for relevance
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 4); // Top 4

// Fallback logic to ensure 4 links (mix of same category and latest)
const finalRelatedPosts = relatedPosts.length >= 4 
  ? relatedPosts 
  : [
      ...relatedPosts,
      ...allPosts
        .filter(p => p.id !== post.id && !relatedPosts.find(r => r.id === p.id))
        .map(p => {
          let fallbackScore = 0;
          if (p.data.category === post.data.category) fallbackScore += 10;
          return { ...p, fallbackScore };
        })
        .sort((a, b) => {
          if (b.fallbackScore !== a.fallbackScore) return b.fallbackScore - a.fallbackScore;
          return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
        })
        .slice(0, 4 - relatedPosts.length)
    ];

// Fetch related glossary terms for cross-linking
const allGlossaryTerms = await getCollection('glossar');
const relatedGlossaryTerms = allGlossaryTerms
  .filter(term => {
    const termTitle = term.data.title.split('(')[0].trim().toLowerCase();
    const postText = (post.data.title + ' ' + (post.data.description || '') + ' ' + (post.data.tags || []).join(' ')).toLowerCase().replace(/-/g, ' ');
    
    // Fuzzy match: check if the term title exists as a substring
    if (postText.includes(termTitle)) return true;
    
    // Keyword match: if at least 50% of keywords (min 4 chars) match
    const keywords = termTitle.split(/\s+/).filter(k => k.length > 3);
    if (keywords.length > 0) {
      const matchCount = keywords.filter(k => postText.includes(k)).length;
      if (matchCount >= Math.ceil(keywords.length / 2)) return true;
    }
    
    return post.data.tags?.some(tag => termTitle.includes(tag.toLowerCase()));
  })
  .slice(0, 4);

// Tacheles Quote Extractor for AI citation schema
const tachelesMatch = (post.body || '').match(/> \*\*Tacheles:\*\* (.*)/);
const tachelesQuote = tachelesMatch ? tachelesMatch[1].trim().replace(/\[(.*?)\]\(.*?\)/g, '$1') : null; // Remove markdown links for clean schema
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={postImageWebp?.src || post.data.image?.src}
  lcpImage={postImageWebp?.src}
>
  <article class="section pt-8 relative">

    <div class="container-narrow">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-gray-muted mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <a href={`${baseUrl}/blog/`} class="hover:text-dark transition-colors">Blog</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-dark font-medium line-clamp-1 truncate">{post.data.title}</span>
      </nav>

      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <!-- Back Link -->
        <a href={`${baseUrl}/blog/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Blog
        </a>

        <!-- Reading Time -->
        <div class="flex items-center gap-4 text-sm text-gray-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} Min. Lesezeit
          </span>
        </div>
      </div>

      <!-- Article Header (Moved UP) -->
      <header class="mb-12 max-w-4xl">
        <p class="subheadline mb-4">
          {new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-black leading-tight mb-8">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-3">
             <Image
                src={portraitImage}
                alt="Jörg Zimmer"
                width={40}
                height={40}
                class="w-10 h-10 rounded-full border-2 border-white shadow-sm"
              />
              <div class="text-sm">
                <span class="block font-bold text-dark">Jörg Zimmer</span>
                <span class="block text-gray-muted text-xs">SEO & SEA Experte</span>
              </div>
          </div>
          {post.data.linkedin_url && (
            <a
              href={post.data.linkedin_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-lime-700 bg-lime-accent/20 px-4 py-2 rounded-full hover:bg-lime-accent/30 transition-all"
            >
