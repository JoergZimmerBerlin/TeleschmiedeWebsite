---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../utils/slugify';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import logoImage from '../../assets/images/logo-teleschmiede.webp';
import { getGitModDate } from '../../utils/git-date';
import Schema from '../../components/Schema.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // 1. Post Paths
  const postPaths = posts.map((post) => ({
    params: { slug: post.id },
    props: { type: 'post', post },
  }));

  // 2. Category Paths
  const categories = new Set();
  posts.forEach(post => {
    categories.add(post.data.category || 'SEO Praxis');
  });

  const categoryPaths = Array.from(categories).map(category => {
    const slug = slugify(category as string);
    const categoryPosts = posts.filter(post => {
      const postCat = post.data.category || 'SEO Praxis';
      return postCat === category;
    }).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    return {
      params: { slug },
      props: { type: 'category', categoryName: category, categoryPosts }
    };
  });

  return [...postPaths, ...categoryPaths];
}

const { type, post, categoryName, categoryPosts } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// ==========================================
// CATEGORY LOGIC
// ==========================================
let categoryDescription = '';
if (type === 'category') {
  categoryDescription = `Alle Artikel zum Thema ${categoryName} von Jörg Zimmer.`;
  if (categoryName === 'AI SEO') {
    categoryDescription = 'Entdecke, wie Künstliche Intelligenz, ChatGPT und LLMs die Google-Suche revolutionieren. Lerne alles über GEO (Generative Engine Optimization) und KI-gestützte Content-Strategien.';
  } else if (categoryName === 'Tech SEO & Tools') {
    categoryDescription = 'Das Fundament für maximale Sichtbarkeit: Optimiere Core Web Vitals, Crawlability und nutze die besten SEO-Tools für tiefe Daten-Analysen und Automatisierungen.';
  } else if (categoryName === 'SEO Praxis') {
    categoryDescription = 'Tiefgründige Case Studies, bewährte SEO-Strategien und ehrliche Insights aus über 25 Jahren Berufsalltag im Performance Marketing. Echtes Wissen für dein Google Ranking.';
  } else if (categoryName === 'Events & Networking') {
    categoryDescription = 'Rückblicke auf die besten SEO-Konferenzen (OMR, Campixx), spannende Vorträge und wertvoller Austausch innerhalb der starken digitalen SEO-Community.';
  }
}

// ==========================================
// POST LOGIC
// ==========================================
let lastReviewed, Content, headings, logoWebp, postImageWebp, readingTime, relatedGlossaryTerms, tachelesQuote;

if (type === 'post') {
  lastReviewed = getGitModDate(`src/content/blog/${post.id}`);
  const rendered = await render(post);
  Content = rendered.Content;
  headings = rendered.headings;
  
  logoWebp = await getImage({ src: logoImage, format: 'webp' });
  if (post.data.image) {
    postImageWebp = await getImage({ src: post.data.image, format: 'webp' });
  }

  // Reading Time Calculation
  const wordCount = (post.body || '').split(/\s+/).length;
  readingTime = Math.ceil(wordCount / 180);

  // Glossary
  const allGlossaryTerms = await getCollection('glossar');
  relatedGlossaryTerms = allGlossaryTerms
    .filter(term => {
      const termTitle = term.data.title.split('(')[0].trim().toLowerCase();
      const postText = (post.data.title + ' ' + (post.data.description || '') + ' ' + (post.data.tags || []).join(' ')).toLowerCase().replace(/-/g, ' ');
      if (postText.includes(termTitle)) return true;
      const keywords = termTitle.split(/\s+/).filter(k => k.length > 3);
      if (keywords.length > 0) {
        const matchCount = keywords.filter(k => postText.includes(k)).length;
        if (matchCount >= Math.ceil(keywords.length / 2)) return true;
      }
      return post.data.tags?.some(tag => termTitle.includes(tag.toLowerCase()));
    })
    .slice(0, 4);
}
---

{type === 'category' ? (
  <Layout title={`${categoryName} | Jörg Zimmer`} description={categoryDescription}>
    <section class="section pt-12 pb-12 bg-white">
      <div class="container-narrow">
        <div class="mb-10">
          <a href={`${baseUrl}/blog/`} class="text-sm font-bold text-gray-muted hover:text-lime-600 transition-colors inline-flex items-center gap-2 mb-6" title="Zurück zur Blog-Übersicht">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Zurück zur Blog-Übersicht
          </a>
          <p class="subheadline mb-2">Themen-Hub</p>
          <h1 class="text-4xl md:text-5xl font-bold leading-normal mb-4">
            <span class="highlight">{categoryName}</span>
          </h1>
          <p class="text-lg text-gray-muted max-w-2xl">
            {categoryDescription}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {categoryPosts.map((p) => (
            <article class="bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-lime-accent transition-all duration-300 flex flex-col h-full group">
              <a href={`${baseUrl}/blog/${p.id}/`} class="flex flex-col h-full">
                {p.data.image && (
                  <div class="overflow-hidden aspect-video">
                    <Image
                      src={p.data.image!}
                      alt={p.data.image_alt || p.data.title}
                      width={600}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                      format="webp"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="text-[10px] text-gray-muted">
                      {new Date(p.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </span>
                  </div>
                  <h2 class="text-xl font-bold mb-3 group-hover:text-lime-600 transition-colors">
                    {p.data.title}
                  </h2>
                  <p class="text-gray-muted text-sm mb-6 line-clamp-3 flex-grow">
                    {p.data.description}
                  </p>
                  <div class="mt-auto pt-4 border-t border-gray-50">
                    <span class="text-xs font-bold text-dark inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                      Artikel lesen
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <Schema title={`${categoryName} | Jörg Zimmer`} description={categoryDescription} />
  </Layout>
) : (
  <Layout
    title={post.data.title}
    description={post.data.description}
    ogImage={postImageWebp?.src || (post.data.image as any)?.src}
    lcpImage={postImageWebp?.src}
  >
    <article class="section pt-8 relative">
      <div class="container-narrow">
        <nav class="flex items-center gap-2 text-xs text-gray-muted mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-dark transition-colors" title="Home">Home</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <a href={`${baseUrl}/blog/`} class="hover:text-dark transition-colors" title="Blog">Blog</a>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          <span class="text-dark font-medium line-clamp-1 truncate">{post.data.title}</span>
        </nav>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
          <a href={`${baseUrl}/blog/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors" title="Zurück zum Blog">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Zurück zum Blog
          </a>
          <div class="flex items-center gap-4 text-sm text-gray-muted">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {readingTime} Min. Lesezeit
            </span>
          </div>
        </div>

        <header class="mb-12 max-w-4xl">
          <p class="subheadline mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>{new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            {lastReviewed && new Date(lastReviewed).getTime() > new Date(post.data.date).getTime() + 86400000 && (
              <span class="text-gray-muted text-xs font-normal italic">
                (Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })})
              </span>
            )}
          </p>

          <h1 class="text-3xl md:text-5xl lg:text-6xl font-black leading-tight mb-8">{post.data.title}</h1>
          <div class="flex flex-wrap items-center gap-6">
            <div class="flex items-center gap-3">
               <Image src={portraitImage} alt="Jörg Zimmer" width={64} height={64} class="w-10 h-10 rounded-full border-2 border-white shadow-sm object-cover object-top" />
                <div class="text-sm">
                  <span class="block font-bold text-dark">Jörg Zimmer</span>
                  <span class="block text-gray-muted text-xs">SEO & SEA Experte</span>
                </div>
            </div>
            {post.data.linkedin_url && (
              <a href={post.data.linkedin_url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-bold text-lime-700 bg-lime-accent/20 px-4 py-2 rounded-full hover:bg-lime-accent/30 transition-all" title="LinkedIn Story">
                LinkedIn Story
              </a>
            )}
          </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <aside class="lg:col-span-4 order-1 lg:order-1 lg:sticky lg:top-24 space-y-8">
            {headings.length > 0 && (
              <nav class="p-6 bg-gray-50 border border-gray-100 rounded-3xl">
                <h2 class="text-lg font-bold mb-4 flex items-center gap-2 !mt-0 !mb-4 border-none !pb-0">
                  <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
                  Inhalt
                </h2>
                <ul class="space-y-3">
                  {headings.filter(h => h.depth <= 3).map(heading => (
                    <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                      <a href={`#${heading.slug}`} class="text-sm text-gray-muted hover:text-lime-600 transition-colors flex items-start gap-2 group" title={heading.text}>
                        <span class="w-1 h-1 bg-gray-300 rounded-full mt-2 group-hover:bg-lime-500 transition-colors"></span>
                        <span class="flex-1">{heading.text}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </aside>

          <div class="lg:col-span-8 order-2 lg:order-2">
            {post.data.image && (
              <div class="mb-12 rounded-3xl overflow-hidden shadow-xl border border-gray-100">
                <Image src={post.data.image} alt={post.data.image_alt || post.data.title} class="w-full h-auto object-cover object-top" format="webp" loading="eager" fetchpriority="high" />
              </div>
            )}

            <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg prose-pre:whitespace-pre-wrap prose-pre:break-words" id="blog-content">
              {post.data.key_takeaways && <KeyTakeaways takeaways={post.data.key_takeaways} />}
              <Content />
              {post.data.show_roi_calculator && <ROICalculator />}
              {post.data.download_card && <DownloadCard {...post.data.download_card} />}
              {post.data.faqs && <FAQAccordion faqs={post.data.faqs} />}
            </div>

            <div class="mt-16 p-8 bg-gray-50 border border-gray-100 rounded-3xl flex flex-col md:flex-row items-center justify-between gap-6">
              <div class="text-center md:text-left">
                <h4 class="text-lg font-bold mb-1">Diesen Beitrag teilen?</h4>
                <p class="text-sm text-gray-muted">Vielleicht hilft er ja auch anderen in deinem Netzwerk.</p>
              </div>
              <div class="flex items-center gap-3">
                <button data-url={`https://teleschmie.de/blog/${post.id}/`} class="copy-link-btn btn-secondary !py-2.5 !px-5 text-sm flex items-center gap-2 group relative">
                  Link kopieren
                  <span class="copy-feedback absolute -top-10 left-1/2 -translate-x-1/2 bg-[#1a1b1e] text-white text-[10px] font-bold uppercase py-1 px-2 rounded border border-gray-700 opacity-0 transition-opacity whitespace-nowrap pointer-events-none shadow-lg z-10">
                    Kopiert!
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <footer class="mt-20 pt-12 border-t border-gray-100">
          <div class="bg-gray-50 rounded-2xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start">
            <Image src={portraitImage} alt="Jörg Zimmer" width={96} height={96} class="w-24 h-24 rounded-full object-cover object-top shadow-sm border-2 border-white" />
            <div class="flex-1 text-center md:text-left">
              <h4 class="text-xl font-bold text-dark mb-2">Über den Autor: Jörg Zimmer</h4>
              <p class="text-gray-muted mb-4 leading-relaxed">
                Jörg Zimmer ist SEO, GEO, AI Visibility Freelancer mit 25 Jahren Erfahrung als Algorithmus Experte und heute Unternehmensberater für digitale Sichtbarkeit.
              </p>
              <div class="flex flex-wrap justify-center md:justify-start gap-4">
                <a href={`${baseUrl}/ueber-mich/`} class="text-lime-600 font-bold hover:underline underline-offset-4" title="Mehr über Jörg erfahren →">Mehr über Jörg erfahren →</a>
                <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1"
                 title="LinkedIn">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  LinkedIn
                </a>
              </div>
            </div>
          </div>
        </footer>

        <RelatedLinks currentId={post.id} currentTitle={post.data.title} currentTags={post.data.tags || []} />
      </div>
    </article>

    <Schema 
      type="article"
      title={post.data.title}
      description={post.data.description}
      image={postImageWebp ? `https://teleschmie.de${postImageWebp.src}` : undefined}
      datePublished={post.data.date}
      dateModified={lastReviewed}
      lastReviewed={lastReviewed}
      faqs={post.data.faqs}
      url={`https://teleschmie.de/blog/${post.id}/`}
    />
  </Layout>
)}
<style>
  .prose blockquote { font-style: normal; }
</style>
