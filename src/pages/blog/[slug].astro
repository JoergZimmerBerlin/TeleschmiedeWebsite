---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import logoImage from '../../assets/images/logo-teleschmiede.webp';
import { getGitModDate } from '../../utils/git-date';
import Schema from '../../components/Schema.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const lastReviewed = getGitModDate(`src/content/blog/${post.id}`);
const { Content, headings } = await render(post);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const logoWebp = await getImage({ src: logoImage, format: 'webp' });
let postImageWebp = null;
if (post.data.image) {
  postImageWebp = await getImage({ src: post.data.image, format: 'webp' });
}

// Reading Time Calculation
const wordCount = (post.body || '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 180); // Avg 180 wpm (German Standard)

// Fetch explicitly defined related posts from frontmatter
const explicitRelatedPosts = post.data.related_posts 
  ? allPosts.filter(p => post.data.related_posts.includes(p.id)) 
  : [];

const dynamicRelatedPosts = allPosts
  .filter(p => p.id !== post.id && !explicitRelatedPosts.some(e => e.id === p.id)) // Exclude current and already explicitly selected
  .map(p => {
    let score = 0;
    
    // Category match (highest weight)
    if (p.data.category && post.data.category && p.data.category === post.data.category) {
      score += 5;
    }
    
    // Tag matches
    const commonTags = p.data.tags?.filter(tag => post.data.tags?.includes(tag)) || [];
    score += commonTags.length * 3;
    
    // Title/Description partial matches (contextual)
    const titleWords = post.data.title.toLowerCase().split(/\W+/).filter(w => w.length > 3);
    const otherText = (p.data.title + ' ' + (p.data.description || '')).toLowerCase();
    const wordMatches = titleWords.filter(w => otherText.includes(w));
    score += wordMatches.length * 1;
    
    return { ...p, score };
  })
  .filter(p => p.score > 1) // Higher threshold for relevance
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, Math.max(0, 3 - explicitRelatedPosts.length)); // Top 3 combined

const combinedRelatedPosts = [...explicitRelatedPosts, ...dynamicRelatedPosts];

// Fallback logic to ensure 3 links (mix of same category and latest)
const finalRelatedPosts = combinedRelatedPosts.length >= 3 
  ? combinedRelatedPosts 
  : [
      ...combinedRelatedPosts,
      ...allPosts
        .filter(p => p.id !== post.id && !combinedRelatedPosts.find(r => r.id === p.id))
        .map(p => {
          let fallbackScore = 0;
          if (p.data.category === post.data.category) fallbackScore += 10;
          return { ...p, fallbackScore };
        })
        .sort((a, b) => {
          if (b.fallbackScore !== a.fallbackScore) return b.fallbackScore - a.fallbackScore;
          return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
        })
        .slice(0, 3 - combinedRelatedPosts.length)
    ];

// Fetch related glossary terms for cross-linking
const allGlossaryTerms = await getCollection('glossar');
const relatedGlossaryTerms = allGlossaryTerms
  .filter(term => {
    const termTitle = term.data.title.split('(')[0].trim().toLowerCase();
    const postText = (post.data.title + ' ' + (post.data.description || '') + ' ' + (post.data.tags || []).join(' ')).toLowerCase().replace(/-/g, ' ');
    
    // Fuzzy match: check if the term title exists as a substring
    if (postText.includes(termTitle)) return true;
    
    // Keyword match: if at least 50% of keywords (min 4 chars) match
    const keywords = termTitle.split(/\s+/).filter(k => k.length > 3);
    if (keywords.length > 0) {
      const matchCount = keywords.filter(k => postText.includes(k)).length;
      if (matchCount >= Math.ceil(keywords.length / 2)) return true;
    }
    
    return post.data.tags?.some(tag => termTitle.includes(tag.toLowerCase()));
  })
  .slice(0, 4);

// Tacheles Quote Extractor for AI citation schema
const tachelesMatch = (post.body || '').match(/> \*\*Tacheles:\*\* (.*)/);
const tachelesQuote = tachelesMatch ? tachelesMatch[1].trim().replace(/\[(.*?)\]\(.*?\)/g, '$1') : null; // Remove markdown links for clean schema
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={postImageWebp?.src || (post.data.image as any)?.src}
  lcpImage={postImageWebp?.src}
>
  <article class="section pt-8 relative">

    <div class="container-narrow">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-gray-muted mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-dark transition-colors">Home</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <a href={`${baseUrl}/blog/`} class="hover:text-dark transition-colors">Blog</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-dark font-medium line-clamp-1 truncate">{post.data.title}</span>
      </nav>

      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <!-- Back Link -->
        <a href={`${baseUrl}/blog/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Blog
        </a>

        <!-- Reading Time -->
        <div class="flex items-center gap-4 text-sm text-gray-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} Min. Lesezeit
          </span>
        </div>
      </div>

      <!-- Article Header (Moved UP) -->
      <header class="mb-12 max-w-4xl">
        <p class="subheadline mb-4 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>{new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          {lastReviewed && new Date(lastReviewed).getTime() > new Date(post.data.date).getTime() + 86400000 && (
            <span class="text-gray-muted text-xs font-normal italic">
              (Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })})
            </span>
          )}
        </p>

        <h1 class="text-3xl md:text-5xl lg:text-6xl font-black leading-tight mb-8">
          {post.data.title}
        </h1>
        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-3">
             <Image
                src={portraitImage}
                alt="Jörg Zimmer"
                width={64}
                height={64}
                class="w-10 h-10 rounded-full border-2 border-white shadow-sm object-cover object-top"
              />
              <div class="text-sm">
                <span class="block font-bold text-dark">Jörg Zimmer</span>
                <span class="block text-gray-muted text-xs">SEO & SEA Experte</span>
              </div>
          </div>
          {post.data.linkedin_url && (
            <a
              href={post.data.linkedin_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-lime-700 bg-lime-accent/20 px-4 py-2 rounded-full hover:bg-lime-accent/30 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn Story
            </a>
          )}
        </div>
      </header>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Sidebar (Sticky on Desktop, appears FIRST on mobile) -->
        <aside class="lg:col-span-4 order-1 lg:order-1 lg:sticky lg:top-24 space-y-8">
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <nav class="p-6 bg-gray-50 border border-gray-100 rounded-3xl">
              <h2 class="text-lg font-bold mb-4 flex items-center gap-2 !mt-0 !mb-4 border-none !pb-0">
                <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Inhalt
              </h2>
              <ul class="space-y-3">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                    <a 
                      href={`#${heading.slug}`} 
                      class="text-sm text-gray-muted hover:text-lime-600 transition-colors flex items-start gap-2 group"
                    >
                      <span class="w-1 h-1 bg-gray-300 rounded-full mt-2 group-hover:bg-lime-500 transition-colors"></span>
                      <span class="flex-1">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </aside>

        <!-- Main Content -->
        <div class="lg:col-span-8 order-2 lg:order-2">
          <!-- Featured Image (Moved into Grid) -->
          {post.data.image && (
            <div class="mb-12 rounded-3xl overflow-hidden shadow-xl border border-gray-100">
              <Image
                src={post.data.image}
                alt={post.data.image_alt || post.data.title}
                class="w-full h-auto object-cover object-top"
                format="webp"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}

          <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg" id="blog-content">
            {post.data.key_takeaways && <KeyTakeaways takeaways={post.data.key_takeaways} />}
            <Content />
            {post.data.show_roi_calculator && <ROICalculator />}
            {post.data.download_card && <DownloadCard {...post.data.download_card} />}
            {post.data.faqs && <FAQAccordion faqs={post.data.faqs} />}
          </div>

          <!-- Share Section -->
          <div class="mt-16 p-8 bg-gray-50 border border-gray-100 rounded-3xl flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="text-center md:text-left">
              <h4 class="text-lg font-bold mb-1">Diesen Beitrag teilen?</h4>
              <p class="text-sm text-gray-muted">Vielleicht hilft er ja auch anderen in deinem Netzwerk.</p>
            </div>
            <div class="flex items-center gap-3">
              <button 
                data-url={`https://teleschmie.de/blog/${post.id}/`}
                class="copy-link-btn btn-secondary !py-2.5 !px-5 text-sm flex items-center gap-2 group relative"
              >
                <svg class="w-4 h-4 text-lime-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z" /></svg>
                Link kopieren
                <span class="copy-feedback absolute -top-10 left-1/2 -translate-x-1/2 bg-dark text-white text-[10px] px-2 py-1 rounded opacity-0 transition-opacity pointer-events-none">Kopiert!</span>
              </button>
            </div>
          </div>
        </div>
      </div>






      <!-- Author Box -->
      <footer class="mt-20 pt-12 border-t border-gray-100">
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau"
            width={96}
            height={96}
            class="w-24 h-24 rounded-full object-cover object-top shadow-sm border-2 border-white"
          />
          <div class="flex-1 text-center md:text-left">
            <h4 class="text-xl font-bold text-dark mb-2">Über den Autor: Jörg Zimmer</h4>
            <p class="text-gray-muted mb-4 leading-relaxed">
              Jörg Zimmer ist SEO- und SEA-Freelancer aus Berlin Spandau mit über 20 Jahren Erfahrung. 
              Er hilft Unternehmen dabei, in einer KI-getriebenen Welt sichtbar zu bleiben und nachhaltig Suchtraffic aufzubauen.
            </p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
              <a
                href={`${baseUrl}/ueber-mich/`}
                class="text-lime-600 font-bold hover:underline underline-offset-4"
              >
                Mehr über Jörg erfahren →
              </a>
              <a
                href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </footer>

      <!-- Related Posts -->
      {finalRelatedPosts.length > 0 && (
        <div class="mt-20 pt-12 border-t border-gray-100">
          <h3 class="text-2xl font-bold mb-8">Das könnte dich auch interessieren</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {finalRelatedPosts.map(p => (
              <a href={`${baseUrl}/blog/${p.id}/`} class="group block bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-md transition-all">
                <div class="aspect-video overflow-hidden">
                  {p.data.image && (
                    <Image 
                      src={p.data.image} 
                      alt={p.data.image_alt || p.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover object-[center_15%] group-hover:scale-105 transition-transform duration-500"
                      format="webp"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-4">
                  <span class="text-[10px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                    {p.data.category || 'SEO'}
                  </span>
                  <h4 class="font-bold text-sm line-clamp-2 group-hover:text-lime-600 transition-colors">
                    {p.data.title}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Glossary Terms (Cross-Linking) -->
      {relatedGlossaryTerms.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-100 pb-20">
          <h3 class="text-2xl font-bold mb-8">Passende Begriffe aus dem Glossar</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {relatedGlossaryTerms.map(term => (
              <a href={`${baseUrl}/glossar/${term.id}/`} class="group block bg-gray-50 border border-gray-100 rounded-xl p-4 hover:shadow-md transition-all">
                <span class="text-[9px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                  Glossar
                </span>
                <h4 class="font-bold text-sm group-hover:text-lime-600 transition-colors line-clamp-1">
                  {term.data.title}
                </h4>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <Schema 
    type="article"
    title={post.data.title}
    description={post.data.description}
    image={postImageWebp ? `https://teleschmie.de${postImageWebp.src}` : undefined}
    datePublished={post.data.date}
    dateModified={lastReviewed}
    lastReviewed={lastReviewed}
    faqs={post.data.faqs}

    url={`https://teleschmie.de/blog/${post.id}/`}
  />
</Layout>

<style>
  .prose blockquote {
    font-style: normal;
  }
</style>
