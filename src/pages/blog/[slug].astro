        </div>
      </footer>

      <!-- Related Posts -->
      {finalRelatedPosts.length > 0 && (
        <div class="mt-20 pt-12 border-t border-gray-100">
          <h3 class="text-2xl font-bold mb-8">Das könnte dich auch interessieren</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {finalRelatedPosts.map(p => (
              <a href={`${baseUrl}/blog/${p.id}/`} class="group block bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-md transition-all">
                <div class="aspect-video overflow-hidden">
                  {p.data.image && (
                    <Image 
                      src={p.data.image} 
                      alt={p.data.image_alt || p.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                      format="webp"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-4">
                  <span class="text-[10px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                    {p.data.category || 'SEO'}
                  </span>
                  <h4 class="font-bold text-sm line-clamp-2 group-hover:text-lime-600 transition-colors">
                    {p.data.title}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Glossary Terms (Cross-Linking) -->
      {relatedGlossaryTerms.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-100 pb-20">
          <h3 class="text-2xl font-bold mb-8">Passende Begriffe aus dem Glossar</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {relatedGlossaryTerms.map(term => (
              <a href={`${baseUrl}/glossar/${term.id}/`} class="group block bg-gray-50 border border-gray-100 rounded-xl p-4 hover:shadow-md transition-all">
                <span class="text-[9px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                  Glossar
                </span>
                <h4 class="font-bold text-sm group-hover:text-lime-600 transition-colors line-clamp-1">
                  {term.data.title}
                </h4>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

