---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import logoImage from '../../assets/images/logo-teleschmiede.webp';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const logoWebp = await getImage({ src: logoImage, format: 'webp' });
let postImageWebp = null;
if (post.data.image) {
  postImageWebp = await getImage({ src: post.data.image, format: 'webp' });
}

// Reading Time Calculation
const wordCount = (post.body || '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 180); // Avg 180 wpm (German Standard)

// Get related posts with scoring
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id) // Exclude current
  .map(p => {
    let score = 0;
    
    // Category match (highest weight)
    if (p.data.category && post.data.category && p.data.category === post.data.category) {
      score += 5;
    }
    
    // Tag matches
    const commonTags = p.data.tags?.filter(tag => post.data.tags?.includes(tag)) || [];
    score += commonTags.length * 2;
    
    return { ...p, score };
  })
  .filter(p => p.score > 0) // Only show the ones that have some relation
  .sort((a, b) => {
    // 1. Higher score first
    if (b.score !== a.score) return b.score - a.score;
    // 2. Newer date first for same score
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3); // Top 3

// Fallback to most recent posts if no thematic matches found
const finalRelatedPosts = relatedPosts.length >= 3 
  ? relatedPosts 
  : [
      ...relatedPosts,
      ...allPosts
        .filter(p => p.id !== post.id && !relatedPosts.find(r => r.id === p.id))
        .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
        .slice(0, 3 - relatedPosts.length)
    ];

// Tacheles Quote Extractor for AI citation schema
const tachelesMatch = (post.body || '').match(/> \*\*Tacheles:\*\* (.*)/);
const tachelesQuote = tachelesMatch ? tachelesMatch[1].trim().replace(/\[(.*?)\]\(.*?\)/g, '$1') : null; // Remove markdown links for clean schema
---

<Layout
  title={`${post.data.title} | Jörg Zimmer Blog`}
  description={post.data.description}
  ogImage={postImageWebp?.src || post.data.image?.src}
  lcpImage={postImageWebp?.src}
>
  <article class="section pt-8">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <!-- Back Link -->
        <a href={`${baseUrl}/blog/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Blog
        </a>

        <!-- Reading Time -->
        <div class="flex items-center gap-4 text-sm text-gray-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} Min. Lesezeit
          </span>
        </div>
      </div>

      <!-- Featured Image -->
      {post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.image_alt || post.data.title}
          class="w-full rounded-2xl mb-8 shadow-sm h-auto"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      )}

      <!-- Article Header -->
      <header class="mb-12">
        <p class="subheadline mb-4">
          {new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
          {post.data.title}
        </h1>
        {post.data.linkedin_url && (
          <a
            href={post.data.linkedin_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-gray-muted hover:text-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            Dieser Beitrag entstand aus diesem LinkedIn-Beitrag
          </a>
        )}
      </header>

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Sidebar (Sticky on Desktop, appears FIRST on mobile) -->
        <aside class="lg:col-span-4 order-1 lg:order-1 lg:sticky lg:top-24 space-y-8">
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <nav class="p-6 bg-gray-50 border border-gray-100 rounded-3xl">
              <h2 class="text-lg font-bold mb-4 flex items-center gap-2 !mt-0 !mb-4 border-none !pb-0">
                <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Inhalt
              </h2>
              <ul class="space-y-3">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                    <a 
                      href={`#${heading.slug}`} 
                      class="text-sm text-gray-muted hover:text-lime-600 transition-colors flex items-start gap-2 group"
                    >
                      <span class="w-1 h-1 bg-gray-300 rounded-full mt-2 group-hover:bg-lime-500 transition-colors"></span>
                      <span class="flex-1">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </aside>

        <!-- Main Content -->
        <div class="lg:col-span-8 order-2 lg:order-2">
          <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg" id="blog-content">
            {post.data.key_takeaways && <KeyTakeaways takeaways={post.data.key_takeaways} />}
            <Content />
            {post.data.show_roi_calculator && <ROICalculator />}
            {post.data.download_card && <DownloadCard {...post.data.download_card} />}
            {post.data.faqs && <FAQAccordion faqs={post.data.faqs} />}
          </div>
        </div>
      </div>



<script is:inline>
  document.addEventListener('astro:page-load', () => {


          // Copy Link Logic
          const copyBtn = document.getElementById('copy-link');
          const feedback = document.getElementById('copy-feedback');
          
          if (copyBtn && feedback) {
            copyBtn.addEventListener('click', async () => {
              const url = copyBtn.dataset.url;
              try {
                if (url) {
                  await navigator.clipboard.writeText(url);
                  feedback.classList.remove('opacity-0');
                  feedback.classList.add('opacity-100');
                  setTimeout(() => {
                    feedback.classList.remove('opacity-100');
                    feedback.classList.add('opacity-0');
                  }, 2000);
                }
              } catch (err) {
                console.error('Failed to copy: ', err);
              }
            });
          }

          window.addEventListener('scroll', updateProgress);
          window.addEventListener('resize', updateProgress);
          updateProgress();
        });
      </script>


      <!-- Author Box -->
      <footer class="mt-20 pt-12 border-t border-gray-100">
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer - SEO & SEA Experte"
            width={96}
            height={96}
            class="w-24 h-24 rounded-full object-cover shadow-sm border-2 border-white"
          />
          <div class="flex-1 text-center md:text-left">
            <h4 class="text-xl font-bold text-dark mb-2">Über den Autor: Jörg Zimmer</h4>
            <p class="text-gray-muted mb-4 leading-relaxed">
              Jörg Zimmer ist SEO- und SEA-Freelancer aus Berlin Spandau mit über 24 Jahren Erfahrung ("Digitaler Dinosaurier"). 
              Er hilft Unternehmen, den "Pfusch am Bau" zu beenden, durch Tacheles-Beratung sichtbar zu bleiben und Ranking-Verluste in Umsätze zu verwandeln.
            </p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
              <a
                href={`${baseUrl}/ueber-mich/`}
                class="text-lime-600 font-bold hover:underline underline-offset-4"
              >
                Mehr über Jörg erfahren →
              </a>
              <a
                href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </footer>

      <!-- Related Posts -->
      {finalRelatedPosts.length > 0 && (
        <div class="mt-20 pt-12 border-t border-gray-100">
          <h3 class="text-2xl font-bold mb-8">Das könnte dich auch interessieren</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {finalRelatedPosts.map(p => (
              <a href={`${baseUrl}/blog/${p.id}/`} class="group block bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-md transition-all">
                <div class="aspect-video overflow-hidden">
                  {p.data.image && (
                    <Image 
                      src={p.data.image} 
                      alt={p.data.image_alt || p.data.title}
                      width={400}
                      height={225}
                      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                      format="webp"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-4">
                  <span class="text-[10px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-2 inline-block">
                    {p.data.category || 'SEO'}
                  </span>
                  <h4 class="font-bold text-sm line-clamp-2 group-hover:text-lime-600 transition-colors">
                    {p.data.title}
                  </h4>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <!-- Schema Markup -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["Article", post.data.faqs ? "FAQPage" : null].filter(Boolean),
    "headline": post.data.title,
    "description": post.data.description,
    "image": postImageWebp ? `https://teleschmie.de${postImageWebp.src}` : undefined,
    "datePublished": post.data.date,
    "author": {
      "@type": "Person",
      "@id": "https://teleschmie.de/#person",
      "name": "Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau",
      "url": "https://teleschmie.de/ueber-mich/",
      "jobTitle": "SEO & SEA Freelancer",
      "sameAs": [
        "https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/",
        "https://www.xing.com/profile/Joerg_Zimmer6",
        "https://linktr.ee/jorgzimmer",
        "https://www.instagram.com/joerg.zimmer.berlin/",
        "https://www.facebook.com/teleschmiede",
        "https://www.youtube.com/@Teleschmiede",
        "https://www.tiktok.com/@teleschmiede",
        "https://www.threads.com/@joerg.zimmer.berlin"
      ]
    },
    "publisher": {
      "@type": "Organization",
      "name": "Teleschmiede",
      "logo": {
        "@type": "ImageObject",
        "url": `https://teleschmie.de${logoWebp.src}`
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://teleschmie.de/blog/${post.id}/`
    },
    ...(tachelesQuote ? {
      "review": {
        "@type": "Review",
        "reviewBody": tachelesQuote,
        "author": { "@id": "https://teleschmie.de/#person" }
      }
    } : {}),
    ...(post.data.faqs ? {
      "mainEntity": post.data.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    } : {})
  })} />
</Layout>

<style>
  .prose blockquote {
    font-style: normal;
  }
</style>
