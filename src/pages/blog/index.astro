---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts, sorted by date
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Get all unique tags for filtering
const allTags = [...new Set(posts.flatMap(post => post.data.tags || []))].sort();
---

<Layout
  title="Blog | Jörg Zimmer - SEO Insights"
  description="SEO-Insights, Google-Tipps und Gedanken aus der Praxis. Basierend auf meinen LinkedIn-Beiträgen und über 20 Jahren Erfahrung."
>
  <!-- Hero Section -->
  <section class="section pt-12 pb-12 bg-white">
    <div class="container-narrow">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="subheadline mb-4">Blog</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          <span class="highlight">SEO Insights</span> & Praxistipps.
        </h1>
        <p class="text-lg md:text-xl text-gray-muted">
          Ehrliches SEO, technische Deep-Dives und Gedanken aus über 20 Jahren Erfahrung.
        </p>
      </div>

      <!-- Search & Filter (Client-side) -->
      <div class="mb-12">
        <div class="flex flex-col md:flex-row gap-4 items-center justify-between bg-gray-50 p-4 rounded-2xl border border-gray-100">
          <div class="relative w-full md:w-96">
            <input 
              type="text" 
              id="blog-search" 
              placeholder="Beiträge suchen..." 
              class="w-full pl-10 pr-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-lime-accent/50 focus:border-lime-accent transition-all"
            />
            <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <div class="flex gap-2 overflow-x-auto pb-2 md:pb-0 w-full md:w-auto no-scrollbar" id="tag-filters">
            <button class="tag-filter active px-4 py-1.5 rounded-full text-sm font-medium bg-dark text-white border border-dark transition-all" data-tag="all">
              Alle
            </button>
            {allTags.map(tag => (
              <button class="tag-filter px-4 py-1.5 rounded-full text-sm font-medium bg-white text-gray-muted border border-gray-200 hover:border-lime-accent transition-all" data-tag={tag}>
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Featured Post -->
      {featuredPost && (
        <article class="blog-card featured-post mb-12 group" data-tags={JSON.stringify(featuredPost.data.tags || [])}>
          <a href={`${baseUrl}/blog/${featuredPost.slug}/`} class="flex flex-col lg:flex-row gap-8 bg-white border border-gray-100 rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="lg:w-1/2 overflow-hidden">
              <Image
                src={featuredPost.data.image}
                alt={featuredPost.data.image_alt || featuredPost.data.title}
                width={800}
                height={600}
                class="w-full h-full object-cover object-top aspect-[4/3] group-hover:scale-105 transition-transform duration-500"
                format="webp"
                loading="eager"
              />
            </div>
            <div class="lg:w-1/2 p-8 md:p-12 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 bg-lime-accent/20 text-dark text-xs font-bold rounded-full uppercase tracking-wider">
                  {featuredPost.data.category || 'Featured'}
                </span>
                <span class="text-xs text-gray-400">
                   {new Date(featuredPost.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                </span>
              </div>
              <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 group-hover:text-lime-600 transition-colors">
                {featuredPost.data.title}
              </h2>
              <p class="text-gray-muted text-lg mb-8 line-clamp-3">
                {featuredPost.data.description}
              </p>
              <div class="mt-auto">
                 <span class="inline-flex items-center gap-2 text-sm font-bold text-dark group-hover:gap-4 transition-all">
                    Artikel lesen
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
              </div>
            </div>
          </a>
        </article>
      )}

      <!-- Posts Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="posts-grid">
        {remainingPosts.map((post) => (
          <article class="blog-card group" data-tags={JSON.stringify(post.data.tags || [])} data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
            <a href={`${baseUrl}/blog/${post.slug}/`} class="bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg transition-all flex flex-col h-full">
              {post.data.image && (
                <div class="overflow-hidden aspect-video">
                  <Image
                    src={post.data.image}
                    alt={post.data.image_alt || post.data.title}
                    width={600}
                    height={338}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    format="webp"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6 md:p-8 flex flex-col flex-grow">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-bold text-lime-900 bg-lime-accent/30 px-2 py-0.5 rounded">
                    {post.data.category || 'SEO'}
                  </span>
                  <span class="text-[10px] text-gray-400">
                    {new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </span>
                </div>
                <h2 class="text-xl font-bold mb-3 group-hover:text-lime-600 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-gray-muted text-sm mb-6 line-clamp-3 flex-grow">
                  {post.data.description}
                </p>
                <div class="mt-auto pt-4 border-t border-gray-50">
                  <span class="text-xs font-bold text-dark inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                    Mehr erfahren
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-20">
        <p class="text-xl text-gray-muted">Keine Beiträge zu dieser Suche gefunden.</p>
        <button id="reset-search" class="text-lime-600 font-bold mt-4 hover:underline">Alle anzeigen</button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gray-50">
    <div class="container-narrow text-center">
       <div class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100">
          <p class="subheadline mb-4">Community</p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Nichts mehr verpassen?
          </h2>
          <p class="text-gray-muted text-lg mb-8 max-w-xl mx-auto">
            Folge mir auf LinkedIn für tägliche SEO-Nuggets und diskutiere mit über 5.000 anderen SEO-Experten.
          </p>
          <a
            href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            LinkedIn-Profil besuchen →
          </a>
       </div>
    </div>
  </section>
</Layout>

<script>
  // Simple client-side search and filtering
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const tagButtons = document.querySelectorAll('.tag-filter');
  const postCards = document.querySelectorAll('.blog-card');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-search');

  let activeTag = 'all';
  let searchTerm = '';

  function filterPosts() {
    let visibleCount = 0;

    postCards.forEach(card => {
      const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
      const title = card.querySelector('h2')?.textContent?.toLowerCase() || '';
      const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';
      
      const matchesSearch = title.includes(searchTerm) || desc.includes(searchTerm);
      const matchesTag = activeTag === 'all' || cardTags.includes(activeTag);

      if (matchesSearch && matchesTag) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      noResults?.classList.remove('hidden');
    } else {
      noResults?.classList.add('hidden');
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
    filterPosts();
  });

  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tagButtons.forEach(b => {
        b.classList.remove('active', 'bg-dark', 'text-white', 'border-dark');
        b.classList.add('bg-white', 'text-gray-muted', 'border-gray-200');
      });
      
      btn.classList.add('active', 'bg-dark', 'text-white', 'border-dark');
      btn.classList.remove('bg-white', 'text-gray-muted', 'border-gray-200');
      
      activeTag = btn.getAttribute('data-tag') || 'all';
      filterPosts();
    });
  });

  resetBtn?.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    const allBtn = document.querySelector('[data-tag="all"]');
    (allBtn as HTMLElement)?.click();
    filterPosts();
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
