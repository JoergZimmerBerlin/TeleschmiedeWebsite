---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { slugify } from '../../utils/slugify';

// Get all blog posts, sorted by date
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Get optimized image for LCP
const featuredImage = sortedPosts[0]?.data.image;
const optimizedFeaturedImage = featuredImage 
  ? await getImage({ src: featuredImage, format: 'webp', width: 800 }) 
  : null;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const collectionItems = sortedPosts.map(p => ({
  name: p.data.title,
  url: `https://teleschmie.de/blog/${p.id}/`,
  description: p.data.meta_description || p.data.description
}));

// Get only the 7 latest posts for the "Frisch aus dem Blog" section
const recentPosts = sortedPosts.slice(0, 7);

// Define main Hubs
const hubsConfig = [
  { name: 'SEO Praxis', desc: 'Ehrliche Strategien & Case Studies aus 25 Jahren Berufsalltag.' },
  { name: 'AI SEO', desc: 'Wie KI und LLMs das Search-Game verändern.' },
  { name: 'Tech SEO & Tools', desc: 'Pagespeed, Web-Architektur, API-Hacks und die besten SEO-Tools.' },
  { name: 'Events & Networking', desc: 'Messen wie die OMR, Vorträge und die starke SEO-Community.' }
];

const hubs = hubsConfig.map(hub => {
  const count = sortedPosts.filter(post => {
    // Falls keine Kategorie gesetzt ist, wandert es im Code als Fallback in 'SEO Praxis'
    const category = post.data.category || 'SEO Praxis';
    return category === hub.name;
  }).length;
  return { ...hub, count };
});
---

<Layout
  title="Blog | Jörg Zimmer: SEO Insights & Hubs (2026)"
  description="Aktuelle Insights zu SEO, SEA und Performance Marketing. Stöbere in Themen-Hubs wie AI SEO, SEO Praxis und Technik. (2026)"
  lcpImage={optimizedFeaturedImage?.src}
>
  <!-- Hero Section -->
  <section class="section pt-12 pb-8 bg-white">
    <div class="container-narrow">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="subheadline mb-4">Blog</p>
        <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-6">
          <span class="highlight">SEO Insights</span> & Praxistipps.
        </h1>
        <p class="text-lg md:text-xl text-gray-muted">
          Ehrliches SEO, technische Deep-Dives und Gedanken aus über 25 Jahren Erfahrung.
        </p>
      </div>

      <!-- Themen-Hubs Section -->
      <div class="mb-20">
        <h2 class="text-2xl font-bold mb-6 text-center">Wähle dein Thema:</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {hubs.map(hub => (
            <a 
              href={`${baseUrl}/blog/${slugify(hub.name)}/`}
              class="group relative bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-lime-accent transition-all duration-300 flex flex-col h-full"
            >
              <div class="w-12 h-12 bg-lime-accent/20 text-lime-900 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-bold mb-2 group-hover:text-lime-600 transition-colors flex items-center justify-between">
                {hub.name}
                <span class="text-xs font-bold text-lime-900 bg-lime-accent/30 px-2 py-1 rounded-md">
                  {hub.count} {hub.count === 1 ? 'Artikel' : 'Artikel'}
                </span>
              </h3>
              <p class="text-sm text-gray-muted flex-grow">{hub.desc}</p>
              <div class="mt-4 pt-4 border-t border-gray-50 flex items-center gap-2 text-sm font-bold text-dark group-hover:gap-3 transition-all">
                Artikel lesen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Recent Posts Section -->
      <div>
        <h2 class="text-3xl font-bold mb-8">Frisch aus dem Blog</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {recentPosts.map((post, index) => (
            <article 
              class={`bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-lime-accent transition-all duration-300 flex flex-col h-full group ${index === 0 ? 'md:col-span-2 md:flex-row' : ''}`}
            >
              {index === 0 ? (
                /* Featured Post Layout for the very first item */
                <a href={`${baseUrl}/blog/${post.id}/`} class="flex flex-col md:flex-row w-full h-full">
                  <div class="md:w-1/2 overflow-hidden">
                    {post.data.image && (
                      <Image
                        src={post.data.image!}
                        alt={post.data.image_alt || post.data.title}
                        width={800}
                        class="w-full h-full object-cover object-top md:aspect-auto aspect-video group-hover:scale-105 transition-transform duration-500"
                        format="webp"
                        loading="eager"
                        fetchpriority="high"
                      />
                    )}
                  </div>
                  <div class="md:w-1/2 p-8 flex flex-col justify-center">
                    <div class="flex items-center gap-3 mb-4">
                      <span class="px-3 py-1 bg-lime-accent/20 text-dark text-xs font-bold rounded-full uppercase tracking-wider">
                        {post.data.category || 'SEO'}
                      </span>
                      <span class="text-xs text-gray-muted">
                        {new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                      </span>
                    </div>
                    <h3 class="text-2xl md:text-3xl font-bold mb-4 group-hover:text-lime-600 transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-muted text-lg mb-8 line-clamp-3">
                      {post.data.meta_description || post.data.description}
                    </p>
                    <div class="mt-auto">
                      <span class="inline-flex items-center gap-2 text-sm font-bold text-dark group-hover:gap-4 transition-all">
                        Zum Artikel
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              ) : (
                /* Regular Post Layout */
                <a href={`${baseUrl}/blog/${post.id}/`} class="flex flex-col h-full">
                  {post.data.image && (
                    <div class="overflow-hidden aspect-video">
                      <Image
                        src={post.data.image!}
                        alt={post.data.image_alt || post.data.title}
                        width={600}
                        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                        format="webp"
                        loading={index < 4 ? "eager" : "lazy"}
                      />
                    </div>
                  )}
                  <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <div class="flex items-center gap-3 mb-3">
                      <span class="text-xs font-bold text-lime-900 bg-lime-accent/30 px-2 py-0.5 rounded">
                        {post.data.category || 'SEO'}
                      </span>
                      <span class="text-[10px] text-gray-muted">
                        {new Date(post.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
                      </span>
                    </div>
                    <h3 class="text-xl font-bold mb-3 group-hover:text-lime-600 transition-colors">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-muted text-sm mb-6 line-clamp-3 flex-grow">
                      {post.data.meta_description || post.data.description}
                    </p>
                    <div class="mt-auto pt-4 border-t border-gray-50">
                      <span class="text-xs font-bold text-dark inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                        Mehr erfahren
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>

      <!-- All Posts Archive Window (SEO Inlinks & Complete Overview) -->
      <div class="mt-20 pt-16 border-t border-gray-100" id="all-blog-posts-section">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
          <div>
            <p class="subheadline mb-2">Archiv</p>
            <h2 class="text-3xl font-bold mb-2">Alle Blogartikel im Überblick</h2>
            <p class="text-gray-muted text-sm max-w-2xl mb-0">
              Chronologische Übersicht aller {sortedPosts.length} Fachartikel, Analysen und Praxistipps aus dem Blog.
            </p>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-lime-900 bg-lime-accent/30 px-3 py-1.5 rounded-full whitespace-nowrap">
              {sortedPosts.length} Artikel
            </span>
          </div>
        </div>

        <!-- Search Bar for quick filtering -->
        <div class="blog-filter-wrapper mb-8">
          <div class="search-bar-wrapper">
            <form class="search-bar" id="blog-search-form" onsubmit="return false;">
              <div class="relative w-full flex items-center">
                <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input 
                  type="search" 
                  id="blog-search" 
                  placeholder="Artikel nach Stichwort filtern (z.B. SE Ranking, GEO, Crawling)..." 
                  class="search-input"
                  autocomplete="off"
                />
              </div>
            </form>
          </div>
        </div>

        <!-- Posts Grid Window -->
        <div class="bg-gray-50/70 border border-gray-100 rounded-3xl p-6 md:p-8 shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-y-6 gap-x-8" id="all-posts-grid">
            {sortedPosts.map(post => (
              <a 
                href={`${baseUrl}/blog/${post.id}/`} 
                title={post.data.title} 
                class="all-blog-link group block text-sm transition-all"
                data-title={(post.data.title || '').toLowerCase()}
                data-desc={(post.data.meta_description || post.data.description || '').toLowerCase()}
              >
                <span class="text-[11px] font-mono text-gray-400 group-hover:text-lime-700 transition-colors block mb-1">
                  {new Date(post.data.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}
                </span>
                <span class="text-gray-800 font-medium group-hover:text-lime-600 group-hover:underline underline-offset-4 transition-colors leading-snug line-clamp-2">
                  {post.data.title}
                </span>
              </a>
            ))}
          </div>

          <!-- No Results State -->
          <div id="no-blog-results" class="hidden text-center py-12">
            <p class="text-gray-muted text-sm mb-0">Keinen passenden Blogartikel gefunden.</p>
          </div>
        </div>
      </div>
      
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gray-50">
    <div class="container-narrow text-center">
       <div class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-gray-100">
          <p class="subheadline mb-4">Community</p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Nichts mehr verpassen?
          </h2>
          <p class="text-gray-muted text-lg mb-8 max-w-xl mx-auto">
            Folge mir auf LinkedIn für tägliche SEO-Nuggets und diskutiere mit anderen SEO-Experten.
          </p>
          <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
           title="LinkedIn-Profil besuchen → (2026)">
            LinkedIn-Profil besuchen →
          </a>
       </div>
    </div>
  </section>
  <Schema 
    type="collection"
    title="Blog | Jörg Zimmer - SEO Insights & Themen-Hubs (2026)"
    description="Aktuelle Insights zu SEO, SEA und Performance Marketing von Jörg Zimmer. (2026)"
    collectionItems={collectionItems}
  />
</Layout>

<script is:inline>
  function doBlogSearch() {
    const searchInput = document.getElementById('blog-search');
    if (!searchInput) return;

    const term = searchInput.value.toLowerCase().trim();
    const links = document.querySelectorAll('.all-blog-link');
    const noResults = document.getElementById('no-blog-results');

    let visibleCount = 0;

    links.forEach(link => {
      const title = link.getAttribute('data-title') || '';
      const desc = link.getAttribute('data-desc') || '';

      if (term === '') {
        link.classList.remove('hidden');
        visibleCount++;
      } else {
        if (title.includes(term) || desc.includes(term)) {
          link.classList.remove('hidden');
          visibleCount++;
        } else {
          link.classList.add('hidden');
        }
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  function initBlogSearch() {
    const searchInput = document.getElementById('blog-search');
    const searchForm = document.getElementById('blog-search-form');

    if (searchInput) {
      searchInput.addEventListener('input', doBlogSearch);
    }
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        doBlogSearch();
      });
    }
  }

  initBlogSearch();
</script>

<style>
  .blog-filter-wrapper {
    background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
    border: 1px solid #e5e5e5;
    border-radius: 1.25rem;
    padding: 1.5rem;
  }
  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .search-icon {
    position: absolute;
    left: 0.875rem;
    width: 1.25rem;
    height: 1.25rem;
    color: #aaa;
    pointer-events: none;
    transition: color 0.2s;
  }
  .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 0.75rem;
    border: 1.5px solid #e0e0e0;
    background: #fff;
    font-size: 0.95rem;
    color: #333;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .search-input:focus {
    border-color: #D4FF00;
    box-shadow: 0 0 0 3px rgba(212, 255, 0, 0.2);
  }
</style>
