---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import teamImage1 from '../assets/images/team/team-event-1.jpg';
import teamImage2 from '../assets/images/team/team-event-2.jpg';
import teamImage3 from '../assets/images/team/team-event-3.jpg';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const teamImage1Webp = await getImage({ src: teamImage1, format: 'webp' });
---

<Layout
  title="Freelancer Team | Jörg Zimmer & Netzwerk"
  description="Lerne mein Freelancer Team kennen: Zusammen mit motivierten Profis biete ich geballte Kompetenz in SEO, Tracking, Social Media, Webdesign und mehr. ALOHA! 🌻"
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-6">Netzwerk & Partner</p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8">
        Gemeinsam stark: Das <span class="highlight">Freelancer Team</span>.
      </h1>

      <p class="text-xl text-dark leading-relaxed font-medium mb-12">
        Moin! Ich bin stolzer Teil und aktives Mitglied im Freelancer Team. Meine Mission hier ist es, mit motivierten Profis langfristig zusammenzuarbeiten und schnell für alle Disziplinen ein eingespieltes Team bereitzustellen.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20">
    <div class="container-narrow">
      <div class="grid md:grid-cols-3 gap-12">
        <!-- Sidebar Images -->
        <div class="md:col-span-1 space-y-6">
          <Image
            src={teamImage1}
            alt="Jörg Zimmer auf einem Event des Freelancer Teams"
            width={800}
            height={800}
            class="w-full aspect-square object-cover object-center rounded-2xl shadow-sm h-auto"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />

          <Image
            src={teamImage2}
            alt="Weihnachtsfeier / Sommerfest des Freelancer Teams"
            width={800}
            height={800}
            class="w-full aspect-square object-cover object-center rounded-2xl shadow-sm h-auto"
            format="webp"
            loading="lazy"
          />

          <Image
            src={teamImage3}
            alt="Gute Stimmung im Freelancer Team"
            width={800}
            height={800}
            class="w-full aspect-square object-cover object-center rounded-2xl shadow-sm h-auto"
            format="webp"
            loading="lazy"
          />
        </div>

        <!-- Main Text -->
        <div class="md:col-span-2 space-y-8">
          
          <h2 class="text-3xl font-bold">Geballte Kompetenz, ohne Agentur-Overhead</h2>
          <p class="text-gray-muted leading-relaxed">
            Als Senior SEO- und SEA-Freelancer kenne ich meine Stärken – und meine Grenzen. Moderne digitale Projekte sind oft so komplex, dass eine einzelne Person unmöglich in allen Disziplinen absolute Spitzenklasse sein kann. Genau hier kommt das <strong>Freelancer Team</strong> ins Spiel. Statt dich an eine starre Agentur mit hohen Overheads und langen Kommunikationswegen zu binden, biete ich dir über unser Netzwerk direkten Zugang zu handverlesenen Top-Experten.
          </p>

          <p class="text-gray-muted leading-relaxed">
            Wir arbeiten komplett unabhängig voneinander, ziehen bei gemeinsamen Kundenprojekten aber an einem Strang. Das bedeutet für dich: <strong>Maximale Agilität, transparente Kommunikation direkt mit den Umsetzern und geballtes Fachwissen.</strong>
          </p>

          <h3 class="text-2xl font-bold mt-12 mb-6">Für diese Disziplinen lege ich meine Hand ins Feuer</h3>
          
          <div class="grid sm:grid-cols-2 gap-6 mb-8">
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 transition-colors hover:border-lime-200 hover:bg-lime-50/30">
              <div class="w-10 h-10 bg-lime-accent/20 rounded-full flex items-center justify-center mb-4 text-lime-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
              </div>
              <h4 class="font-bold text-lg mb-2">Tracking & Webanalyse</h4>
              <p class="text-sm text-gray-muted leading-relaxed">Vom serverseitigen GTM-Setup bis zum komplexen E-Commerce-Tracking. Wenn Daten sauber fließen müssen, übernehmen die Profis aus dem Team.</p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 transition-colors hover:border-lime-200 hover:bg-lime-50/30">
              <div class="w-10 h-10 bg-lime-accent/20 rounded-full flex items-center justify-center mb-4 text-lime-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" /></svg>
              </div>
              <h4 class="font-bold text-lg mb-2">Social Media Marketing</h4>
              <p class="text-sm text-gray-muted leading-relaxed">Performante Meta Ads, TikTok Kampagnen oder LinkedIn B2B-Strategien. Hier arbeiten Spezialisten, die den Algorithmus täglich atmen.</p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 transition-colors hover:border-lime-200 hover:bg-lime-50/30">
              <div class="w-10 h-10 bg-lime-accent/20 rounded-full flex items-center justify-center mb-4 text-lime-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
              </div>
              <h4 class="font-bold text-lg mb-2">Webdesign & Code</h4>
              <p class="text-sm text-gray-muted leading-relaxed">Egal ob performantes Shopify-Theme, komplexes WordPress-Plugin oder blitzschnelle Astro-Seiten. Die Devs im Team liefern sauberen, SEO-freundlichen Code.</p>
            </div>

            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 transition-colors hover:border-lime-200 hover:bg-lime-50/30">
              <div class="w-10 h-10 bg-lime-accent/20 rounded-full flex items-center justify-center mb-4 text-lime-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              </div>
              <h4 class="font-bold text-lg mb-2">Grafik & Video Produktion</h4>
              <p class="text-sm text-gray-muted leading-relaxed">Von hochkonvertierenden Ad-Creatives bis zu professionellen Imagefilmen. Visueller Content, der die Aufmerksamkeit deiner Zielgruppe fesselt.</p>
            </div>
          </div>

          <p class="text-gray-muted leading-relaxed">
            Ich übergebe auch gerne spezielle SEO-Anfragen an meine Kollegen, wenn sie fachlich nicht hundertprozentig in mein Kerngebiet fallen oder wenn ich operativ komplett ausgelastet bin. <strong>Reibungslose Übergaben und gebündelte Power – Hauptsache, du bekommst deine Projekte stressfrei und hochprofessionell auf die Straße.</strong>
          </p>

          <h3 class="text-2xl font-bold mt-12 mb-4">Der Faktor Mensch: Familienanschluss inklusive</h3>
          <p class="text-gray-muted leading-relaxed">
            Ein Netzwerk funktioniert nur, wenn die Chemie stimmt. Das ist der Grund, warum ich so gerne Teil des Freelancer Teams bin. Wenn wir uns treffen – sei es im digitalen Daily oder bei unseren legendären Vor-Ort-Events – ist die Stimmung einfach unschlagbar.
          </p>
          <p class="text-gray-muted leading-relaxed">
            Echte Zusammenarbeit entsteht nicht durch Verträge, sondern durch Vertrauen. Durch unsere gemeinsamen All-Hands, das Sommerfest oder die Weihnachtsfeier bekomme ich und auch du als Kunde quasi den "Familienanschluss" mitgeliefert. Wir kennen unsere Stärken, wir spielen uns die Bälle blind zu und wir feiern die Erfolge unserer Kunden gemeinsam. Das macht nicht nur riesig Spaß, sondern ist der ultimative Hebel für herausragende Projektergebnisse. Danke, liebes Freelancer Team!
          </p>

          <!-- Quote Block -->
          <blockquote class="bg-gray-50 border-l-4 border-lime-accent p-6 rounded-r-2xl my-10 italic text-dark max-w-2xl">
            "Meine Leidenschaft liegt in der Suchmaschinenoptimierung. Doch wenn ein Kunde Webdesign, Social Media oder komplexes Tracking braucht, greife ich auf dieses geniale Netzwerk zurück. So kommt jedes Projekt auf die Straße."
            <footer class="mt-4 text-sm font-bold text-gray-500 not-italic">
              <a href="https://www.linkedin.com/posts/joerg-zimmer-seo-sea-freelancer-berlin-spandau_freelancerteam-activity-7212050155968081921-Kocl?utm_source=share&utm_medium=member_desktop&rcm=ACoAADQdMuYBHR-eSucFKv63wjXNHfs3eLpPKlI" target="_blank" rel="noopener noreferrer" class="hover:text-lime-600 transition-colors">
                — Beitrag auf LinkedIn <span class="text-lime-accent">↗</span>
              </a>
            </footer>
          </blockquote>

          <blockquote class="bg-gray-50 border-l-4 border-lime-accent p-6 rounded-r-2xl my-10 italic text-dark max-w-2xl">
            "Zusammenarbeit auf Augenhöhe. Ein eingespieltes Team für jede Disziplin. Die Stimmung beim Sommerfest zeigt: Hier passt es fachlich UND menschlich."
            <footer class="mt-4 text-sm font-bold text-gray-500 not-italic">
              <a href="https://www.linkedin.com/feed/update/urn:li:activity:7399764736323506176" target="_blank" rel="noopener noreferrer" class="hover:text-lime-600 transition-colors">
                — Beitrag auf LinkedIn <span class="text-lime-accent">↗</span>
              </a>
            </footer>
          </blockquote>

          <div class="mt-12 bg-dark text-white p-8 rounded-3xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-lime-accent rounded-full opacity-10 blur-3xl -mr-32 -mt-32"></div>
            <h3 class="text-2xl font-bold mb-4 relative z-10">Lerne das Team kennen</h3>
            <p class="text-white/80 mb-6 relative z-10 max-w-xl">
              Egal welches digitale Projekt du planst – wir haben die passenden Köpfe dafür. Schau dir das gesamte Netzwerk und unsere geballte Kompetenz an.
            </p>
            <a href="https://freelancerteam.de/" target="_blank" rel="noopener noreferrer" class="btn-primary relative z-10 inline-flex items-center gap-2">
              Zur FreelancerTeam Website <span class="text-dark bg-white rounded-full p-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg></span>
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Simple Schema for the page -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Freelancer Team Partner | Jörg Zimmer",
    "description": "Informationen über die Zusammenarbeit von SEO Freelancer Jörg Zimmer mit dem Freelancer Team Netzwerk.",
    "url": "https://teleschmie.de/freelancer-team/",
    "mainEntity": {
      "@type": "Organization",
      "@id": "https://freelancerteam.de/#organization",
      "name": "Freelancer Team",
      "url": "https://freelancerteam.de/",
      "image": `https://teleschmie.de${teamImage1Webp.src}`,
      "member": {
        "@type": "Person",
        "@id": "https://teleschmie.de/#person"
      }
    }
  })} />
</Layout>
