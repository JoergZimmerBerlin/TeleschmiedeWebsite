---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';

import KeyTakeaways from '../../components/KeyTakeaways.astro';
import TachelesEcke from '../../components/TachelesEcke.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import { getGitModDate } from '../../utils/git-date';
import Schema from '../../components/Schema.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

export async function getStaticPaths() {
  const entries = await getCollection('glossar');
  const entryPaths = entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, type: 'term' },
  }));

  const categories = [
    { name: 'SEO Basics & Onpage', slug: 'seo-basics-onpage', desc: 'Die absoluten Basics: Was ist SEO, wie funktionieren Suchmaschinen und erste Schritte.' },
    { name: 'Technisches SEO & UX', slug: 'technisches-seo-ux', desc: 'Crawling, Indexierung, PageSpeed, Core Web Vitals und Architektur.' },
    { name: 'AI SEO & Generative Search', slug: 'ai-seo-generative-search', desc: 'GEO, AIO, LLMs und die Zukunft der KI-gestützten Suchmaschinen.' },
    { name: 'E-E-A-T & Offpage', slug: 'e-e-a-t-offpage', desc: 'Experience, Expertise, Authoritativeness, Trust und Linkbuilding.' }
  ];

  const categoryPaths = categories.map(cat => ({
    params: { slug: cat.slug },
    props: { 
      type: 'category', 
      categoryName: cat.name,
      categoryDescription: cat.desc
    },
  }));

  return [...entryPaths, ...categoryPaths];
}

const { entry, type, categoryName, categoryDescription } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const allEntries = await getCollection('glossar');

let Content, headings, lastReviewed, readingTime, entryImageWebp;

if (type === 'term') {
  lastReviewed = getGitModDate(`src/content/glossar/${entry.id}`);
  const rendered = await render(entry);
  Content = rendered.Content;
  headings = rendered.headings;

  if (entry.data.image) {
    entryImageWebp = await getImage({ src: entry.data.image, format: 'webp' });
  }

  const wordCount = (entry.body || '').split(/\s+/).length;
  readingTime = Math.ceil(wordCount / 180);
}
---

{type === 'category' ? (
  <Layout title={`${categoryName} | Jörg Zimmer`} description={categoryDescription}>
    <section class="section pt-12 pb-12 bg-white">
      <div class="container-narrow">
        <div class="mb-10">
          <a href={`${baseUrl}/glossar/`} class="text-sm font-bold text-gray-muted hover:text-lime-600 transition-colors inline-flex items-center gap-2 mb-6" title="Zurück zur Übersicht (2026)">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Zurück zur Übersicht
          </a>
          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">
            {categoryName}
          </h1>
          <p class="text-lg text-gray-muted max-w-3xl">
            {categoryDescription}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allEntries
            .filter(e => (e.data.category || 'SEO Basics & Onpage') === categoryName)
            .sort((a, b) => a.data.title.localeCompare(b.data.title))
            .map(t => (
              <a href={`${baseUrl}/glossar/${t.id}/`} class="group block bg-white border border-gray-100 rounded-xl p-6 hover:shadow-md hover:border-lime-accent transition-all duration-300">
                <span class="text-[10px] font-bold text-lime-700 bg-lime-accent/20 px-2 py-0.5 rounded uppercase mb-3 inline-block">
                  Glossar
                </span>
                <h2 class="font-bold text-lg mb-2 group-hover:text-lime-600 transition-colors">
                  {t.data.title}
                </h2>
                <p class="text-sm text-gray-muted line-clamp-2">
                  {t.data.description}
                </p>
              </a>
          ))}
        </div>
      </div>
    </section>
    <Schema title={`${categoryName} | Jörg Zimmer`} description={categoryDescription} />
  </Layout>
) : (
<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entryImageWebp?.src || (entry.data.image as any)?.src}
  robots={entry.data.robots}
>
  <article class="section pt-2">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <!-- Back Link -->
        <a href={`${baseUrl}/glossar/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors" title="Zurück zum Glossar (2026)">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Glossar
        </a>

        <!-- Reading Time -->
        <div class="flex items-center gap-4 text-sm text-gray-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime} Min. Lesezeit
          </span>
        </div>
      </div>

      <header class="mb-12">
        <p class="subheadline mb-4 flex flex-wrap items-center gap-2">
          <span>Begriffslexikon</span>
          {entry.data.date && (
            <span class="text-gray-muted text-xs font-normal italic">
              • Erstellt: {new Date(entry.data.date).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
          {lastReviewed && (
            <span class="text-gray-muted text-xs font-normal italic">
              • Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          )}
        </p>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
          {entry.data.title}
        </h1>
      </header>

      <!-- Mobile Hero Image (Visible only on Mobile) -->
      {entry.data.image && (
        <div class="lg:hidden mb-8 rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
          <Image 
            src={entry.data.image} 
            alt={entry.data.image_alt || entry.data.title}
            class="w-full h-auto object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <!-- Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Sidebar (Sticky on Desktop) -->
        <aside class="lg:col-span-4 lg:sticky lg:top-24 space-y-8">
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <nav class="p-6 bg-gray-50 border border-gray-100 rounded-3xl">
              <h2 class="text-lg font-bold mb-4 flex items-center gap-2 !mt-0 !mb-4 border-none !pb-0">
                <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Inhalt
              </h2>
              <ul class="space-y-3">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                    <a href={`#${heading.slug}`} 
                      class="text-sm text-gray-muted hover:text-lime-600 transition-colors flex items-start gap-2 group"
                     title={heading.text}>
                      <span class="w-1 h-1 bg-gray-300 rounded-full mt-2 group-hover:bg-lime-500 transition-colors"></span>
                      <span class="flex-1">{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

        </aside>

        <!-- Main Content -->
        <div class="lg:col-span-8">
          <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg prose-pre:whitespace-pre-wrap prose-pre:break-words" id="blog-content">
            {entry.data.key_takeaways && <KeyTakeaways takeaways={entry.data.key_takeaways} />}
            
            {entry.data.image && (
              <div class="hidden lg:block mb-12 rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
                <Image 
                  src={entry.data.image} 
                  alt={entry.data.image_alt || entry.data.title}
                  class="w-full h-auto object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )}

            {entry.data.tacheles && <TachelesEcke insight={entry.data.tacheles} />}

            <Content />
            {entry.data.faqs && <FAQAccordion faqs={entry.data.faqs} />}

          </div>
          <!-- CTA -->
          <div class="mt-20 p-8 bg-gray-50 border border-gray-100 rounded-3xl text-center">
            <h3 class="text-2xl font-bold mb-4">Nichts mehr verpassen?</h3>
            <p class="text-gray-muted mb-6">Folge mir auf LinkedIn für tägliche SEO-Nuggets und diskutiere mit anderen Experten.</p>
            <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex" title="LinkedIn-Profil besuchen → (2026)">LinkedIn-Profil besuchen →</a>
          </div>
          <RelatedLinks currentId={entry.id} currentTitle={entry.data.title} currentTags={entry.data.category ? [entry.data.category] : []} />
        </div>
      </div>





      <!-- Author Box -->
      <footer class="mt-20 pt-12 border-t border-gray-100">
        <div class="bg-gray-50 rounded-2xl p-8 flex flex-col md:flex-row gap-8 items-center md:items-start">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer"
            width={96}
            height={96}
            class="w-24 h-24 rounded-full object-cover object-top shadow-sm border-2 border-white"
          />
          <div class="flex-1 text-center md:text-left">
            <h4 class="text-xl font-bold text-dark mb-2">Über den Autor: Jörg Zimmer</h4>
            <p class="text-gray-muted mb-4 leading-relaxed">
              Jörg Zimmer ist SEO, GEO, AI Visibility Freelancer mit 25 Jahren Erfahrung als Algorithmus Experte und heute Unternehmensberater für digitale Sichtbarkeit.
            </p>
            <div class="flex flex-wrap justify-center md:justify-start gap-4">
              <a href={`${baseUrl}/ueber-mich/`}
                class="text-lime-600 font-bold hover:underline underline-offset-4"
               title="Mehr über Jörg erfahren → (2026)">
                Mehr über Jörg erfahren →
              </a>
              <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-muted hover:text-dark transition-colors inline-flex items-center gap-1"
               title="LinkedIn (2026)">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </footer>


    </div>
  </article>

  <Schema 
    type="glossary"
    title={entry.data.title}
    description={entry.data.description}
    image={entryImageWebp ? `https://teleschmie.de${entryImageWebp.src}` : undefined}
    datePublished={entry.data.date}
    dateModified={lastReviewed}
    lastReviewed={lastReviewed}
    faqs={entry.data.faqs}
    sameAs={entry.data.sameAs}
    alternateNames={entry.data.synonyms}
    url={`https://teleschmie.de/glossar/${entry.id}/`}
  />
</Layout>



)}
