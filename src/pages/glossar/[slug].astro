---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('glossar');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch related terms
const allEntries = await getCollection('glossar');
const relatedTerms = allEntries.filter((e) => 
  entry.data.related_terms?.includes(e.slug)
);
---

<Layout
  title={`${entry.data.title} | SEO Glossar | Jörg Zimmer`}
  description={entry.data.description}
>
  <article class="section pt-8">
    <div class="container-narrow">
      <div class="mb-8">
        <a href={`${baseUrl}/glossar/`} class="inline-flex items-center gap-2 text-gray-muted hover:text-dark transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Zurück zum Glossar
        </a>
      </div>

      <header class="mb-12">
        <p class="subheadline mb-4">SEO Begriffslexikon</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
          {entry.data.title}
        </h1>
      </header>

      <div class="blog-content prose prose-lg max-w-none leading-relaxed prose-headings:text-dark prose-p:text-gray-text prose-a:text-lime-600 prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-lime-700 prose-strong:text-dark prose-blockquote:border-lime-accent prose-blockquote:bg-gray-50 prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:my-12 prose-blockquote:rounded-r-lg" id="blog-content">
        <Content />
      </div>

      {relatedTerms.length > 0 && (
        <div class="mt-16 pt-8 border-t border-gray-100">
          <h3 class="text-xl font-bold mb-4">Verwandte Begriffe</h3>
          <div class="flex flex-wrap gap-3">
            {relatedTerms.map((t) => (
              <a 
                href={`${baseUrl}/glossar/${t.slug}/`} 
                class="px-4 py-2 bg-gray-50 border border-gray-200 rounded-full text-sm font-medium hover:bg-lime-accent/20 hover:border-lime-500 hover:text-dark transition-all"
              >
                {t.data.title}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-20 p-8 bg-gray-50 border border-gray-100 rounded-3xl text-center">
        <h3 class="text-2xl font-bold mb-4">Nichts mehr verpassen?</h3>
        <p class="text-gray-muted mb-6">Folge mir auf LinkedIn für tägliche SEO-Nuggets und diskutiere mit über 5.000 anderen Experten.</p>
        <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex">LinkedIn-Profil besuchen →</a>
      </div>
    </div>
  </article>

  <!-- Schema.org Definition -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    "name": entry.data.title,
    "description": entry.data.description,
    "inDefinedTermSet": "https://teleschmie.de/glossar/"
  })} />
</Layout>

<style is:global>
  .blog-content h2 {
    @apply text-2xl md:text-3xl font-bold mt-16 mb-6 border-b border-gray-100 pb-4 !important;
  }
  .blog-content h3 {
    @apply text-xl md:text-2xl font-bold mt-12 mb-4 !important;
  }
  .blog-content p {
    @apply mb-6 leading-relaxed !important;
  }
  .blog-content li {
    @apply mb-3 !important;
  }
  /* Pseudo-headings: Paragraphs starting with bold text */
  .blog-content p > strong:first-child:only-child,
  .blog-content p > strong:first-child {
    @apply block mt-8 mb-2 text-dark text-lg !important;
  }
</style>
