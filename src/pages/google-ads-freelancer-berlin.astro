---
import { Image, getImage } from 'astro:assets';
import { getGitModDate } from '../utils/git-date';
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import heroImage from '../assets/images/pages/hero-pose.webp';
import joergWorking from '../assets/images/profile/joerg-lifestyle.webp';
import joergCTA from '../assets/images/profile/joerg-zimmer-cta.webp';
import joergInterview from '../assets/images/blog/seopresso-interview.webp';
import joergPodcast from '../assets/images/blog/ai-ready-podcast.webp';
import ContextualImage from '../assets/images/blog/seo-ads-synergie.webp';
import Testimonials from '../components/Testimonials.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/google-ads-freelancer-berlin.astro');

// Generate WebP Image Paths for Schema.org
const joergWorkingWebp = await getImage({ src: joergWorking, format: 'webp' });
const heroImageWebp = await getImage({ src: heroImage, format: 'webp' });

// Meta Data
const title = "Google Ads Freelancer Berlin: ROI-Fokus & Klare Kante";
const description = "Du verbrennst Budget bei Google Ads? Ich hole die Kontrolle zurück. Dein Google Ads Freelancer in Berlin für B2B, Shops & Local. Moin! 🌻";

const faqs = [
  {
    question: "Warum sollte ich einen Google Ads Freelancer buchen und keine Agentur?",
    answer: "Weil du bei mir genau den Experten bekommst, mit dem du auch die Strategie besprichst. Keine Junior-Account-Manager, kein ewiges 'Wir geben das an die Technik weiter' – das ist oft der Anfang vom Ende deines Budgets. Ich habe über 10 Jahre Erfahrung als Google Partner und arbeite direkt an deinem Erfolg. Du bekommst Tacheles statt bunter Reports ohne Aussagekraft."
  },
  {
    question: "Was kostet die Zusammenarbeit und bietest du feste Pakete an?",
    answer: "Ja, Transparenz ist mein oberstes Gebot. Du hast die Wahl: Die <strong>Sprechstunde (400€)</strong> für den schnellen Account-Check, das <strong>10-Stunden Paket (1.600€)</strong> für Setups oder der <strong>Monatliche Retainer (ab 1.600€)</strong> für die fortlaufende Optimierung. So weißt du immer auf den Cent genau, wo dein Geld hinfließt."
  },
  {
    question: "Warum verbrennt mein aktueller Google Ads Account so viel Geld?",
    answer: "Google baut immer mehr 'Automatik-Fallen' ein, die dein Budget wie ein Staubsauger fressen, wenn du nicht aufpasst. 'Broad Match' ohne scharfe Negativ-Listen ist oft Russisch Roulette mit deinem ROI. Ich schließe diese Lecks, deaktiviere unnötige Automatismen und richte den Fokus wieder auf die Klicks, die wirklich Umsatz bringen."
  },
  {
    question: "Machst du auch das Conversion Tracking?",
    answer: "Sauberes Tracking (Consent Mode v2, Server-Side) ist heute eine Wissenschaft für sich. Das überlasse ich den absoluten Spezialisten in meinem Freelancer-Netzwerk. Wir arbeiten Hand in Hand, damit deine Daten stimmen. Denn wer blind fliegt, stürzt in der 'Tracking-Hölle' ab."
  },
  {
    question: "Wie hängen SEO und SEA eigentlich zusammen?",
    answer: "Das sind zwei Seiten derselben Medaille. Wenn deine Landingpage aus SEO-Sicht eine 'Tragödie' ist, wird auch dein Google Ads Qualitätsfaktor sinken und die Klickpreise werden unverschämt teuer. Gute SEO-Struktur spart dir im SEA bares Geld. Gleichzeitig nutzen wir die Ads-Daten, um zu sehen, welche Keywords wirklich konvertieren – das ist die ultimative Abkürzung für deine SEO-Strategie."
  },
  {
    question: "Betreust du auch B2B Industrie und lokale Unternehmen?",
    answer: "Ja, absolut. Ich arbeite besonders gerne mit Industrie, B2B, Online Shops und Local Businesses. Die Anforderungen sind hier sehr unterschiedlich – von der Leadgenerierung für komplexe Maschinen bis hin zur lokalen Sichtbarkeit für den Handwerker um die Ecke. Das Grundprinzip ist stets: Präzises Targeting und Vermeidung von Streuverlusten."
  }
];

const offers = [
  {
    name: "Sprechstunde (400€)",
    description: "Ein kompakter Direkt-Check des bestehenden Ads Accounts auf Budgetfresser (400€ Pauschal)."
  },
  {
    name: "B2B & Online Shop SEA Setup",
    description: "Strukturierter Aufbau präziser Such- und Shopping-Kampagnen zur Conversion-Steigerung."
  },
  {
    name: "Local Ads Berlin",
    description: "Optimierung von bezahlten Suchkampagnen für lokale Suchanfragen, Leads und Geschäftsfelder in Berlin."
  },
  {
    name: "10-Stunden Paket (1.600€)",
    description: "Flexibles Leistungspaket für Audits, Setup und punktuelles Troubleshooting (1.600€ Pauschal)."
  },
  {
    name: "Monatlicher Retainer (ab 1.600€)",
    description: "Laufende Betreuung, Strategie und Optimierung für nachhaltiges Wachstum (ab 1.600€ monatlich)."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (200€/h)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout title={title} description={description} lcpImage={heroImage.src} ogImage={heroImage.src}>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12 pb-20 md:pb-32">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-3/5 z-10">
          <div class="flex flex-wrap items-center gap-x-4 mb-4">
            <p class="subheadline uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent inline-block px-4 py-1 rounded-full">
              Moin! 🌻 Ich bin Jörg.
            </p>
            {lastReviewed && (
              <span class="text-gray-muted text-xs font-normal italic border-l border-gray-200 pl-4">Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold text-dark mb-6 leading-normal">
            Dein <span class="highlight">Google Ads Freelancer</span>: Klare Kante statt Klick-Abzocke.
          </h1>
          <p class="text-lg md:text-xl text-gray-700 max-w-2xl mb-10 leading-relaxed">
            Genug von den Standard-Tipps des Google-Supports, die nur dein Budget fressen? Ich bin Jörg – seit über <strong>10 Jahren</strong> Google Partner. Ich schalte die Automatik-Fallen ab und hole dir die Kontrolle über dein Geld zurück. Direkt, ehrlich und absolut ROI-getrieben.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary text-center">
              Lass uns sprechen
            </a>
            <a href="#ansatz" class="btn-secondary text-center scroll-smooth">
              Warum ein Freelancer?
            </a>
          </div>
        </div>
        <div class="md:w-2/5">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - Google Ads & SEA Freelancer in Berlin Spandau"
            width={600}
            height={800}
            class="w-full h-auto rounded-3xl shadow-2xl border-4 border-white object-cover"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 1: Intro & Agentur vs Freelancer -->
  <section id="ansatz" class="section bg-gray-50 pt-24 pb-24">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-start">
        <div class="lg:w-2/3 prose prose-lg max-w-none text-gray-800">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-8 border-b-2 border-lime-accent pb-4 inline-block">Warum überhaupt ein Google Ads Freelancer für SEA?</h2>
          
          <p class="mb-6 leading-relaxed">
            Wahrscheinlich kennst du die Anrufe des "offiziellen" Google Ads Supports. Gut gemeinte Ratschläge, die am Ende meist nur eins bewirken: Dein Budget wird schneller aufgebraucht, weil du Automatisierungen aktivieren sollst, die dem Algorithmus mehr Freiheit geben, dein Geld in teure oder irrelevante Klicks umzuwandeln. Genau hier setze ich an.
          </p>

          <p class="mb-6 leading-relaxed">
            Im Gegensatz zu einer großen Agentur hast du mit mir als <strong>Google Ads Freelancer</strong> einen direkten Ansprechpartner. Keine Ticket-Systeme, kein Stille-Post-Spiel mit Account-Managern. Ich biete dir volle Flexibilität: Du brauchst nur eine einmalige Optimierung? Kein Problem. Du willst eine unabhängige zweite Meinung zu deinem aktuellen Setup? Sehr gerne.
          </p>
          
          <div class="my-10 bg-white p-6 rounded-2xl border-l-4 border-lime-500 shadow-sm">
            <p class="text-dark font-bold italic text-lg mb-2">💬 Jörgs Tacheles-Ecke</p>
            <p class="text-dark mb-0 italic">"Der Google Ads Support ist nicht dein Freund. Deren Aufgabe ist es, Googles Quartalszahlen zu retten, nicht deinen ROI. Wer blind allen Empfehlungen folgt, landet in der 'Tracking-Hölle' und verbrennt Geld im Minutentakt."</p>
          </div>

          <h3 class="text-2xl font-bold mt-16 mb-6">Automatisierung ist ein Werkzeug, kein Pilot</h3>
          <p class="mb-8 leading-relaxed">
            Smart Bidding, Broad Match, automatische Empfehlungen – Google drängt uns immer mehr in die Vollautomatik. Aber Vorsicht: Die KI 'weiß' nicht, ob deine Marge bei Produkt A höher ist als bei Produkt B. Als dein Freelancer bin ich nur <em>einer</em> Partei verpflichtet: Dir.
          </p>
          <p class="mb-8 leading-relaxed">
            Ich schalte die Automatik dort ab, wo sie deinem Business schadet, und setze auf chirurgisch präzises Targeting. Wir wollen keine Masse an Klicks, wir wollen Klicks von Menschen, die auch wirklich kaufen oder anfragen.
          </p>
          
          <div class="my-10 bg-dark p-8 rounded-3xl border-l-4 border-lime-500">
            <p class="text-white font-bold italic text-lg mb-0 text-center">"Am Ende des Tages ist Google Ads reines Handwerk. Wer die Hebel kennt, gewinnt den Markt. Wer sie ignoriert, zahlt Lehrgeld."</p>
          </div>
        </div>
        
        <!-- Sidebar mit persönlichem Bild -->
        <div class="lg:w-1/3">
          <div class="sticky top-32">
            <Image
              src={joergInterview}
              alt="Jörg Zimmer über Google Ads und Optimierung"
              width={600}
              height={800}
              class="w-full h-auto rounded-3xl shadow-xl border-4 border-white mb-6 object-cover aspect-[3/4]"
              format="webp"
            />
            <p class="text-sm text-center text-gray-muted italic px-4">Google Ads Experte, Jörg Zimmer, ehrlich, direkt und humorvoll.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Bewertungen -->
  <div class="py-12 bg-white border-t border-gray-100">
    <Testimonials />
  </div>

  <!-- Content Section 2: Die 4 Säulen meiner SEA-Beratung -->
  <section class="section bg-white pt-24 pb-24">
    <div class="container-narrow">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-12 text-center">Meine Methodik: Präzision und Kontrolle</h2>
      
      <p class="text-lg text-gray-700 text-center max-w-4xl mx-auto mb-16 leading-relaxed">
        Erfolgreiche SEA-Kampagnen für den Mittelstand basieren nicht auf blindem Vertrauen in die Google-Algorithmen, sondern auf sauberem Handwerk. Wir stoppen die unkontrollierten "Google-Subventionen" und geben dir die Kontrolle über dein Budget zurück.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Säule 1 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">1. Messerscharfes Targeting</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Die Standard-Einstellungen für "Broad Match" sind Googles Liebling, aber oft der pure "Pfusch am Bau" für dein Budget.
          </p>
          <ul class="space-y-3 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Match Types:</strong> Konsequente Nutzung von Exact und Phrase Match für spürbare Budget-Kontrolle.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Ausschlusslisten (Negative Keywords):</strong> Streuverluste stoppen, bevor sie entstehen, und wertlose Klicks blockieren.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Zielgruppenanalyse:</strong> Genau in den Momenten und Regionen bieten, in denen deine lukrativste Kundschaft sucht.</li>
          </ul>
        </div>

        <!-- Säule 2 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">2. B2B, Shops & Local</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Ein Online-Shop braucht völlig andere Setups (Shopping/PMax) als der Software-Dienstleister im B2B oder der Anwalt in Berlin-Mitte (Local Search).
          </p>
          <ul class="space-y-3 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>E-Commerce:</strong> ROAS-Optimierung für saubere Produkt-Feeds und performante Shopping-Kampagnen.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>LeadGen (B2B):</strong> Qualität vor Quantität. Wir wollen hochqualifizierte Leads, keine Trash-Anfragen.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Local Campaigns:</strong> Die lokale Sichtbarkeit direkt vor Ort mit standortbasiertem Bidding maximieren.</li>
          </ul>
        </div>

        <!-- Säule 3 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">3. Account Clean-Up (Einzelpakete)</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Nicht jeder braucht sofort einen teuren monatlichen Retainer. Oft reicht es, wenn ein Experte das Setup einmalig radikal neu aufstellt.
          </p>
          <ul class="space-y-3 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Struktur-Check:</strong> Wir beheben fehlerhafte Anzeigengruppen, Keyword-Kannibalisierung und falsche Gebote.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Zweite Meinung:</strong> Unabhängige Bewertung eures aktuellen Setups, falls das Vertrauen zur bisherigen Agentur kippt.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Einmalige Optimierung:</strong> Buchbar als klares Einzelpaket für sofortigen Impact ohne langfristige Knebelverträge.</li>
          </ul>
        </div>

        <!-- Säule 4 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">4. Das Freelancer Netzwerk</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Mein Versprechen: Ich mache nur das, worin ich wirklich tief drinstecke. Geht es um hochkomplexes Tracking oder gigantische Accounts, hole ich gezielt Experten dazu.
          </p>
          <ul class="space-y-3 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Profi-Tracking:</strong> Conversion-Tracking mache ich nicht selbst. Dafür nutze ich Tracking-Spezialisten im Team, die das Server-Side-Setup und den Consent Mode blind beherrschen.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Skalierbarkeit:</strong> Bei sehr großen Accounts ziehe ich vertraute Freelancer-Kollegen zur Unterstützung heran.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Ganzheitlich aber einfach:</strong> Du profitierst von Schwarmintelligenz, hast aber für den Bereich SEA trotzdem nur einen direkten Ansprechpartner – mich.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 3: Die Google Ads Sprechstunde -->
  <section class="section bg-dark text-white pt-24 pb-24 relative overflow-hidden">
    <!-- Decorative element -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-lime-accent rounded-full opacity-5 blur-[120px] pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
    
    <div class="container-narrow position-relative z-10">
      <div class="prose prose-lg prose-invert max-w-none">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
          <div class="lg:col-span-7">
            <h2 class="text-3xl md:text-5xl font-bold mb-6 !text-white !border-lime-accent !pb-4">Der Quick-Win: Die Google Ads Sprechstunde</h2>
            <p class="leading-relaxed text-gray-300">
              Du hast das Gefühl, deine Kampagnen in Google Ads performen nicht optimal, weißt aber nicht genau, woran es liegt? Genau wie bei meiner etablierten SEO-Sprechstunde biete ich dir auch einen unkomplizierten <strong>Google Ads Account Check</strong> an.
            </p>
            <p class="leading-relaxed text-gray-300 mt-6">
              Wir loggen uns gemeinsam live in deinen Account ein. Ich zeige dir ungeschönt direkt am Bildschirm, wo Budget verbrannt wird, welche "Empfehlungen" Googles Aktienkurs mehr helfen als deinem Umsatz und was die dringendsten Hebel für echte Performance sind. Das alles in einem kompakten Call für einen Pauschalpreis von <strong>400,- Euro</strong> (zzgl. MwSt.). Kein Risiko, keine versteckten Folgekosten, nur sofortiger Erkenntnisgewinn.
            </p>
            <div class="mt-8">
              <a href={`${baseUrl}/kontakt/`} class="btn-primary inline-block text-dark font-bold hover:scale-105 transition-transform duration-300 ease-in-out">Ads Sprechstunde anfragen</a>
            </div>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-10">
            <Image
              src={joergPodcast}
              alt="Jörg Zimmer über SEA, Google KI-Modus und Google Ads"
              width={800}
              height={500}
              class="rounded-3xl shadow-xl w-full h-[350px] object-cover object-top border-4 border-gray-800"
              format="webp"
              loading="lazy"
            />
            <Image
              src={ContextualImage}
              alt="Die perfekten Synergien zwischen SEO und SEA"
              width={800}
