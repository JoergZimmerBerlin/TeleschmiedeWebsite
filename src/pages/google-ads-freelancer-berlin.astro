        "https://www.threads.com/@joerg.zimmer.berlin"
      ],
      "knowsAbout": ["Google Ads", "SEA", "PMax", "Search Engine Marketing", "E-Commerce SEA", "Local Ads", "B2B SEA", "Conversion Tracking"]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://teleschmie.de/google-ads-freelancer-berlin/#freelancer",
      "name": "Jörg Zimmer - Google Ads Freelancer Berlin",
      "description": "Google Ads Beratung, Kampagnen-Setup, SEA Optimierung für B2B und Online Shops in Berlin und DACH.",
      "image": `https://teleschmie.de${heroImageWebp.src}`,
      "url": "https://teleschmie.de/google-ads-freelancer-berlin/",
      "telephone": "+493049208184", 
      "email": "info@teleschmie.de",
      "priceRange": "€€€",
      "founder": {
