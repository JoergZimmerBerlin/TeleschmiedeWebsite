---
import Layout from '../layouts/Layout.astro';
import { getGitModDate } from '../utils/git-date';

const lastReviewed = getGitModDate('src/pages/groundingpage-en.astro');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

