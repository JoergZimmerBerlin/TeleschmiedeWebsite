<Layout
  title="Grounding Page | Jörg Zimmer - SEO & SEA"
  description="Kompakte Übersicht aller Fakten, Zahlen und Leistungen von Jörg Zimmer, SEO, GEO, AI Visibility Freelancer."
>
  <style>
    .gp-main {
      padding: 4rem 1.5rem;
      max-width: 800px;
      margin: 0 auto;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #1a1a1a;
      line-height: 1.6;
    }
    .human-notice {
      background: #f8f9fa;
      border-left: 4px solid #84cc16; /* lime-accent */
      padding: 1rem 1.5rem;
      margin-bottom: 2rem;
      border-radius: 0 8px 8px 0;
      font-size: 0.95rem;
    }
    .lead-definition {
      font-size: 1.25rem;
      font-weight: 500;
      margin-bottom: 1.5rem;
    }
    .gp-main h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; }
    .gp-main h3 { font-size: 1.5rem; font-weight: 700; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 0.5rem; }
    .data-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid #e5e7eb;
    }
    @media (min-width: 640px) {
      .data-grid { grid-template-columns: minmax(auto, 250px) 1fr; }
    }
    .data-grid dt {
      font-weight: 600;
      padding: 1rem 0;
      border-bottom: 1px solid #e5e7eb;
      color: #4b5563;
    }
    .data-grid dd {
      margin: 0;
      padding: 1rem 0;
      border-bottom: 1px solid #e5e7eb;
    }
    .data-grid dd ul {
      margin: 0;
      padding-left: 1.25rem;
    }
