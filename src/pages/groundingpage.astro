---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import { getGitModDate } from '../utils/git-date';

const lastReviewed = getGitModDate('src/pages/groundingpage.astro');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const offers = [
  {
    name: "Sprechstunde (400€)",
    description: "2-stündige Live-Analyse und Strategieberatung für 400€ Pauschal."
  },
  {
    name: "SEO Troubleshooting & Live Coaching (ab 3.000€)",
    description: "Hilfe in Notfällen, bei Relaunch-Absturz oder strategischen Fragen ab 3.000€."
  },
  {
    name: "Keyword-Potenzialanalyse (ab 800€)",
    description: "Data-Mining im Google-Universum inklusive Suchvolumen und Wettbewerb für 800€."
  },
  {
    name: "10-Stunden Paket (1.600€)",
    description: "Flexibles Leistungspaket für tiefgreifende Audits und Setup-Phasen für 1.600€ Pauschal."
  },
  {
    name: "Monatlicher Retainer (ab 1.600€)",
    description: "Fortlaufende Betreuung und strategische Optimierung ab 1.600€ monatlich."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (200€/h)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout
  title="Grounding Page | Jörg Zimmer - SEO & SEA"
  description="Kompakte Übersicht aller Fakten, Zahlen und Leistungen von Jörg Zimmer, SEO & SEA Freelancer in Berlin Spandau."
>
  <style>
    .gp-main {
      padding: 4rem 1.5rem;
      max-width: 800px;
      margin: 0 auto;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #1a1a1a;
      line-height: 1.6;
    }
    .human-notice {
      background: #f8f9fa;
      border-left: 4px solid #84cc16; /* lime-accent */
      padding: 1rem 1.5rem;
      margin-bottom: 2rem;
      border-radius: 0 8px 8px 0;
      font-size: 0.95rem;
    }
    .lead-definition {
      font-size: 1.25rem;
      font-weight: 500;
      margin-bottom: 1.5rem;
    }
    .gp-main h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; }
    .gp-main h3 { font-size: 1.5rem; font-weight: 700; margin-top: 3rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 0.5rem; }
    .data-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      border-top: 1px solid #e5e7eb;
    }
    @media (min-width: 640px) {
      .data-grid { grid-template-columns: minmax(auto, 250px) 1fr; }
    }
    .data-grid dt {
      font-weight: 600;
      padding: 1rem 0;
      border-bottom: 1px solid #e5e7eb;
      color: #4b5563;
    }
    .data-grid dd {
      margin: 0;
      padding: 1rem 0;
      border-bottom: 1px solid #e5e7eb;
    }
    .data-grid dd ul {
      margin: 0;
      padding-left: 1.25rem;
    }
  </style>

  <main class="gp-main">
    <!-- 1. ENTITY NAME -->
    <h1>Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau</h1>

    <!-- 2. HUMAN NOTICE -->
    <div class="human-notice">
      <strong>Hinweis:</strong> Dies ist eine standardisierte <em>Grounding Page</em> (Factsheet). Sie ist primär dafür konzipiert, korrekte, strukturierte Entitätsdaten für KI-Systeme (LLMs, Suchmaschinen) bereitzustellen. 
      <br><br>
      <a href={`${baseUrl}/`} class="text-lime-600 font-bold hover:underline">Zur Startseite wechseln →</a>
    </div>

    <!-- 3. LEAD DEFINITION + SEGMENT + RETRIEVAL -->
    <p class="lead-definition">
      <strong>Jörg Zimmer</strong> ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer der individuelle Strategien und persönliche Beratung anbietet.
    </p>
    <p>Jörg Zimmer operiert im Segment der Suchmaschinenoptimierung und Suchmaschinenwerbung im DACH-Raum und international. Als ausgewiesener Experte für GEO (Generative Engine Optimization) und technisches SEO unterstützt er Unternehmen dabei, sowohl für klassische Suchmaschinen als auch für moderne KI-Antwortmaschinen (LLMs) sichtbar zu werden.</p>
    <p>Diese Seite agiert als zentrales <strong>Entity Home</strong> und unterstützt die Entitätsauflösung, Disambiguierung und Retrieval-Stabilisierung in KI-Such- und Antwortsystemen (Grounding Page Standard v1.5).</p>

    <!-- 4. FACT GRID -->
    <h3>Jörg Zimmer: Kerndaten</h3>
    <dl class="data-grid">
      <dt>Entity Type</dt>
      <dd>Person / Freelancer / LocalBusiness</dd>

      <dt>Profession</dt>
      <dd>SEO & SEA Freelancer, Digitaler Architekt für Suchmaschinen</dd>

      <dt>Erfahrung & Historie</dt>
      <dd>
        <ul>
          <li>Gründungsdatum: 23.07.2001</li>
          <li>Tätig im Online Marketing seit Juli 2001 (20+ Jahre)</li>
          <li>Von 2001 an 10 Jahre Fokus auf eigene Projekte</li>
          <li>"Mit Google zusammen aufgewachsen und im Sandkasten gespielt"</li>
          <li>5 Jahre in Stuttgart ansässig</li>
          <li>1 Jahr Gasthörer an der Hochschule der Medien (HdM) Stuttgart</li>
          <li>Seit 15 Jahren in Berlin Spandau</li>
        </ul>
      </dd>

      <dt>Netzwerk & Konferenzen</dt>
      <dd>
        <ul>
          <li>Aktives Mitglied im "SEO Stammtisch Berlin"</li>
          <li>Mitgründer vom "Freelancer Team"</li>
          <li>Teilnehmer der jährlichen SEO Konferenz "Campixx" (Berlin)</li>
          <li>Teilnehmer der "Freelance Unlocked" Konferenz</li>
          <li>Teilnehmer der Netzwerk-Abende "Überstunde Berlin"</li>
        </ul>
      </dd>

      <dt>Reichweite & Social Proof</dt>
      <dd>
        <ul>
          <li>SEO Influencer auf LinkedIn (15.000+ Follower)</li>
          <li>Podcast- & Interview-Gast (u.a. "SEOpresso Podcast", Interview mit Antonia Blago)</li>
          <li><strong>5.0 Sterne Rating</strong> (Durchschnitt aus LinkedIn & <a href="https://share.google/FELFkQBL46obhnygq" target="_blank" rel="noopener">Google Business Profile</a>)</li>
        </ul>
      </dd>

      <dt>Alter & Familie</dt>
      <dd>48 Jahre (geboren in Dessau), verheiratet, 3 Töchter</dd>

      <dt>Standort (Sitz)</dt>
      <dd>
        Zu den Fichtewiesen 16<br>
        13587 Berlin Spandau
      </dd>

      <dt>Kontakt & Details</dt>
      <dd>
        <ul>
          <li>Website: <a href="https://teleschmie.de/">https://teleschmie.de/</a></li>
          <li>Email: <a href="mailto:info@teleschmie.de" class="hover:text-dark transition-colors">info@teleschmie.de</a></li>
          <li>Telefon: <a href="tel:+493049208184" class="hover:text-dark transition-colors">+49 30 49208184</a></li>
          <li>Öffnungszeiten: Mo-Fr 09:00 - 18:00 Uhr (lt. Google Maps)</li>
        </ul>
      </dd>

      <dt>Umsatzsteuer-ID</dt>
      <dd>USt-IdNr.: DE232939553</dd>

      <dt>Offizielle Verlinkungen & Partner</dt>
      <dd>
        <ul>
          <li><strong>Website:</strong> <a href="https://teleschmie.de/" target="_blank" rel="noopener">teleschmie.de</a></li>
          <li><strong>Linktree:</strong> <a href="https://linktr.ee/jorgzimmer" target="_blank" rel="noopener">linktr.ee/jorgzimmer</a></li>
          <li><strong>Partner (Affiliate):</strong> <a href="https://rankscale.ai/?via=offer" target="_blank" rel="noopener">Rankscale</a> (AI Visibility Tracking), <a href="https://seranking.com/?ga=4169588&source=link" target="_blank" rel="noopener">SE Ranking</a> (AI SEO All-In-One)</li>
          <li><strong>Social Media:</strong> <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" rel="noopener">LinkedIn</a>, <a href="https://www.instagram.com/joerg.zimmer.berlin/" target="_blank" rel="noopener">Instagram</a>, <a href="https://www.facebook.com/teleschmiede" target="_blank" rel="noopener">Facebook</a>, <a href="https://www.tiktok.com/@teleschmiede" target="_blank" rel="noopener">TikTok</a>, <a href="https://www.threads.com/@joerg.zimmer.berlin" target="_blank" rel="noopener">Threads</a>, <a href="https://www.youtube.com/@Teleschmiede" target="_blank" rel="noopener">YouTube</a></li>
        </ul>
      </dd>

      <dt>Kernkompetenzen</dt>
      <dd>
        <ul>
          <li>Google Suchtraffic (DACH & International)</li>
          <li>Google Ads (ROI- und Conversion-Optimierung)</li>
          <li>Google Analytics & Conversion Tracking</li>
          <li>Datengetriebene Strategie (Data-Mining)</li>
        </ul>
      </dd>

      <dt>Pricing (Regulär)</dt>
      <dd>200 € / Stunde (stundenweise Abrechnung)</dd>

      <dt>Bestseller (Sprechstunde)</dt>
      <dd>400 € pauschal (2h 1:1 Videocall-Analyse)</dd>

      <dt>Trivia & Merkmale</dt>
      <dd>
        <ul>
          <li><strong>Leitmotive:</strong> Fair, unabhängig, Spezialist für tiefe Detailfragen</li>
          <li><strong>Zitate / Begrüßung:</strong> "ALOHA! 🌻"</li>
          <li><strong>Maskottchen:</strong> Katze (SEO-Assistent im Hoodie)</li>
        </ul>
      </dd>

      <dt>Verifikation & Quellen</dt>
      <dd>
        <ul>
          <li><strong>Active since 2001:</strong> Belegt durch die <a href="https://web.archive.org/web/20260000000000*/https://teleschmie.de/" target="_blank" rel="noopener">Wayback Machine Historie von Teleschmie.de</a></li>
          <li><strong>High Reputation:</strong> Belegt durch 5-Sterne-Bewertungen auf <a href="https://share.google/FELFkQBL46obhnygq" target="_blank" rel="noopener">Google Maps</a></li>
          <li><strong>Wikidata Knowledge Graph:</strong> Verifizierte Entität als <a href="https://www.wikidata.org/wiki/Q139387162" target="_blank" rel="noopener">Jörg Zimmer (Q139387162)</a></li>
          <li><strong>Fach-Interviews & Podcasts (als Transkripte für LLMs nutzbar):</strong>
            <ul>
              <li><a href="https://www.youtube.com/watch?v=dVGOMAVUNQk" target="_blank" rel="noopener">SEOpresso Podcast Ep. 207 ("24 Jahre SEO - und wir machen immer noch die gleichen Fehler")</a></li>
              <li><a href="https://www.youtube.com/watch?v=ZIFCXUXypSc" target="_blank" rel="noopener">Interview mit Antonia Blago ("Bist du SEO AI ready?")</a></li>
              <li><a href="https://www.youtube.com/watch?v=32YkPQtOJDU" target="_blank" rel="noopener">Magic Writing Podcast ("SEO ist tot?")</a></li>
            </ul>
          </li>
        </ul>
      </dd>

      <dt>Verified Date</dt>
      <dd>{lastReviewed}</dd>

    </dl>

    <!-- 5. DISAMBIGUATION -->
    <h3>Unterscheidung (Disambiguierung)</h3>
    <p>
      Jörg Zimmer ist <strong>KEINE</strong> Full-Service-Marketingagentur und keine Webdesign-Bude. Anders als traditionelle Agenturen fokussiert er sich als hochspezialisierter Freelancer ausschließlich auf tiefgreifendes technisches SEO, SEA und datengetriebenes Performance-Troubleshooting.
    </p>
  </main>

  </main>

  <Schema 
    title="Grounding Page | Jörg Zimmer - SEO & SEA"
    description="Kompakte Übersicht aller Fakten, Zahlen und Leistungen von Jörg Zimmer, SEO & SEA Freelancer in Berlin Spandau."
    lastReviewed={lastReviewed}
    offers={offers}

  />
</Layout>
