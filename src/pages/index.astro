---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Stats from '../components/Stats.astro';
import Expertise from '../components/Expertise.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/pages/hero-pose.webp';
import { getGitModDate } from '../utils/git-date';
import Schema from '../components/Schema.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/index.astro');

const offers = [
  {
    name: "Sprechstunde (400€)",
    description: "2-stündige Live-Analyse und Strategieberatung für 400€ Pauschal."
  },
  {
    name: "SEO Troubleshooting & Live Coaching (ab 3.000€)",
    description: "Hilfe in Notfällen, bei Relaunch-Absturz oder strategischen Fragen ab 3.000€."
  },
  {
    name: "Keyword-Potenzialanalyse (ab 800€)",
    description: "Data-Mining im Google-Universum inklusive Suchvolumen und Wettbewerb für 800€."
  },
  {
    name: "10-Stunden Paket (1.600€)",
    description: "Flexibles Leistungspaket für tiefgreifende Audits und Setup-Phasen für 1.600€ Pauschal."
  },
  {
    name: "Monatlicher Retainer (ab 1.600€)",
    description: "Fortlaufende Betreuung und strategische Optimierung ab 1.600€ monatlich."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (200€/h)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout 
  title="Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau" 
  description="Jörg Zimmer: Dein SEO & SEA Freelancer in Berlin. Über 20 Jahre Erfahrung, ehrlich & direkt. Mehr Sichtbarkeit & ROI für dein Business. ALOHA! 🌻"
  lcpImage={heroImage.src}
  maxTitleLength={65}
>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12 pb-20 md:pb-32">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau</p>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            Ich bringe dein <span class="highlight">Google-Ranking</span>
            auf den Punkt.
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            Über 20 Jahre Erfahrung in der SEO-Praxis.
            Ich übernehme für dich das komplette <strong>technische, inhaltliche und strategische SEO</strong>, sowie Google Ads (SEA).
          </p>

          <div class="flex flex-col sm:flex-row gap-4 flex-wrap">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary">
              Jetzt Kontakt aufnehmen
            </a>
            <a href={`${baseUrl}/seo-freelancer-berlin/`} class="btn-secondary">
              Dein SEO Experte
            </a>
            <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="btn-secondary">
              Dein Google Ads Experte
            </a>
            <a href={`${baseUrl}/leistungen/`} class="btn-secondary bg-gray-100 hover:bg-gray-200 border-none text-dark">
              Alle Leistungen
            </a>
          </div>
        </div>
        <div class="md:w-1/3">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau"
            width={552}
            height={896}
            class="w-full h-auto rounded-2xl shadow-lg"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Aktuell</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-8">
        Was ist dran an <span class="highlight">AI SEO</span>?
      </h2>
      <YouTubeFacade
        videoId="dVGOMAVUNQk"
        title="Was ist dran an AI SEO oder GEO? Mit SEO Experten Jörg Zimmer"
      />
      <p class="text-sm text-gray-muted mt-4 text-center">
        GEO, AIO, AI-SEO... und warum ihr bitte NICHT den Praktikanten dransetzen solltet.
      </p>
    </div>
   <Stats />
  <Expertise />
  <Testimonials />
  <CTASection />
</Layout>
<Schema 
  title="Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau"
  description="Individuelle SEO & SEA Beratung mit über 20 Jahren Erfahrung. Spezialist für technisches SEO, Relaunch-Begleitung und Google Ads Optimierung."
  lastReviewed={lastReviewed}
  offers={offers}
/>
