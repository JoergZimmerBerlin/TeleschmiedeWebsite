---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Stats from '../components/Stats.astro';
import Expertise from '../components/Expertise.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/blog/linkedin-forum-original.webp';
import ytThumbnail from '../assets/images/youtube/dVGOMAVUNQk.jpg';
import { getGitModDate } from '../utils/git-date';
import Schema from '../components/Schema.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/index.astro');

const offers = [
  {
    name: "Sprechstunde (480€)",
    description: "2-stündige Live-Analyse und Strategieberatung für 480€ Pauschal."
  },
  {
    name: "SEO Troubleshooting & Live Coaching (ab 3.600€)",
    description: "Hilfe in Notfällen, bei Relaunch-Absturz oder strategischen Fragen ab 3.600€."
  },
  {
    name: "Keyword-Potenzialanalyse (ab 960€)",
    description: "Data-Mining im Google-Universum inklusive Suchvolumen und Wettbewerb für 960€."
  },
  {
    name: "10-Stunden Paket (1.920€)",
    description: "Flexibles Leistungspaket für tiefgreifende Audits und Setup-Phasen für 1.920€ Pauschal."
  },
  {
    name: "Monatlicher Retainer (ab 1.920€)",
    description: "Fortlaufende Betreuung und strategische Optimierung ab 1.920€ monatlich."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (nach Aufwand)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout 
  title="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer (2026)" 
  description="Jörg Zimmer: Dein SEO & AI Visibility Freelancer in Berlin. Über 25 Jahre Erfahrung. Mehr Sichtbarkeit und nachhaltiger ROI. (2026)"
  lcpImage={heroImage.src}
  ogImage={heroImage.src}
  maxTitleLength={65}
>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12 pb-20 md:pb-32">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">Jörg Zimmer - SEO, GEO, AI Visibility Freelancer</p>


          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            Ich bringe deine <span class="highlight">Sichtbarkeit</span>
            auf den Punkt.
          </h1>


          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            Über 25 Jahre Erfahrung in der SEO-Praxis.
            Ich übernehme für dich das komplette <strong>technische, inhaltliche und strategische SEO</strong>, sowie Google Ads (SEA).
          </p>

          <div class="flex flex-col sm:flex-row gap-4 flex-wrap">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary" title="Jetzt Kontakt aufnehmen (2026)">
              Jetzt Kontakt aufnehmen
            </a>
            <a href={`${baseUrl}/seo-freelancer-berlin/`} class="btn-secondary" title="Dein SEO Experte (2026)">
              Dein SEO Experte
            </a>
            <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="btn-secondary" title="Dein Google Ads Experte (2026)">
              Dein Google Ads Experte
            </a>
            <a href={`${baseUrl}/leistungen/`} class="btn-secondary bg-gray-100 hover:bg-gray-200 border-none text-dark" title="Alle Leistungen (2026)">
              Alle Leistungen
            </a>
          </div>
        </div>
        <div class="md:w-1/3">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer"
            title="Jörg Zimmer - Dein SEO Experte"
            width={552}
            height={896}
            class="w-full h-auto rounded-2xl shadow-lg object-cover object-top"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Aktuell</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-8">
        Was ist dran an <span class="highlight">AI SEO</span>?
      </h2>
      <YouTubeFacade
        videoId="dVGOMAVUNQk"
        title="Was ist dran an AI SEO oder GEO?"
        thumbnail={ytThumbnail}
      />
      <p class="text-sm text-gray-muted mt-4 text-center">
        GEO, AIO, AI-SEO... und warum ihr bitte NICHT den Praktikanten dransetzen solltet.
      </p>
    </div>
   <Stats />
  <Expertise />
  <Testimonials />
  <CTASection />
</Layout>
<Schema 
  title="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer (2026)"
  description="Individuelle SEO, GEO, AI Visibility Beratung mit über 25 Jahren Erfahrung. Spezialist für technisches SEO, Relaunch-Begleitung und Google Ads Optimierung. (2026)"
  lastReviewed={lastReviewed}
  offers={offers}
/>
