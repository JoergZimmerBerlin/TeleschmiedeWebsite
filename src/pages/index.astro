---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Stats from '../components/Stats.astro';
import Expertise from '../components/Expertise.astro';
import Testimonials from '../components/Testimonials.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/blog/linkedin-forum-original.webp';
import ytThumbnail from '../assets/images/youtube/dVGOMAVUNQk.jpg';
import { getGitModDate } from '../utils/git-date';
import Schema from '../components/Schema.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/index.astro');

const offers = [
  {
    name: "Sprechstunde (480€)",
    description: "2-stündige Live-Analyse und Strategieberatung für 480€ Pauschal."
  },
  {
    name: "SEO Troubleshooting & Live Coaching (ab 3.600€)",
    description: "Hilfe in Notfällen, bei Relaunch-Absturz oder strategischen Fragen ab 3.600€."
  },
  {
    name: "Keyword-Potenzialanalyse (ab 960€)",
    description: "Data-Mining im Google-Universum inklusive Suchvolumen und Wettbewerb für 960€."
  },
  {
    name: "10-Stunden Paket (1.920€)",
    description: "Flexibles Leistungspaket für tiefgreifende Audits und Setup-Phasen für 1.920€ Pauschal."
  },
  {
    name: "Monatlicher Retainer (ab 1.920€)",
    description: "Fortlaufende Betreuung und strategische Optimierung ab 1.920€ monatlich."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (nach Aufwand)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout 
  title="Jörg Zimmer: SEO, SEA & AI Visibility Freelancer Berlin (2026)" 
  description="Jörg Zimmer: Dein SEO, SEA & AI Visibility Freelancer in Berlin. 25 Jahre Erfahrung für Top-Rankings, Google Ads & nachhaltigen ROI. (2026)"
  lcpImage={heroImage.src}
  maxTitleLength={65}
>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12 pb-20 md:pb-32">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">Jörg Zimmer - SEO, GEO, AI Visibility Freelancer</p>


          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            Ich bringe deine <span class="highlight">Sichtbarkeit</span>
            auf den Punkt.
          </h1>


          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            Über 25 Jahre Erfahrung in der SEO-Praxis.
            Ich übernehme für dich das komplette <strong>technische, inhaltliche und strategische SEO</strong>, sowie Google Ads (SEA).
          </p>

          <div class="flex flex-col sm:flex-row gap-4 flex-wrap">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary" title="Jetzt Kontakt aufnehmen (2026)">
              Jetzt Kontakt aufnehmen
            </a>
            <a href={`${baseUrl}/seo-freelancer-berlin/`} class="btn-secondary" title="Dein SEO Experte (2026)">
              Dein SEO Experte
            </a>
            <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="btn-secondary" title="Dein Google Ads Experte (2026)">
              Dein Google Ads Experte
            </a>
            <a href={`${baseUrl}/leistungen/`} class="btn-secondary bg-gray-100 hover:bg-gray-200 border-none text-dark" title="Alle Leistungen (2026)">
              Alle Leistungen
            </a>
          </div>
        </div>
        <div class="md:w-1/3">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer"
            title="Jörg Zimmer - Dein SEO Experte"
            width={552}
            height={896}
            class="w-full h-auto rounded-2xl shadow-lg object-cover object-top"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Aktuell</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-8">
        Was ist dran an <span class="highlight">AI SEO</span>?
      </h2>
      <YouTubeFacade
        videoId="dVGOMAVUNQk"
        title="Was ist dran an AI SEO oder GEO?"
        thumbnail={ytThumbnail}
      />
      <p class="text-sm text-gray-muted mt-4 text-center">
        GEO, AIO, AI-SEO... und warum ihr bitte NICHT den Praktikanten dransetzen solltet.
      </p>
    </div>
  </section>

  <!-- Tools Showcase Section -->
  <section class="section bg-white border-t border-gray-100">
    <div class="container-narrow">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="subheadline mb-3">Interaktive Werkzeuge</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          Kostenlose Entwickler- &amp; <span class="highlight">Entity-Tools</span>
        </h2>
        <p class="text-gray-muted text-base md:text-lg">
          Praxiserprobte Spezialwerkzeuge für semantisches SEO, Knowledge Graphs und KI-Sichtbarkeit – direkt im Browser ohne Registrierung nutzbar.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        
        <!-- Tool 1: Schema Graph Visualizer -->
        <div class="bg-gray-50 hover:bg-gray-100/80 rounded-3xl p-6 md:p-8 border border-gray-200 transition-all flex flex-col justify-between group shadow-sm hover:shadow-md">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-2xl">🌐</span>
              <span class="px-2.5 py-1 rounded-full bg-lime-100 text-lime-800 text-xs font-bold">
                Live-Scanner
              </span>
            </div>
            <h3 class="text-xl font-bold text-dark mb-2 group-hover:text-lime-700 transition-colors">
              Schema-Graph-Visualizer
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              Visualisiere deinen Schema.org Knowledge Graph in Echtzeit: Entlarve isolierte Dateninseln, prüfe den 3-Ebenen Entity Health Score und vergleiche Ist- mit Soll-Zustand.
            </p>
          </div>
          <a href={`${baseUrl}/tools/schema-graph-visualizer/`} class="btn-primary text-center justify-center text-sm w-full" title="Schema Graph Visualizer">
            <span>Domain live prüfen</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Tool 2: Entitäten Graph Generator -->
        <div class="bg-gray-50 hover:bg-gray-100/80 rounded-3xl p-6 md:p-8 border border-gray-200 transition-all flex flex-col justify-between group shadow-sm hover:shadow-md">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-2xl">⚡</span>
              <span class="px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-xs font-bold">
                JSON-LD Graph
              </span>
            </div>
            <h3 class="text-xl font-bold text-dark mb-2 group-hover:text-lime-700 transition-colors">
              Entitäten Graph Generator
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              Erzeuge monolithischen Schema.org JSON-LD Code nach modernsten Ontologie-Standards – mit Wikidata sameAs Verankerung und Person-Organization-Relationen.
            </p>
          </div>
          <a href={`${baseUrl}/tools/entitaeten-graph-generator/`} class="btn-secondary text-center justify-center text-sm w-full bg-white hover:bg-dark hover:text-white" title="Entitäten Graph Generator">
            <span>Graph-Code erstellen</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Tool 3: Grounding Page Generator -->
        <div class="bg-gray-50 hover:bg-gray-100/80 rounded-3xl p-6 md:p-8 border border-gray-200 transition-all flex flex-col justify-between group shadow-sm hover:shadow-md">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-2xl">🤖</span>
              <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold">
                AI &amp; GEO Prompt
              </span>
            </div>
            <h3 class="text-xl font-bold text-dark mb-2 group-hover:text-lime-700 transition-colors">
              Grounding Page Generator
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-6">
              Erstelle mit einem Klick den perfekten System-Prompt für ChatGPT, Claude und Cursor für eine vollständige Grounding Page als zentrale Source of Truth.
            </p>
          </div>
          <a href={`${baseUrl}/tools/groundingpage-generator/`} class="btn-secondary text-center justify-center text-sm w-full bg-white hover:bg-dark hover:text-white" title="Grounding Page Generator">
            <span>Prompt generieren</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>

      <div class="text-center">
        <a href={`${baseUrl}/tools/`} class="inline-flex items-center gap-2 text-sm font-bold text-dark hover:text-lime-600 transition-colors">
          <span>Alle kostenlosen SEO &amp; AI Tools ansehen</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <Stats />
  <Expertise />
  <Testimonials />
  <CTASection />
</Layout>
<Schema 
  title="Jörg Zimmer - SEO, GEO, AI Visibility Freelancer (2026)"
  description="Individuelle SEO, GEO, AI Visibility Beratung mit über 25 Jahren Erfahrung. Spezialist für technisches SEO, Relaunch-Begleitung und Google Ads Optimierung. (2026)"
  lastReviewed={lastReviewed}
  offers={offers}
/>
