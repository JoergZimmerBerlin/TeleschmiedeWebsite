---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Stats from '../components/Stats.astro';
import Expertise from '../components/Expertise.astro';
import CTASection from '../components/CTASection.astro';
import heroImage from '../assets/images/pages/hero-pose.jpg';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Jörg Zimmer | SEO & SEA Freelancer Berlin" description="Jörg Zimmer ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer der individuelle Strategien und persönliche Beratung anbietet.">
  <!-- Hero Section -->
  <section class="section">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">SEO & SEA Freelancer Berlin Spandau</p>

          <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-loose mb-8">
            Ich bringe dein
            <span class="highlight">Google-Ranking</span>
            auf den Punkt.
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            20+ Jahre Erfahrung in SEO, Google Ads und datengetriebener Strategie.
            Als Spezialist für tiefe Detailfragen ruft man mich, wenn andere keine Lösung finden.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 flex-wrap">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary">
              Jetzt Kontakt aufnehmen
            </a>
            <a href={`${baseUrl}/seo-freelancer-berlin/`} class="btn-secondary">
              Dein SEO Experte
            </a>
            <a href={`${baseUrl}/sea-freelancer-berlin/`} class="btn-secondary">
              Dein SEA Experte
            </a>
            <a href={`${baseUrl}/leistungen/`} class="btn-secondary bg-gray-100 hover:bg-gray-200 border-none text-dark">
              Alle Leistungen
            </a>
          </div>
        </div>
        <div class="md:w-1/3 hidden md:block">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer aus Berlin Spandau"
            width={552}
            height={896}
            class="w-full h-auto rounded-2xl shadow-lg"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Aktuell</p>
      <h2 class="text-2xl md:text-3xl font-bold mb-8">
        Was ist dran an <span class="highlight">AI SEO</span>?
      </h2>
      <YouTubeFacade
        videoId="dVGOMAVUNQk"
        title="Was ist dran an AI SEO oder GEO? Mit SEO Experten Jörg Zimmer"
      />
      <p class="text-sm text-gray-muted mt-4 text-center">
        GEO, AIO, AI-SEO... und warum ihr bitte NICHT den Praktikanten dransetzen solltet.
      </p>
    </div>
  </section>

  <Stats />
  <Expertise />
  <CTASection />
</Layout>
