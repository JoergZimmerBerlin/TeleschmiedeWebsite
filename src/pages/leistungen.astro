---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import leistungenHero from '../assets/images/pages/leistungen-hero.jpg';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Leistungen | Jörg Zimmer - SEO & SEA Freelancer"
  description="SEO-Checks, Keyword-Analysen, Google Ads Management und strategische Beratung. Entdecke meine Leistungen als SEO-Freelancer in Berlin Spandau."
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">Leistungen</p>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8">
            Von der Analyse zur
            <span class="highlight">Umsetzung.</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl">
            Mein Stundensatz liegt bei 200€. Dafür bekommst du alles, was ich in
            über 20 Jahren gelernt habe.
          </p>
        </div>
        <div class="md:w-1/3">
          <Image
            src={leistungenHero}
            alt="Jörg Zimmer präsentiert SEO-Strategie - Freelancer für Suchmaschinenoptimierung Berlin"
            width={800}
            height={800}
            class="w-full h-auto rounded-2xl shadow-lg"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="pb-20">
    <div class="container-narrow">
      <div class="space-y-8">
        <!-- SEO Check -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO-Check</h2>
              <p class="text-gray-muted mb-4">
                Umfassende Analyse deiner Website: Technisches SEO, Content-Qualität,
                Backlink-Profil und Wettbewerbsanalyse. Du bekommst einen klaren
                Maßnahmenplan mit priorisierten Empfehlungen.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Technische Website-Analyse
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Content-Bewertung
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Wettbewerbsvergleich
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Priorisierter Maßnahmenplan
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Ab</p>
              <p class="text-3xl font-bold text-dark">400€</p>
            </div>
          </div>
        </div>

        <!-- Keyword-Analyse -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Keyword-Potenzialanalyse</h2>
              <p class="text-gray-muted mb-4">
                Data-Mining im Google-Universum: Ich finde die Keywords, die für
                dein Business wirklich relevant sind. Inklusive Suchvolumen,
                Wettbewerb und monetärem Potenzial.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Keyword-Recherche
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Suchvolumen-Analyse
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Wettbewerbsbewertung
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Monetäres Potenzial
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Ab</p>
              <p class="text-3xl font-bold text-dark">600€</p>
            </div>
          </div>
        </div>

        <!-- Google Ads -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Google Ads Management</h2>
              <p class="text-gray-muted mb-4">
                Performance-optimierte Kampagnen mit Fokus auf ROI. Von der
                Strategie über den Aufbau bis zur laufenden Optimierung.
                Transparent und ergebnisorientiert.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Kampagnen-Setup
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Anzeigentexte & Keywords
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Conversion-Tracking
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Laufende Optimierung
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Stundensatz</p>
              <p class="text-3xl font-bold text-dark">200€</p>
            </div>
          </div>
        </div>

        <!-- SEO Freelancer Check -->
        <a href={`${baseUrl}/seo-freelancer-berlin/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO Freelancer Berlin</h2>
              <p class="text-dark/70 mb-4">
                Keine Knebelverträge, nur ehrliche Arbeit auf Rechnung. 
                Als Freelancer übernehme ich das komplette Setup, Audits oder 
                auch das Retainer-Management für Shops und B2B.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Flexibles SEO-Management
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Technisches SEO & Audits
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> 100% Transparent
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Zum SEO Freelancer Profil
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>

        <!-- Google Ads Freelancer Check -->
        <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Google Ads Freelancer Berlin</h2>
              <p class="text-dark/70 mb-4">
                10+ Jahre exklusive Google Ads-Erfahrung. Ich drehe Budgetverschwendung ab 
                und fokussiere Kampagnen auf extrem relevantes B2B- & E-Commerce-Targeting.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Kampagnen Setup & Audit
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Eliminieren der "Broad Match Falle"
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Fokus auf ROI & Leads
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Zum Google Ads Freelancer Profil
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>

        <!-- Sprechstunde -->
        <a href={`${baseUrl}/seo-sprechstunde/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO-Sprechstunde</h2>
              <p class="text-dark/70 mb-4">
                2-stündiger Videocall für alle deine Fragen. Ich teile mein
                komplettes Wissen aus 20+ Jahren SEO-Erfahrung. Direkt, auf
                den Punkt, ohne Blabla.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> 2 Stunden 1:1 Videocall
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Alle Fragen erlaubt
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Sofort umsetzbare Tipps
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-dark">✓</span> Optional: Aufzeichnung
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Alle Details zur Sprechstunde
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
            <div class="text-right">
              <p class="text-sm text-dark/70">Pauschal</p>
              <p class="text-3xl font-bold text-dark">400€</p>
            </div>
          </div>
        </a>

        <!-- Zweite Meinung -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Zweite Meinung</h2>
              <p class="text-gray-muted mb-4">
                Unabhängige Einschätzung deiner bisherigen Agenturarbeit.
                Ich bin fair, respektiere jeden Stand und sage dir ehrlich,
                ob du auf dem richtigen Weg bist.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Unabhängige Bewertung
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Ehrliches Feedback
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Handlungsempfehlungen
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Stundensatz</p>
              <p class="text-3xl font-bold text-dark">200€</p>
            </div>
          </div>
        </div>

        <!-- Strategieberatung -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Strategieberatung</h2>
              <p class="text-gray-muted mb-4">
                Tiefgehende Strategie- und Unternehmensberatung aus Data-Mining
                des Google-Universums. Für Unternehmen, die das volle Potenzial
                ihrer Online-Präsenz ausschöpfen wollen.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Marktanalyse
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Zielgruppen-Strategie
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Langfristige Roadmap
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-lime-accent">✓</span> Coaching für Teams
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Auf Anfrage</p>
              <p class="text-xl font-bold text-dark">Individuell</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-dark text-white">
    <div class="container-narrow text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">
        Welche Leistung passt zu dir?
      </h2>
      <p class="text-gray-400 mb-8 max-w-xl mx-auto">
        Schreib mir eine Nachricht und wir finden gemeinsam heraus,
        wie ich dir am besten helfen kann.
      </p>
      <a href={`${baseUrl}/kontakt/`} class="btn-primary">
        Unverbindlich anfragen
      </a>
    </div>
  </section>
</Layout>
