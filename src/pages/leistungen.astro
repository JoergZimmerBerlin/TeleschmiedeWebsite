---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import leistungenHero from '../assets/images/pages/leistungen-hero.jpg';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Leistungen | Jörg Zimmer - SEO & SEA Freelancer"
  description="SEO-Checks, Keyword-Analysen, Google Ads Management und strategische Beratung. Entdecke meine Leistungen als SEO-Freelancer in Berlin Spandau."
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">Leistungen</p>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8">
            Von der Analyse zur
            <span class="highlight">Umsetzung.</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl">
            Mein Stundensatz liegt bei 200€. Dafür bekommst du alles, was ich in
            über 20 Jahren gelernt habe.
          </p>
        </div>
        <div class="md:w-1/3">
          <Image
            src={leistungenHero}
            alt="Jörg Zimmer präsentiert SEO-Strategie - Freelancer für Suchmaschinenoptimierung Berlin"
            width={800}
            height={800}
            class="w-full h-auto rounded-2xl shadow-lg"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="pb-20">
    <div class="container-narrow">
      <div class="space-y-8">
        <!-- SEO Check -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO-Check</h2>
              <p class="text-gray-muted mb-4">
                Umfassende Analyse deiner Website: Ich beleuchte dein Projekt ganzheitlich durch 
                <strong>technisches, inhaltliches und strategisches SEO</strong>. Du bekommst einen 
                klaren Maßnahmenplan mit priorisierten Empfehlungen.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Technisches SEO (Fundament)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Inhaltliches SEO (Content)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Strategisches SEO (Authority)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Priorisierter Maßnahmenplan
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Ab</p>
              <p class="text-3xl font-bold text-dark">400€</p>
            </div>
          </div>
        </div>

        <!-- Keyword-Analyse -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Keyword-Potenzialanalyse</h2>
              <p class="text-gray-muted mb-4">
                Data-Mining im Google-Universum: Ich finde die Keywords, die für
                dein Business wirklich relevant sind. Inklusive Suchvolumen,
                Wettbewerb und monetärem Potenzial.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Keyword-Recherche
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Suchvolumen-Analyse
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Wettbewerbsbewertung
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Monetäres Potenzial
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Ab</p>
              <p class="text-3xl font-bold text-dark">600€</p>
            </div>
          </div>
        </div>

        <!-- Google Ads -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Google Ads Management</h2>
              <p class="text-gray-muted mb-4">
                Performance-optimierte Kampagnen mit Fokus auf ROI. Von der
                Strategie über den Aufbau bis zur laufenden Optimierung.
                Transparent und ergebnisorientiert.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Kampagnen-Setup
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Anzeigentexte & Keywords
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Conversion-Tracking
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Laufende Optimierung
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Stundensatz</p>
              <p class="text-3xl font-bold text-dark">200€</p>
            </div>
          </div>
        </div>

        <!-- NEW: 10-Stunden Paket -->
        <div class="bg-gray-50 border-2 border-lime-accent rounded-2xl p-8 hover:shadow-xl transition-all relative overflow-hidden group">
          <div class="absolute top-0 right-0 bg-lime-accent text-dark font-bold px-4 py-1 rounded-bl-xl text-sm shadow-sm z-10">Beliebt</div>
          <div class="absolute -right-16 -top-16 w-32 h-32 bg-lime-accent/20 rounded-full blur-2xl group-hover:bg-lime-accent/30 transition-colors pointer-events-none"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 relative z-10">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="text-2xl font-bold">10-Stunden Paket</h2>
              </div>
              <p class="text-gray-700 mb-4">
                Das perfekte Paket für tiefe Audits, erste Setup-Phasen oder punktuelle Problemlösung (z.B. Penalty-Recovery). 
                Maximale Flexibilität: Du teilst mir die Aufgaben zu, ich arbeite sie transparent ab. Gilt für <strong>entweder SEO oder SEA</strong>.
              </p>
              <ul class="space-y-2 text-sm text-gray-700">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Freie Zeiteinteilung für SEO <strong>oder</strong> SEA
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Stundengenaues Reporting
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Keine Vertragslaufzeit
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Für Audits, Setups & Troubleshooting
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Pauschal</p>
              <p class="text-3xl font-bold text-dark">1.600€</p>
            </div>
          </div>
        </div>

        <!-- NEW: Monthly Retainer -->
        <div class="bg-dark text-white rounded-2xl p-8 hover:shadow-2xl transition-shadow relative overflow-hidden group border border-gray-800">
          <div class="absolute -bottom-20 -left-20 w-48 h-48 bg-lime-accent/10 rounded-full blur-3xl group-hover:bg-lime-accent/20 transition-colors pointer-events-none"></div>
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 relative z-10">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-8 h-8 text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <h2 class="text-2xl font-bold text-white">Monatlicher Retainer</h2>
              </div>
              <p class="text-gray-300 mb-4">
                Ideal für ambitionierte B2B-Unternehmen und Online-Shops, die kontinuierliches Wachstum suchen. 
                Laufende Überwachung, Content-Steuerung, Linkbuilding und strategische Beratung. Buchbar für <strong>SEO oder SEA</strong>.
              </p>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Kontinuierliche Optimierung (SEO <strong>oder</strong> SEA)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Regelmäßiges Reporting & Calls (Jour Fixe)
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Proaktive Strategieanpassungen
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Externe Sparringspartnerschaft fürs C-Level
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-400">Monatlich ab</p>
              <p class="text-3xl font-bold text-white">1.600€</p>
              <p class="text-sm text-gray-400 mt-1">oder beides für 3.200€</p>
            </div>
          </div>
        </div>

        <!-- SEO Freelancer Check -->
        <a href={`${baseUrl}/seo-freelancer-berlin/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO Freelancer Berlin</h2>
              <p class="text-dark/70 mb-4">
                Keine Knebelverträge, nur ehrliche Arbeit auf Rechnung. 
                Als Freelancer übernehme ich das komplette Setup, Audits oder 
                auch das Retainer-Management für Shops und B2B.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Flexibles SEO-Management
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Technisches SEO & Audits
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 100% Transparent
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Zum SEO Freelancer Profil
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>

        <!-- Google Ads Freelancer Check -->
        <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Google Ads Freelancer Berlin</h2>
              <p class="text-dark/70 mb-4">
                10+ Jahre exklusive Google Ads-Erfahrung. Ich drehe Budgetverschwendung ab 
                und fokussiere Kampagnen auf extrem relevantes B2B- & E-Commerce-Targeting.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Kampagnen Setup & Audit
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Eliminieren der "Broad Match Falle"
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Fokus auf ROI & Leads
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Zum Google Ads Freelancer Profil
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </div>
        </a>

        <!-- Sprechstunde -->
        <a href={`${baseUrl}/seo-sprechstunde/`} class="block bg-lime-accent rounded-2xl p-8 hover:brightness-95 transition-all">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">SEO-Sprechstunde</h2>
              <p class="text-dark/70 mb-4">
                2-stündiger Videocall für alle deine Fragen. Ich teile mein
                komplettes Wissen aus 20+ Jahren SEO-Erfahrung. Direkt, auf
                den Punkt, ohne Blabla.
              </p>
              <ul class="space-y-2 text-sm text-dark/70">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> 2 Stunden 1:1 Videocall
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Alle Fragen erlaubt
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Sofort umsetzbare Tipps
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-dark flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Optional: Aufzeichnung
                </li>
              </ul>
              <span class="inline-flex items-center gap-2 text-dark font-medium mt-4 underline underline-offset-4 decoration-dark/40 hover:decoration-dark transition-colors">
                Alle Details zur Sprechstunde
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
            <div class="text-right">
              <p class="text-sm text-dark/70">Pauschal</p>
              <p class="text-3xl font-bold text-dark">400€</p>
            </div>
          </div>
        </a>

        <!-- Zweite Meinung -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Zweite Meinung</h2>
              <p class="text-gray-muted mb-4">
                Unabhängige Einschätzung deiner bisherigen Agenturarbeit.
                Ich bin fair, respektiere jeden Stand und sage dir ehrlich,
                ob du auf dem richtigen Weg bist.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Unabhängige Bewertung
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Ehrliches Feedback
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Handlungsempfehlungen
                </li>
              </ul>
            </div>
            <div class="text-right">
              <p class="text-sm text-gray-muted">Stundensatz</p>
              <p class="text-3xl font-bold text-dark">200€</p>
            </div>
          </div>
        </div>

        <!-- Strategieberatung -->
        <div class="bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-3">Strategieberatung</h2>
              <p class="text-gray-muted mb-4">
                Tiefgehende Strategie- und Unternehmensberatung aus Data-Mining
                des Google-Universums. Für Unternehmen, die das volle Potenzial
                ihrer Online-Präsenz ausschöpfen wollen.
              </p>
              <ul class="space-y-2 text-sm text-gray-muted">
                <li class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-lime-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Marktanalyse
                </li>
                <li class="flex items-center gap-2">
