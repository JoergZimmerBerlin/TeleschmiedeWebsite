---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import leistungenHero from '../assets/images/pages/leistungen-hero.webp';
import { getGitModDate } from '../utils/git-date';
import Schema from '../components/Schema.astro';

const lastReviewed = getGitModDate('src/pages/leistungen.astro');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Data for services
interface Service {
  title: string;
  price: string;
  unit: string;
  description: string;
  bullets: string[];
  link?: string;
  linkText?: string;
  isPopular: boolean;
  isDark: boolean;
}

interface Category {
  title: string;
  description: string;
  services: Service[];
}

const categories: Category[] = [
  {
    title: "Einstieg & Analyse",
    description: "Der perfekte Start, um den Status Quo zu verstehen und Potenziale zu identifizieren.",
    services: [
      {
        title: "SEO-Sprechstunde",
        price: "480€",
        unit: "Pauschal",
        description: "2-stündiger Videocall für alle deine Fragen. Ich teile mein komplettes Wissen aus 20+ Jahren SEO-Erfahrung. Direkt, auf den Punkt, ohne Blabla.",
        bullets: ["2 Stunden 1:1 Videocall", "Alle Fragen erlaubt", "Sofort umsetzbare Tipps", "Optional: Aufzeichnung"],
        link: `${baseUrl}/seo-sprechstunde/`,
        linkText: "Alle Details zur Sprechstunde",
        isPopular: false,
        isDark: false
      },
      {
        title: "Keyword-Potenzialanalyse",
        price: "960€",
        unit: "Ab",
        description: "Data-Mining im Google-Universum: Ich finde die Keywords, die für dein Business wirklich relevant sind. Inklusive Suchvolumen, Wettbewerb und monetärem Potenzial.",
        bullets: ["Keyword-Recherche", "Suchvolumen-Analyse", "Wettbewerbsbewertung", "Monetäres Potenzial"],
        isPopular: false,
        isDark: false
      },
      {
        title: "Local SEO & Stadtportale",
        price: "600€",
        unit: "Einmalig",
        description: "Perfekt für junge Domains und lokale Unternehmen. Dieser Service sorgt für initiales Linkbuilding und schnellen Trust-Aufbau bei Google. Ich trage dein Unternehmen professionell in 50 relevante Stadtportale (Ströer Marketing Portfolio) ein – ohne Abo-Falle.",
        bullets: [
          "Eintrag in 50 Stadtportale",
          "Inkl. Vorher/Nachher Scan",
          "Upload von Bildern & Logo",
          "Verlinkung Domain & Social Media"
        ],
        isPopular: false,
        isDark: false
      },
      {
        title: "Zweite Meinung",
        price: "240€",
        unit: "Stundensatz",
        description: "Unabhängige Einschätzung deiner bisherigen Agenturarbeit. <strong>Diskret und ohne Account-Zugänge möglich</strong>, damit dein bisheriger Partner nichts davon merkt.",
        bullets: ["Unabhängige Bewertung", "Ehrliches Feedback", "Handlungsempfehlungen"],
        isPopular: false,
        isDark: false
      }
    ]
  },
  {
    title: "Krisen & Strategie",
    description: "Hilfe wenn es brennt oder wenn eine grundlegende Neuausrichtung nötig ist.",
    services: [
      {
        title: "SEO Troubleshooting & Live Coaching",
        price: "3.600€",
        unit: "Ab",
        description: "In Notfällen, bei Relaunch-Absturz, bei strategischen Fragen zu Domain-Management, bei Google Penalty oder Ranking-Verlust. Schnelle Hilfe, wenn es brennt.",
        bullets: ["Krisen-Management (Penalty & Absturz)", "Relaunch-Begleitung & Recovery", "Domain-Management & Strategie", "Support bei Personal-Engpässen"],
        isPopular: false,
        isDark: false
      },
      {
        title: "Strategieberatung",
        price: "Individuell",
        unit: "Auf Anfrage",
        description: "Tiefgehende Strategie- und Unternehmensberatung aus Data-Mining des Google-Universums. Für Unternehmen, die das volle Potenzial ausschöpfen wollen.",
        bullets: ["Marktanalyse", "Zielgruppen-Strategie", "Langfristige Roadmap", "Coaching für Teams"],
        isPopular: false,
        isDark: false
      },
      {
        title: "Freelancer Team Vermittlung",
        price: "0€",
        unit: "Kostenfrei",
        description: `Du brauchst Experten für Paid Ads, Webdesign, Content oder E-Commerce, hast aber kein eigenes Netzwerk? Ich vermittle dir handverlesene Spezialisten aus dem <a href="${baseUrl}/freelancer-team/" class="font-semibold text-dark underline decoration-lime-accent decoration-2 underline-offset-4 hover:text-lime-600 transition-colors" title="Freelancer Team">Freelancer Team</a>. Wir sind alle unabhängig, arbeiten aber als eingespieltes Team zusammen – Inhouse-Feeling ohne Agentur-Overhead.`,
        bullets: [
          "Zugriff auf alle Marketing-Disziplinen",
          "Erprobte, hochqualifizierte Experten",
          "Kostenfreie & vertrauensvolle Vermittlung",
          "Eingespielte Zusammenarbeit im Netzwerk"
        ],
        isPopular: false,
        isDark: false
      }
    ]
  },
  {
    title: "Begleitung & Management",
    description: "Langfristige Betreuung und operative Umsetzung für messbares Wachstum.",
    services: [
      {
        title: "10-Stunden Paket",
        price: "1.920€",
        unit: "Pauschal",
        description: "Das perfekte Paket für tiefe Audits, erste Setup-Phasen oder punktuelle Problemlösung. Maximale Flexibilität ohne Vertragslaufzeit.",
        bullets: ["Freie Zeiteinteilung", "Keine Vertragslaufzeit", "Für Audits, Setups & Troubleshooting"],
        isPopular: true,
        isDark: false
      },
      {
        title: "Monatlicher Retainer",
        price: "1.920€",
        unit: "Ab",
        description: "Ideal für ambitionierte B2B-Unternehmen and Online-Shops. Laufende Überwachung, Content-Steuerung und strategische Beratung.",
        bullets: ["Kontinuierliche Optimierung", "Regelmäßiges Reporting & Calls", "Proaktive Strategieanpassungen", "Sparringspartnerschaft fürs C-Level"],
        isPopular: false,
        isDark: true
      },
      {
        title: "Google Ads Management",
        price: "240€",
        unit: "Stundensatz",
        description: "Performance-optimierte Kampagnen mit Fokus auf ROI. Von der Strategie über den Aufbau bis zur laufenden Optimierung. Transparent und ergebnisorientiert.",
        bullets: ["Kampagnen-Setup", "Anzeigentexte & Keywords", "Conversion-Tracking", "Laufende Optimierung"],
        link: `${baseUrl}/google-ads-freelancer-berlin/`,
        linkText: "Zum Google Ads Profil",
        isPopular: false,
        isDark: false
      }
    ]
  }
];

// Flatten categories into a single offers array for the schema
const allOffers = categories.flatMap(cat => cat.services.map(s => ({
  name: s.title,
  description: s.description.replace(/<\/?[^>]+(>|$)/g, "") // Strip HTML for schema
})));
---

<Layout
  title="Leistungen | Jörg Zimmer - SEO & SEA Freelancer"
  description="SEO-Checks, Keyword-Analysen, Google Ads Management und Beratung. Entdecke meine Leistungen als SEO-Freelancer in Berlin Spandau."
>
  <!-- Hero -->
  <section class="section-hero pt-12 pb-20 md:pb-32">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <div class="flex flex-wrap items-center gap-x-4 mb-4">
            <p class="subheadline uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent inline-block px-4 py-1 rounded-full">
              ALOHA! 🌻 Ich bin Jörg.
            </p>
            {lastReviewed && (
              <span class="text-gray-muted text-xs font-normal italic border-l border-gray-200 pl-4">Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            Von der Analyse zur
            <span class="highlight">Umsetzung.</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl">
            Mein Stundensatz liegt bei 240€. Dafür bekommst du alles, was ich in
            über 20 Jahren gelernt habe. Keine Agentur-Struktur, kein Overhead – nur direkte Expertise.
          </p>
        </div>
        <div class="md:w-1/3">
          <Image
            src={leistungenHero}
            alt="Jörg Zimmer präsentiert SEO-Strategie - Freelancer für Suchmaschinenoptimierung Berlin"
            width={800}
            height={800}
            class="w-full h-auto rounded-2xl shadow-lg border-4 border-white"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Categories & Services -->
  {categories.map((category, catIndex) => (
    <section class={`section ${catIndex % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
      <div class="container-narrow">
        <div class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{category.title}</h2>
          <p class="text-gray-600 max-w-2xl text-lg">{category.description}</p>
        </div>

        <div class="grid gap-8">
          {category.services.map((service: Service) => (
            <div 
              class:list={[
                "rounded-2xl p-8 border transition-all duration-300 relative overflow-hidden group hover:border-lime-accent",
                service.isDark ? "bg-dark text-white border-gray-800 shadow-2xl" : "bg-white border-gray-100 hover:shadow-xl",
                service.isPopular ? "border-2 border-lime-accent shadow-lg" : ""
              ]}
            >
              {service.isPopular && (
                <div class="absolute top-0 right-0 bg-lime-accent text-dark font-bold px-4 py-1 rounded-bl-xl text-xs uppercase tracking-wider z-10 shadow-sm">
                  Beliebt
                </div>
              )}
              
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8 relative z-10">
                <div class="flex-1">
                  <h3 class:list={["text-2xl font-bold mb-4 transition-colors duration-300", service.isDark ? "group-hover:text-lime-400" : "group-hover:text-lime-600"]}>{service.title}</h3>
                  <p 
                    class:list={[
                      "mb-6 max-w-xl text-lg leading-relaxed",
                      service.isDark ? "text-gray-300" : "text-gray-600"
                    ]}
                    set:html={service.description}
                  />
                  
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                    {service.bullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-sm">
                        <svg 
                          class:list={[
                            "w-5 h-5 flex-shrink-0 mt-0.5",
                            service.isDark ? "text-lime-400" : "text-lime-600"
                          ]} 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span class={service.isDark ? "text-gray-300" : "text-gray-600"}>{bullet}</span>
                      </li>
                    ))}
                  </ul>

                  {service.link && (
                    <a href={service.link}
                      class:list={[
                        "inline-flex items-center gap-2 font-medium underline underline-offset-4 decoration-2 transition-colors",
                        service.isDark ? "text-lime-400 decoration-lime-400/30 hover:decoration-lime-400" : "text-dark decoration-lime-accent/50 hover:decoration-lime-accent"
                      ]}
                     title={service.linkText}>
                      {service.linkText}
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </a>
                  )}
                </div>

                <div class="md:w-32 lg:w-40 md:text-right flex flex-col justify-center">
                  <p class:list={["text-xs font-bold uppercase tracking-widest mb-1", service.isDark ? "text-gray-400" : "text-gray-muted"]}>
                    {service.unit}
                  </p>
                  <p class="text-4xl font-black">{service.price}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Profiles / CTA Area -->
  <section class="section bg-lime-accent text-dark overflow-hidden relative">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-white/20 rounded-full blur-3xl"></div>
    <div class="container-narrow relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold mb-6">Willst du mehr wissen?</h2>
        <p class="text-xl max-w-2xl mx-auto font-medium">
          Detaillierte Einblicke in meine Arbeitsweise findest du auf meinen spezialisierten Profilen.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <a href={`${baseUrl}/seo-freelancer-berlin/`} class="bg-white/90 backdrop-blur-sm p-8 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all border border-transparent hover:border-lime-accent group" title="SEO Freelancer Profil Mein Fokus auf Strategie, technische Exzellenz und 20+ Jahre Erfahrung in der organischen Suche. Profil ansehen">
          <h3 class="text-2xl font-bold mb-4 group-hover:text-lime-600 transition-colors">SEO Freelancer Profil</h3>
          <p class="text-gray-700 mb-6">Mein Fokus auf Strategie, technische Exzellenz und 20+ Jahre Erfahrung in der organischen Suche.</p>
          <span class="flex items-center gap-2 font-bold underline underline-offset-4 group-hover:text-lime-600 transition-colors">Profil ansehen <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>

        <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="bg-white/90 backdrop-blur-sm p-8 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all border border-transparent hover:border-lime-accent group" title="Google Ads Profil 10 Jahre exklusive SEA-Expertise, ROI-fokussiertes Management und Google Partner Know-how. Profil ansehen">
          <h3 class="text-2xl font-bold mb-4 group-hover:text-lime-600 transition-colors">Google Ads Profil</h3>
          <p class="text-gray-700 mb-6">10 Jahre exklusive SEA-Expertise, ROI-fokussiertes Management und Google Partner Know-how.</p>
          <span class="flex items-center gap-2 font-bold underline underline-offset-4 group-hover:text-lime-600 transition-colors">Profil ansehen <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section bg-dark text-white">
    <div class="container-narrow text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">
        Welche Leistung passt zu dir?
      </h2>
      <p class="text-gray-300 mb-8 max-w-xl mx-auto text-lg">
        Schreib mir eine Nachricht und wir finden gemeinsam heraus,
        wie ich dir am besten helfen kann. ALOHA! 🌻
      </p>
      <a href={`${baseUrl}/kontakt/`} class="btn-primary" title="Unverbindlich anfragen">
        Unverbindlich anfragen
      </a>
    </div>
  </section>

  <Schema 
    title="Leistungen | Jörg Zimmer - SEO & SEA Freelancer"
    description="SEO-Checks, Keyword-Analysen, Google Ads Management und Beratung. Entdecke meine Leistungen als SEO-Freelancer in Berlin Spandau."
    lastReviewed={lastReviewed}
    offers={allOffers}
  />
</Layout>
