---
import { Image, getImage } from 'astro:assets';
import { getGitModDate } from '../utils/git-date';
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Testimonials from '../components/Testimonials.astro';
import heroImage from '../assets/images/blog/omr-freelancer-stand-roi.webp';
import joergWorking from '../assets/images/pages/hero-pose.webp';
import joergInterview from '../assets/images/blog/seopresso-interview.webp';
import joergPodcast from '../assets/images/blog/ai-ready-podcast.webp';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/seo-freelancer-berlin.astro');

// Meta Data
const title="SEO Freelancer: 25 Jahre Erfahrung & Freelancer-Netzwerk (2026)";
const description="SEO Freelancer aus Leidenschaft. Ich biete persönliche Beratung und bringe bei Bedarf ein Netzwerk aus 100 Experten mit. Erfahre mehr in der SEO Sprechstunde.";

const faqs = [
  {
    question: "Warum sollte ich einen SEO Freelancer statt einer klassischen Agentur beauftragen?",
    answer: "Weil du bei mir einen direkten Ansprechpartner hast. Du profitierst von meiner Erfahrung aus 25 Jahren SEO und extrem kurzen Kommunikationswegen. Es gibt keine Account-Manager dazwischen – wir arbeiten gemeinsam und auf Augenhöhe an der Sichtbarkeit deiner Website."
  },
  {
    question: "Ist die SEO-Sprechstunde der beste Einstieg?",
    answer: "Absolut! In der 2-stündigen SEO-Sprechstunde analysieren wir deine Website live. Es ist der perfekte Weg, um sich kennenzulernen und direkt herauszufinden, ob wir zusammenpassen. Du bekommst sofort erste handfeste Optimierungspotenziale und einen konkreten Maßnahmenplan. Danach entscheiden wir in Ruhe, ob und wie wir weitermachen."
  },
  {
    question: "Was, wenn ich auch Hilfe bei Tracking, Google Ads oder Social Media brauche?",
    answer: "Genau dafür gibt es mein Netzwerk! Ich selbst fokussiere mich auf SEO und [Google Ads](/google-ads-freelancer-berlin/). Wenn wir darüber hinaus Bereiche wie Meta Ads, Instagram, Texting, Branddesign oder Videoschnitt abdecken müssen, hole ich die passenden Experten aus meinem **[Freelancer-Team](/freelancer-team/)** dazu. Wir sind ein freiwilliger Zusammenschluss von rund 100 Spezialisten."
  },
  {
    question: "Bietest du auch eine neutrale Zweitmeinung an?",
    answer: "Ja, sehr gerne. Wenn du dir unsicher bist, ob deine aktuelle SEO-Strategie den richtigen Weg einschlägt, oder du ein vorliegendes Angebot prüfen lassen willst, werfe ich einen neutralen Blick darauf. Ich berate immer fair, transparent und konstruktiv."
  },
  {
    question: "Was kostet die Zusammenarbeit?",
    answer: "Ich arbeite mit transparenten Paketen. Nach der Sprechstunde (480€) nutzen viele das 10-Stunden Paket (1.920€) für die Umsetzung von Setups und Audits. Für langfristige Begleitung biete ich einen monatlichen Retainer (ab 1.920€) an. Keine versteckten Kosten."
  },
  {
    question: "Wie steht es um KI im SEO? Lohnt sich das noch?",
    answer: "Klassisches SEO wandelt sich stark in Richtung GEO (Generative Engine Optimization). KI-Modelle suchen nach echten Experten und fundierten Inhalten (E-E-A-T), um dich als Quelle zu zitieren. Wer nur generischen KI-Content nutzt, wird es schwer haben. Es geht heute um echte Meinungsstärke und Kontext."
  }
];

const offers = [
  {
    name: "SEO Sprechstunde (480€)",
    description: "2 Stunden Live-Analyse – der perfekte Einstieg zum Kennenlernen."
  },
  {
    name: "Technisches & Inhaltliches SEO",
    description: "Ganzheitliche Optimierung von der Seitenarchitektur bis zum Content."
  },
  {
    name: "Neutrale Zweitmeinung (nach Aufwand)",
    description: "Ehrliche und objektive Prüfung bestehender SEO-Maßnahmen."
  },
  {
    name: "10-Stunden Paket (1.920€)",
    description: "Flexibles Leistungspaket für Audits und Setups (1.920€ Pauschal)."
  },
  {
    name: "Monatlicher Retainer (ab 1.920€)",
    description: "Laufende Betreuung für nachhaltiges Wachstum (ab 1.920€ monatlich)."
  },
  {
    name: "Freelancer Team Setup",
    description: "Koordination von Experten für Google Ads, Social Media, Design und mehr."
  }
];
---
<Layout title={title} description={description} lcpImage={heroImage.src} ogImage={heroImage.src}>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-3/5 z-10">
          <div class="flex flex-wrap items-center gap-x-4 mb-4">
            <p class="subheadline uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent inline-block px-4 py-1 rounded-full">
              Moin! Ich bin Jörg.
            </p>
            {lastReviewed && (
              <span class="text-gray-muted text-xs font-normal italic border-l border-gray-200 pl-4">Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold text-dark mb-6 leading-normal">
            Dein <span class="highlight">SEO Freelancer</span> & Ansprechpartner für echtes Wachstum.
          </h1>
          <p class="text-lg md:text-xl text-gray-700 max-w-2xl mb-10 leading-relaxed">
            Ich bin SEO-Freelancer aus Leidenschaft – und das seit fast 25 Jahren. Ich verkaufe dir keine automatisierten Reports, sondern arbeite gemeinsam mit dir an deiner Sichtbarkeit. Direkt, transparent und immer mit dem Fokus auf deinen langfristigen Erfolg.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`${baseUrl}/seo-sprechstunde/`} class="btn-primary text-center" title="Zur SEO Sprechstunde (2026)">
              Der beste Einstieg: Die SEO Sprechstunde
            </a>
          </div>
        </div>
        <div class="md:w-2/5">
          <Image
            src={heroImage}
            alt="Jörg Zimmer auf der OMR - SEO Stratege"
            title="Jörg Zimmer SEO Stratege OMR"
            width={600}
            class="w-full h-auto rounded-3xl shadow-2xl border-4 border-white object-cover object-top"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section id="vorstellung" class="section bg-gray-50 pt-24 pb-12">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2 prose prose-lg max-w-none text-gray-800">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">Kurz vorgestellt: Wer ich bin und wie wir arbeiten</h2>
          <p class="leading-relaxed mb-6">
            Lange Texte kann man viel schreiben. Bevor wir aber tiefer in Strategien eintauchen, lade ich dich ein, dir kurz mein Video von der OMR anzusehen. 
          </p>
          <p class="leading-relaxed mb-6">
            Darin erfährst du nicht nur, wer ich bin, sondern auch, wie unser großes Freelancer-Netzwerk funktioniert. Wir sind ein freiwilliger Zusammenschluss aus rund 100 Freelancern – und können damit alle Bereiche deines Online-Marketings abdecken, wenn du Unterstützung brauchst. Von SEO und Ads über Branddesign bis hin zu Videoschnitt.
          </p>
        </div>
        <div class="lg:w-1/2 w-full">
          <div class="relative w-full aspect-[9/16] max-h-[600px] md:max-h-none md:aspect-video rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-dark mx-auto">
            <iframe 
              src="https://www.youtube-nocookie.com/embed/ldshfeRmpw8?rel=0" 
              title="Vorstellung Jörg Zimmer" 
              class="absolute top-0 left-0 w-full h-full"
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Testimonials -->
  <Testimonials />

  <!-- Content Section: Arbeitsweise & Netzwerk -->
  <section class="section bg-white pt-24 pb-24 border-t border-gray-100">
    <div class="container-narrow">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-12 text-center">Meine Philosophie: Zusammenarbeit auf Augenhöhe</h2>
      
      <p class="text-lg text-gray-700 text-center max-w-4xl mx-auto mb-16 leading-relaxed">
        Ich verstehe mich als dein Partner für digitale Sichtbarkeit. Wir jagen keinen reinen Vanity-Metriken hinterher, sondern fokussieren uns auf die Stellschrauben, die am Ende wirklich wertvolle Leads und Kunden bringen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 p-10 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Schritt 1: Das Indexierungs-Audit</h3>
          <p class="text-gray-700 leading-relaxed">
            Mein erster Technik-Schritt in jedem Projekt: Ich gleiche das echte Inventar deiner Website mit dem ab, was bei Google und Bing überhaupt im Index liegt. Oft stelle ich fest, dass teuer produzierter Content nicht indexiert ist und somit null zur Sichtbarkeit beiträgt. Blockaden in Sitemaps und den Webmaster Consoles zu lösen, ist meine erste Amtshandlung.
          </p>
        </div>

        <div class="bg-gray-50 p-10 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Der Freelancer-Vorteil</h3>
          <p class="text-gray-700 leading-relaxed">
            Als Marketing-Verantwortlicher brauchst du verlässliche Partner. Bei mir arbeitest du direkt mit dem Experten zusammen. Keine Umwege, keine langen internen Freigabeschleifen. Ich berate dich konstruktiv und setze dort an, wo deine Sichtbarkeit wirklich Optimierungsbedarf hat – ob im technischen Fundament oder bei der Informationsarchitektur.
          </p>
        </div>

        <div class="bg-gray-50 p-10 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Netzwerk aus 100 Experten</h3>
          <p class="text-gray-700 leading-relaxed">
            Auch wenn mein Fokus auf SEO und <a href={`${baseUrl}/google-ads-freelancer-berlin/`} class="text-lime-700 font-bold underline hover:text-dark">Google Ads</a> liegt: Über mein etabliertes <a href={`${baseUrl}/freelancer-team/`} class="text-lime-700 font-bold underline hover:text-dark">Freelancer-Netzwerk</a> haben wir Zugriff auf Profis für Meta Ads, Texting, Branddesign oder Videoschnitt. Du profitierst von der Expertise einer Agentur, behältst aber die Flexibilität von Freelancern.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section: Networking & Weiterbildung -->
  <section class="section bg-white pt-12 pb-24">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        <div class="lg:w-1/2 prose prose-lg max-w-none text-gray-800">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">Erfahrung heißt: Sein Wissen immer wieder neu zu erfinden</h2>
          <p class="leading-relaxed mb-6">
            Auch wenn ich seit 25 Jahren dabei bin, habe ich in dieser Zeit mein Wissen schon mehrfach komplett verwerfen und neu aufbauen müssen. Die SEO-Welt dreht sich extrem schnell, und bei den zahllosen Google-Updates ist es oft entscheidend zu wissen, wo andere Experten bereits gute Erfahrungen gesammelt haben.
          </p>
          <p class="leading-relaxed mb-6">
            Deshalb ist aktives Netzwerken für mich der Schlüssel für die Zukunft. Ich bin stark auf LinkedIn vernetzt, besuche regelmäßig den <strong class="text-dark">SEO-Stammtisch in Berlin</strong> und gehe auf Konferenzen wie die <strong class="text-dark">Campixx</strong>, um mein Wissen mit tiefen Experten abzugleichen.
          </p>
          <p class="leading-relaxed">
            Gerade jetzt, mit dem radikalen Wandel hin zur neuen KI-Welt, neuen Such-Protokollen und Metriken, hat mich wieder ein riesiger Forscherdrang gepackt. Ich teste, adaptiere und teile mein Wissen, damit deine Strategie immer up to date bleibt.
          </p>
        </div>
        <div class="lg:w-1/2">
          <Image
            src={joergInterview}
            alt="Jörg Zimmer im Austausch mit anderen Experten"
            title="Jörg Zimmer beim Fach-Austausch"
            width={600}
            class="rounded-3xl shadow-lg w-full h-auto object-cover object-top border-4 border-gray-100"
            format="webp"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema inside the Component -->
  <section class="section bg-gray-50 pt-16 pb-24 border-t border-gray-100">
    <div class="container-narrow max-w-4xl mx-auto">
      <FAQAccordion faqs={faqs} />
    </div>
  </section>

  <CTASection />
</Layout>

<Schema 
  title={title}
  description={description}
  lastReviewed={lastReviewed}
  offers={offers}
  faqs={faqs}
/>
