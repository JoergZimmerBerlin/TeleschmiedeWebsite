---
import { Image, getImage } from 'astro:assets';
import { getGitModDate } from '../utils/git-date';
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import heroImage from '../assets/images/pages/hero-pose.webp';
import joergWorking from '../assets/images/profile/joerg-lifestyle.webp';
import joergCTA from '../assets/images/profile/joerg-zimmer-cta.webp';
import joergInterview from '../assets/images/blog/seopresso-interview.webp';
import joergPodcast from '../assets/images/blog/ai-ready-podcast.webp';
import FehlerImage from '../assets/images/blog/seo_fehler_simple.webp';
import ContextualImage from '../assets/images/blog/contextual_seo_simple.webp';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/seo-freelancer-berlin.astro');

// Generate WebP Image Paths for Schema.org
const joergWorkingWebp = await getImage({ src: joergWorking, format: 'webp' });
const heroImageWebp = await getImage({ src: heroImage, format: 'webp' });

// Meta Data
const title = "SEO Freelancer Berlin: 24+ Jahre Erfahrung & echtes Tacheles";
const description = "Schluss mit Agentur-Bla-Bla. Dein SEO Freelancer in Berlin für technische Exzellenz, Relaunch-Sicherheit und ehrliche Beratung. Moin! 🌻";

const faqs = [
  {
    question: "Warum sollte ich einen SEO Freelancer aus Berlin buchen und keine SEO Agentur?",
    answer: "Der größte Vorteil: Du bekommst immer den Chef auf den Monitor. Bei vielen Agenturen sprichst du anfangs mit dem Senior, aber die eigentliche Arbeit macht dann der Junior oder Praktikant – das ist 'Pfusch am Bau' mit Ankündigung. Als Freelancer betreue ich dein Projekt persönlich und lege direkt den Finger in die Wunde. Du profitierst von über 20 Jahren Erfahrung ohne stille Post oder unnötige Ticket-Systeme."
  },
  {
    question: "Was kostet die Zusammenarbeit und bietest du feste Pakete an?",
    answer: "Ja, ich arbeite mit klaren, pauschalen Paketen, damit wir nicht über Kleingeld diskutieren müssen. Du hast die Wahl zwischen der <strong>Sprechstunde (400€)</strong> für den schnellen Check, dem <strong>10-Stunden Paket (1.600€)</strong> für Setups oder dem <strong>Monatlichen Retainer (ab 1.600€)</strong> für nachhaltiges Wachstum. So hast du volle Kostentransparenz und weißt genau, was du für dein Budget bekommst."
  },
  {
    question: "Kommst du auch mal in unser Büro in Berlin?",
    answer: "Absolut! Auch wenn ich viel remote aus meinem Büro in Spandau arbeite, schätze ich das persönliche Gespräch bei einem Kaffee (oder Tee) sehr. Für Kick-offs oder strategische Meilensteine komme ich gerne in eure Räumlichkeiten in Berlin. Der persönliche Vibe lässt sich durch kein Zoom-Tool der Welt zu 100% ersetzen, besonders wenn es um komplexe Roadmaps geht."
  },
  {
    question: "Machst du auch Local SEO speziell für Berlin?",
    answer: "Absolut! Für Handwerker, Kanzleien, Ärzte oder lokale Dienstleister in Berlin ist Local SEO der stärkste Hebel. Wir optimieren dein Google Unternehmensprofil (früher Google My Business), sorgen für saubere lokale Citations und bauen Landingpages auf, die punktgenau für Suchanfragen wie 'Zahnarzt Berlin Spandau' oder 'IT Systemhaus Charlottenburg' ranken. Gerade in einer umkämpften Metropole wie Berlin ist eine messerscharfe lokale Positionierung Gold wert."
  },
  {
    question: "Was sagst du zu KI im SEO (GEO, AIO)? Ist SEO tot?",
    answer: "SEO ist nicht tot, es wird nur endlich intelligenter. Wir bewegen uns von der reinen Keyword-Jagd hin zu <strong>GEO</strong> (Generative Engine Optimization). Wer heute noch versucht, Google mit billigem KI-Content auszutricksen, spielt Russisch Roulette mit seinem Business. Wir müssen Entitäten aufbauen und echten Kontext liefern, den die KI-Modelle wie Gemini oder ChatGPT als zitierwürdige Quelle wahrnehmen."
  },
  {
    question: "Benutzt du Tools oder machst du das aus dem Bauch heraus?",
    answer: "Gefühle sind super für LinkedIn-Posts, aber Gift für die SEO-Strategie. Mein Stack ist hocheffizient: Screaming Frog für die Technik, Sistrix und Ahrefs für die Sichtbarkeit und Rankscale für das KI-Sichtbarkeits-Tracking. Ich übersetze diese harten Daten für dich in Business-Nutzen. Denn am Ende des Tages zählen keine bunten Graphen, sondern ob wir Umsatz für dein Unternehmen treiben."
  }
];
---

<Layout title={title} description={description} lcpImage={heroImage.src} ogImage={heroImage.src}>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-3/5 z-10">
          <p class="subheadline mb-4 uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent inline-block px-4 py-1 rounded-full">Moin! 🌻 Ich bin Jörg.</p>
          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold text-dark mb-6 leading-normal">
            Echtes Handwerk statt Agentur-Bla-Bla: Dein <span class="highlight">SEO Freelancer</span>.
          </h1>
          <p class="text-lg md:text-xl text-gray-700 max-w-2xl mb-10 leading-relaxed">
            Ehrliche Ansagen statt glattgebügelter Reports. Ich bin Jörg – seit über <strong>24 Jahren</strong> (ja, seit den Anfängen dabei) im SEO-Game. Ich baue keine "Luftschlösser", sondern sorge dafür, dass deine Website technischer und inhaltlicher Maßstab wird. Direkt, messbar und mit ordentlich Tacheles.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary text-center">
              Lass uns sprechen
            </a>
            <a href="#ansatz" class="btn-secondary text-center scroll-smooth">
              Warum ein Freelancer?
            </a>
          </div>
        </div>
        <div class="md:w-2/5">
          <Image
            src={heroImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer in Berlin Spandau"
            width={600}
            height={800}
            class="w-full h-auto rounded-3xl shadow-2xl border-4 border-white object-cover"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 1: Intro & Agentur vs Freelancer -->
  <section id="ansatz" class="section bg-gray-50 pt-24 pb-24">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-start">
        <div class="lg:w-2/3 prose prose-lg max-w-none text-gray-800">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-8 border-b-2 border-lime-accent pb-4 inline-block">Warum überhaupt ein SEO Freelancer aus Berlin?</h2>
          
          <p class="mb-8 leading-relaxed">
            Stell dir vor, dein Auto macht seltsame Geräusche. Fährst du zu einer riesigen Werkstattkette (die <strong>Deutsche Bahn</strong> des Kfz-Handwerks), wo dich eine Empfangskraft ohne Plan einbucht? Oder fährst du zum Meister, der seit 20 Jahren denselben Motortyp im Schlaf zerlegt? 
          </p>

          <p class="mb-8 leading-relaxed">
            Genau das ist der Unterschied zwischen einer "Bauchladen"-Agentur und mir. Wenn du mich buchst, bekommst du mich. Kein Bullshit-Bingo, kein Junior-Account-Manager, der deine Mails an eine anonyme Technikabteilung weiterreicht. Du arbeitest direkt mit jemandem, der seit 2001 (damals war Google noch ein Experiment!) im Online Marketing die Ärmel hochkrempelt.
          </p>
          
          <div class="my-10 bg-white p-6 rounded-2xl border-l-4 border-lime-500 shadow-sm">
            <p class="text-dark font-bold italic text-lg mb-2">💬 Jörgs SEO-Klartext (LinkedIn Insights)</p>
            <p class="text-dark mb-0 italic">"Ich spreche fließend C-Level und fließend Nerd. Wenn die Geschäftsführung über Budgets spricht, übersetze ich das für die Entwickler in glasklare JSON-LD und Server-Side-Rendering Vorgaben. Das spart Zeit, Geld und Nerven."</p>
          </div>

          <h3 class="text-2xl font-bold mt-16 mb-6">Seit 2001: Vom "Wilden Westen" zur KI-Revolution</h3>
          <p class="mb-8 leading-relaxed">
            Ich habe HTML noch mit dem Notepad in die Tasten gehackt, als das Internet noch mit Modem-Geräuschen funktionierte. Über zwei Jahrzehnte habe ich Hypes kommen und gehen gesehen. Ich habe gesehen, wie Google "Tricks" über Nacht ausradiert hat – und wer auf <strong>Pfusch am Bau</strong> gesetzt hat, war weg vom Fenster.
          </p>
          
          <p class="mb-8 leading-relaxed">
            Heute ist SEO kein Spielplatz mehr für Praktikanten. Es ist ein hochkomplexes Zusammenspiel aus <strong>technischer Exzellenz, messerscharfem Content und echter Autorität</strong>. Wer heute noch glaubt, mit ein paar gekauften Backlinks den Markt zu rocken, spielt Russisch Roulette mit seiner Existenz.
          </p>

          <div class="my-10 bg-lime-accent/10 p-8 rounded-3xl border border-lime-200">
            <h4 class="text-xl font-bold mb-4">Die Gefahr des "KI-Einheitsbreis"</h4>
            <p class="text-gray-800 leading-relaxed mb-0">
              Der Markt wird gerade mit generischem KI-Content geflutet. Wenn alle dasselbe schreiben, wird niemand mehr wahrgenommen. Google indexiert diesen Einheitsbrei immer seltener. Was heute zählt, ist <strong>E-E-A-T</strong>. Meine Aufgabe ist es, deine echte Expertise so zu verpacken, dass Google dich nicht für einen Bot hält, sondern für die unangefochtene Nummer 1 in deiner Nische.
            </p>
          </div>
        </div>
        
        <!-- Sidebar mit persönlichem Bild -->
        <div class="lg:w-1/3">
          <div class="sticky top-32">
            <Image
              src={joergInterview}
              alt="Jörg Zimmer im SEOPRESSO Podcast Interview"
              width={600}
              height={800}
              class="w-full h-auto rounded-3xl shadow-xl border-4 border-white mb-6 object-cover aspect-[3/4]"
              format="webp"
            />
            <p class="text-sm text-center text-gray-muted italic px-4">SEO Architekt, Jörg Zimmer, 48 Jahre.</p>
          </div>
        </div>
      </div>

      <!-- Infografik 1 -->
      <div class="my-16 bg-white p-8 rounded-3xl shadow-sm border border-gray-100 relative">
        <div class="absolute -top-6 left-8 bg-dark text-lime-accent px-6 py-2 rounded-full font-bold text-sm shadow-md">
          Fehler, die Klicks kosten
        </div>
        <Image
          src={FehlerImage}
          alt="Häufige SEO Fehler und deren Lösungen - Infografik"
          width={1200}
          height={675}
          class="w-full h-auto rounded-xl object-contain"
          format="webp"
        />
        <p class="text-sm text-center text-gray-muted mt-4 italic">Wie viele dieser Baustellen hast du aktuell noch auf deiner Website?</p>
      </div>
    </div>
  </section>

  <!-- Content Section 2: Die 4 Säulen meiner SEO-Beratung -->
  <section class="section bg-white pt-24 pb-24">
    <div class="container-narrow">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-12 text-center">Meine Methodik: Handwerk statt Magie</h2>
      
      <p class="text-lg text-gray-700 text-center max-w-4xl mx-auto mb-16 leading-relaxed">
        Ich verkaufe keine Geheimnisse, sondern ehrliches Handwerk. Wer "Magie" verspricht, meint meistens Pfusch. Ich arbeite nach messbaren Milestones, die nachweislich den Umsatz treiben. Rankings sind Vanity-Metriken – was zählt, ist der Cashflow am Ende des Monats.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Säule 1 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">1. Technisches SEO (Das Fundament)</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Eine Website ohne technisches Fundament ist wie ein Ferrari ohne Motor. Sieht schick aus, aber du kommst nicht vom Fleck. Wir machen deine Seite zur Rennmaschine.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Core Web Vitals & PageSpeed:</strong> Wir jagen die 100/100, damit kein Nutzer abspringt, bevor die Seite geladen ist.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Crawlbarkeit:</strong> Wir räumen auf. Weg mit 404-Leichen und unnötigen Redirects, die dein Crawl-Budget fressen.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Strukturierte Daten:</strong> Wir sprechen JSON-LD, damit Google genau weiß, wer du bist und was du verkaufst.</li>
          </ul>
        </div>

        <!-- Säule 2 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">2. Inhaltliches SEO (Content & Vibe)</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Suchintention ist alles. Wer "SEO Freelancer Berlin" sucht, will keinen Roman lesen, sondern Lösungen. Wir schreiben Texte für Menschen, die auch von Google geliebt werden.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Content Audits:</strong> Wir töten "Zombie-Pages", die nur deine Autorität verwässern.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Entitäten-Optimierung:</strong> Wir denken in Themenclustern, nicht in einsamen Keywords. Wir bauen echte Experten-Hubs.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Usability:</strong> Eine Seite, auf der man nichts findet, ist eine Seite ohne Conversions. Wir optimieren den Flow.</li>
          </ul>
        </div>

        <!-- Säule 3 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">3. Strategisches SEO (Autorität)</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Topical Authority ist die einzige Versicherung gegen Google-Updates. Wir sorgen dafür, dass Google gar nicht anders kann, als dich als Fachinstanz zu sehen.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Themen-Silos:</strong> Wir ordnen das Chaos und leiten den Linkjuice gezielt auf deine wichtigsten Seiten.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Interne Verlinkung:</strong> Der massiv unterschätzte Hebel. Wer hier spart, verschenkt bares Geld.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>E-E-A-T Setup:</strong> Wir zeigen Google, dass hinter deiner Marke echte Experten mit echten Gesichtern stecken.</li>
          </ul>
        </div>

        <!-- Säule 4 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">4. Relaunch-Begleitung (Die Lebensversicherung)</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Ein Relaunch ohne SEO-Begleitung ist wie eine Operation am offenen Herzen ohne Anästhesist. Wenn der Traffic einbricht, ist es oft zu spät.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Redirect-Mapping:</strong> Wir sorgen dafür, dass jeder einzelne Link ans Ziel kommt. Keine 404-Abstürze.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>URL-Struktur & Hierarchien:</strong> Wir bauen von Anfang an logisch, damit Google die neue Seite sofort liebt.</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> <strong>Post-Launch Audit:</strong> Wir lassen dich nicht im Regen stehen und prüfen sofort nach dem Live-Gang alle Vitalwerte.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 3: AI & Google KI-Modus & Local SEO -->
  <section class="section bg-dark text-white pt-24 pb-24 relative overflow-hidden">
    <!-- Decorative element -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-lime-accent rounded-full opacity-5 blur-[120px] pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
    
    <div class="container-narrow position-relative z-10">
      <div class="prose prose-lg prose-invert max-w-none">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
          <div class="lg:col-span-7">
            <h2 class="text-3xl md:text-5xl font-bold mb-6 !text-white !border-lime-accent !pb-4">SEO auf dem Prüfstand: Die Ära der KI (LLMO & GEO)</h2>
            <p class="leading-relaxed text-gray-300">
              Seit der Veröffentlichung von ChatGPT und der anstehenden Revolution durch den <strong>Google KI-Modus</strong> fragen sich viele: Ist SEO tot? Die Antwort lautet: Klassisches SEO, wie wir es kannten, liegt auf der Intensivstation. Was stattdessen entsteht, nenne ich <strong>Generative Engine Optimization (GEO)</strong> oder <strong>LLMO (Large Language Model Optimation)</strong>.
            </p>
            <p class="leading-relaxed text-gray-300 mt-6">
              KIs "verstehen" Texte nicht wie wir, sie berechnen Wahrscheinlichkeiten von Wortfolgen. Wenn wir künftig wollen, dass eine KI uns in ihren Antworten zitiert (ob bei Perplexity, OpenAI oder Google AI Overview), müssen wir Informationsdichte und Authorität ausstrahlen. Das gelingt durch echte Meinungsstärke, originäre Daten (Studien, Umfragen) und die Vermeidung von generischem Content-Einheitsbrei.
            </p>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-10">
            <Image
              src={joergPodcast}
              alt="Jörg Zimmer diskutiert über KI und SEO"
              width={800}
              height={500}
              class="rounded-3xl shadow-xl w-full h-[350px] object-cover object-top border-4 border-gray-800"
              format="webp"
              loading="lazy"
            />
            <Image
              src={ContextualImage}
              alt="Contextual SEO: Wie Technologie auf Menschliche Emotion trifft"
              width={800}
              height={450}
              class="rounded-3xl shadow-2xl bg-white p-3 w-full h-auto object-contain"
              format="webp"
              loading="lazy"
            />
          </div>
        </div>

