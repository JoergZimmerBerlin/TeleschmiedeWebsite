---
import { Image, getImage } from 'astro:assets';
import { getGitModDate } from '../utils/git-date';
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Testimonials from '../components/Testimonials.astro';
import heroImage from '../assets/images/blog/omr-freelancer-stand-roi.webp';
import joergWorking from '../assets/images/pages/hero-pose.webp';
import joergCTA from '../assets/images/profile/joerg-zimmer-cta.webp';
import joergInterview from '../assets/images/blog/seopresso-interview.webp';
import joergPodcast from '../assets/images/blog/ai-ready-podcast.webp';
import ContextualImage from '../assets/images/blog/contextual_seo_simple.webp';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/seo-freelancer-berlin.astro');

// Generate WebP Image Paths for Schema.org
const joergWorkingWebp = await getImage({ src: joergWorking, format: 'webp' });
const heroImageWebp = await getImage({ src: heroImage, format: 'webp' });

// Meta Data
const title="SEO Freelancer: Technik & Strategie (2026)";
const description="SEO Freelancer mit 25 Jahren Erfahrung. Tacheles statt Agentur-Gerede. Hol dir eine neutrale Zweitmeinung in der SEO Sprechstunde. (2026)";

const faqs = [
  {
    question: "Warum sollte ich einen SEO Strategen statt einer klassischen Agentur beauftragen?",
    answer: "Weil du bei mir keine Account-Manager bezahlst, die deine Anfragen intern an Junioren weiterleiten. Ich arbeite direkt am offenen Herzen deiner Website. Du profitierst von 25 Jahren Praxiserfahrung, ehrlichem Klartext und extrem kurzen Kommunikationswegen. Wenn ich einen Fehler sehe, lege ich den Finger in die Wunde – ohne Weichspüler."
  },
  {
    question: "Ist die SEO-Sprechstunde der beste Einstieg?",
    answer: "Absolut! In der 2-stündigen SEO-Sprechstunde legen wir deine Website live auf den Grill. Es ist der perfekte Weg, um sich kennenzulernen und direkt herauszufinden, ob wir zusammenpassen. Du bekommst sofort handfeste Optimierungspotenziale und einen konkreten Maßnahmenplan. Danach entscheiden wir, ob und wie wir mit festen Paketen weitermachen."
  },
  {
    question: "Was, wenn ich auch Hilfe bei Tracking, Programmierung oder Social Media brauche?",
    answer: "Als erfahrener Stratege konzentriere ich mich auf meine Kerndisziplinen: SEO und Google Ads. Da baue ich dir messerscharfe Kampagnen. Aber ich lasse dich auch beim Rest nicht im Regen stehen: Ich bringe mein eingespieltes <strong>Freelancer-Team</strong> mit. Für Disziplinen wie komplexes Tracking, Programmierung, E-Mail Marketing oder Social Media greife ich auf ein Netzwerk absoluter Top-Experten zurück. Du bekommst Agentur-Power, aber mit der Flexibilität von Freelancern."
  },
  {
    question: "Bietest du auch eine neutrale Zweitmeinung zu bestehender Agenturarbeit an?",
    answer: "Ja, sehr häufig sogar. Wenn du dir unsicher bist, ob deine aktuelle SEO-Agentur wirklich den bestmöglichen Job macht, oder du ein vorliegendes Angebot prüfen lassen willst, werfe ich einen neutralen Blick darauf. Ich berate immer fair, transparent und objektiv – auch wenn das bedeutet, der anderen Agentur ein Lob auszusprechen."
  },
  {
    question: "Was kostet die weitere Zusammenarbeit nach der Sprechstunde?",
    answer: "Ich arbeite mit transparenten, pauschalen Paketen. Nach der Sprechstunde (480€) nutzen viele das <strong>10-Stunden Paket (1.920€)</strong> für die Umsetzung von Setups und technischen Audits. Für langfristiges, strategisches Wachstum biete ich einen <strong>monatlichen Retainer (ab 1.920€)</strong> an. Keine versteckten Kosten."
  },
  {
    question: "Wie steht es um KI im SEO? Lohnt sich klassisches SEO noch?",
    answer: "Klassisches SEO (nur Links und Keywords) liegt auf der Intensivstation. Wir bewegen uns in Richtung <strong>GEO (Generative Engine Optimization)</strong>. KI-Modelle brauchen echte Experten (E-E-A-T), um dich als verlässliche Quelle zu zitieren. Wer meint, mit generischem KI-Content den Markt dominieren zu können, wird scheitern. Wir setzen auf tiefgreifenden Kontext und echte Autorität."
  }
];

const offers = [
  {
    name: "SEO Sprechstunde (480€)",
    description: "2 Stunden Live-Analyse und Tacheles – der perfekte Einstieg zum Kennenlernen."
  },
  {
    name: "Technisches, Inhaltliches & Strategisches SEO",
    description: "Ganzheitliche SEO-Strategie von Core Web Vitals bis hin zur E-E-A-T Optimierung."
  },
  {
    name: "Neutrale Zweitmeinung (240€/h)",
    description: "Ehrliche und objektive Prüfung bestehender SEO-Maßnahmen oder Agentur-Angebote."
  },
  {
    name: "10-Stunden Paket (1.920€)",
    description: "Flexibles Leistungspaket für Audits, Setup und punktuelles Troubleshooting (1.920€ Pauschal)."
  },
  {
    name: "Monatlicher Retainer (ab 1.920€)",
    description: "Laufende strategische Betreuung und Optimierung für nachhaltiges Wachstum (ab 1.920€ monatlich)."
  },
  {
    name: "Freelancer Team Setup",
    description: "Vermittlung und Koordination von Experten für Tracking, Programmierung, E-Mail Marketing und Social Media."
  }
];
---

<Layout title={title} description={description} lcpImage={heroImage.src} ogImage={heroImage.src}>
  <!-- Hero Section -->
  <section class="section-hero relative overflow-hidden bg-white pt-12">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-3/5 z-10">
          <div class="flex flex-wrap items-center gap-x-4 mb-4">
            <p class="subheadline uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent inline-block px-4 py-1 rounded-full">
              Moin! Ich bin Jörg.
            </p>
            {lastReviewed && (
              <span class="text-gray-muted text-xs font-normal italic border-l border-gray-200 pl-4">Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            )}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold text-dark mb-6 leading-normal">
            Dein <span class="highlight">SEO Freelancer</span> & Stratege für echtes Wachstum.
          </h1>
          <p class="text-lg md:text-xl text-gray-700 max-w-2xl mb-10 leading-relaxed">
            Kein Bullshit-Bingo. Keine PDF-Wüsten. Ich vereine <strong>technisches, inhaltliches und strategisches SEO</strong> aus 25 Jahren Erfahrung. Wenn ich deine Website auf den Grill lege, gibt es ehrliches Tacheles – fair, transparent und 100% fokussiert auf deinen Business-Nutzen.
          </p>
          
          <!-- Social Proof Badges -->
          <div class="flex flex-wrap gap-4 mb-10 items-center">
            <div class="flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-lg border border-gray-100">
              <span class="text-yellow-400 text-xl">★★★★★</span>
              <span class="text-sm font-bold text-dark">5.0 Google</span>
            </div>
            <div class="flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-lg border border-gray-100">
              <span class="text-blue-600 font-bold">in</span>
              <span class="text-sm font-bold text-dark">Top LinkedIn Reviews</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={`${baseUrl}/seo-sprechstunde/`} class="btn-primary text-center" title="Zur SEO Sprechstunde (2026)">
              Zum besten Einstieg: Die Sprechstunde
            </a>
            <a href="#ansatz" class="btn-secondary text-center scroll-smooth" title="Mein Ansatz (2026)">
              Warum ein Freelancer?
            </a>
          </div>
        </div>
        <div class="md:w-2/5">
          <Image
            src={heroImage}
            alt="Jörg Zimmer auf der OMR - SEO Stratege"
            width={600}
            class="w-full h-auto rounded-3xl shadow-2xl border-4 border-white object-cover object-top"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 1: Intro & Agentur vs Freelancer -->
  <section id="ansatz" class="section bg-gray-50 pt-24 pb-24">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-start">
        <div class="lg:w-2/3 prose prose-lg max-w-none text-gray-800">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-8 border-b-2 border-lime-accent pb-4 inline-block">Warum ein SEO Stratege statt einer Agentur?</h2>
          
          <p class="mb-8 leading-relaxed">
            Stell dir vor, du gehst mit Schmerzen zum Arzt und wirst stattdessen von einem Auszubildenden operiert, während der Chefarzt nur auf der Rechnung steht. Genau das passiert in vielen klassischen SEO-Agenturen.
          </p>

          <p class="mb-8 leading-relaxed">
            Bei mir kaufst du keine anonyme "Maschinerie", sondern <strong>25 Jahre komprimierte Erfahrung</strong> (ich bin seit 2001 dabei – damals war Google noch ein Experiment). Du arbeitest direkt mit mir. Wenn ich einen technischen Knoten finde, rede ich nicht um den heißen Brei herum. Es gibt Tacheles.
          </p>

          <div class="my-8 bg-lime-accent/10 border-l-4 border-lime-600 p-6 rounded-r-lg">
            <h4 class="font-bold text-lime-800 mb-2">Die unabhängige Zweitmeinung</h4>
            <p class="text-dark mb-0 leading-relaxed">Du bist bereits bei einer Agentur, aber der Traffic stagniert? Deine Entwickler sagen "das geht nicht"? Ich biete mich oft als <strong>neutrale Instanz und ehrliche Zweitmeinung</strong> an. Ich prüfe Setup und Strategie absolut objektiv und fair. Manchmal reicht ein Blick von außen, um den Knoten platzen zu lassen.</p>
          </div>

          <h3 class="text-2xl font-bold mt-16 mb-6">Mehr als nur SEO & Ads: Mein Freelancer-Team</h3>
          <p class="mb-8 leading-relaxed">
            Ich kenne meine Stärken: Neben SEO baue ich auch messerscharfe Google Ads Kampagnen. Was ich aber nicht kann, mache ich auch nicht. Und da lasse ich dich nicht hängen: Für komplexe Tracking-Setups, harte Programmierung, E-Mail Marketing oder Social Media bringe ich mein <strong>vertrautes Freelancer-Team</strong> mit an den Tisch. Top-Experten in ihren Disziplinen. So bekommst du Full-Service-Qualität ohne den starren Agentur-Overhead.
          </p>
        </div>
        
        <!-- Sidebar mit persönlichem Bild -->
        <div class="lg:w-1/3">
          <div class="sticky top-32">
            <Image
              src={joergInterview}
              alt="Jörg Zimmer im SEOPRESSO Podcast Interview"
              width={600}
              class="w-full h-auto rounded-3xl shadow-xl border-4 border-white mb-6 object-cover object-top aspect-[3/4]"
              format="webp"
            />
            <p class="text-sm text-center text-gray-muted italic px-4">Jörg Zimmer: Digitaler Dinosaurier & Klartext-Redner.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Bewertungen -->
  <div class="py-12 bg-white border-t border-gray-100">
    <div class="container-narrow text-center mb-8">
      <p class="subheadline">Was meine Kunden sagen</p>
      <p class="text-gray-muted max-w-2xl mx-auto">Überzeug dich selbst von den Erfahrungen meiner Kunden auf meinem <a href="https://www.google.com/search?q=j%C3%B6rg+zimmer+seo" target="_blank" class="text-lime-700 underline font-bold">Google Unternehmensprofil</a> oder bei <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" class="text-lime-700 underline font-bold">LinkedIn</a>.</p>
    </div>
    <Testimonials />
  </div>

  <!-- Content Section 2: Die 3 Säulen meiner SEO-Beratung -->
  <section class="section bg-white pt-24 pb-24">
    <div class="container-narrow">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-12 text-center">Meine Methodik: Ganzheitliche SEO-Strategie</h2>
      
      <p class="text-lg text-gray-700 text-center max-w-4xl mx-auto mb-16 leading-relaxed">
        Nachhaltiges SEO ruht auf drei starken Säulen. Wenn eine wackelt, bricht das ganze Konstrukt zusammen. Ich sorge dafür, dass dein Fundament aus Beton ist.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Säule 1 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Technisches SEO</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Bevor wir über Rankings reden, muss der Pfusch am Bau weg. Eine langsame, fehlerhafte Website verbrennt jeden Tag Umsatz.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Core Web Vitals & Ladezeit</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Indexierungs-Strategien</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Relaunch-Sicherheit & Redirects</li>
          </ul>
        </div>

        <!-- Säule 2 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Inhaltliches SEO</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Niemand hat Zeit für generische Textwüsten. Content muss messerscharf Suchintentionen erfüllen und echten Business-Nutzen liefern.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Informationsarchitektur</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Content Audits & Zombie-Pages</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Usability & Conversion-Fokus</li>
          </ul>
        </div>

        <!-- Säule 3 -->
        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 hover:border-lime-500 transition-colors group">
          <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Strategisches SEO</h3>
          <p class="text-gray-700 leading-relaxed mb-6">
            Wir bauen einen Burggraben um deine Marke. Entitäten, Autorität und Signale, die dich auch im KI-Zeitalter relevant halten.
          </p>
          <ul class="space-y-4 text-gray-dark list-none pl-0">
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> E-E-A-T Optimierung</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Entitäten- & Themencluster</li>
            <li class="flex items-start gap-2"><svg class="w-5 h-5 text-lime-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Interne Link-Struktur</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section 3: AI & Google KI-Modus -->
  <section class="section bg-dark text-white pt-24 pb-24 relative overflow-hidden">
    <!-- Decorative element -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-lime-accent rounded-full opacity-5 blur-[120px] pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
    
    <div class="container-narrow position-relative z-10">
      <div class="prose prose-lg prose-invert max-w-none">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
          <div class="lg:col-span-7">
            <h2 class="text-3xl md:text-5xl font-bold mb-6 !text-white !border-lime-accent !pb-4">Bereit für den Google KI-Modus?</h2>
            <p class="leading-relaxed text-gray-300">
              Klassisches SEO (Keywords reinstopfen und Links kaufen) funktioniert nicht mehr. Die Zukunft heißt <strong>Generative Engine Optimization (GEO)</strong>. KI-Modelle wie Gemini oder ChatGPT brauchen echten Kontext und überprüfbare Autorität, um deine Inhalte als Antworten auszuspielen.
            </p>
            <p class="leading-relaxed text-gray-300 mt-6">
              Wer heute noch versucht, Google mit billig generiertem KI-Content auszutricksen, spielt mit seiner Existenz. Wir müssen Entitäten aufbauen. Informationsdichte erhöhen. Echte Meinungsstärke zeigen. Nur so wirst du im neuen Web zur zitierwürdigen Quelle.
            </p>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-10">
            <Image
              src={joergPodcast}
              alt="Jörg Zimmer diskutiert über KI und SEO"
              width={800}
              class="rounded-3xl shadow-xl w-full h-[350px] object-cover object-top border-4 border-gray-800"
              format="webp"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Content Section 4: Workflow & Philosophie -->
  <section class="section bg-gray-50 pt-24 pb-12">
    <div class="container-narrow">
      <div class="flex flex-col lg:flex-row gap-16 items-center">
        
        <div class="lg:w-1/2">
          <Image
            src={joergWorking}
            alt="Jörg Zimmer am Arbeitsplatz - SEO Stratege"
            width={800}
            class="rounded-3xl shadow-lg w-full h-auto object-cover object-top"
            format="webp"
            loading="lazy"
          />
          <div class="mt-8 bg-lime-accent/10 border-l-4 border-lime-600 p-6 rounded-r-lg">
            <p class="font-bold text-lime-600 mb-2">💬 Jörgs SEO-Klartext</p>
            <p class="italic text-dark mb-0">"Die Jagd nach reinem Traffic ist der größte Fehler. Wir wollen keine digitalen Touristen, sondern qualifizierte Leads, die am Ende kaufen oder anfragen. Punkt. 🌻"</p>
          </div>
        </div>

        <div class="lg:w-1/2 prose prose-lg">
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">Der Ablauf: So arbeiten wir zusammen</h2>
          
          <p class="mb-8">
            Knebelverträge über 24 Monate? Nicht mit mir. Mein Ansatz basiert auf Vertrauen, Flexibilität und klaren Meilensteinen:
          </p>

          <ol class="space-y-6 text-gray-800">
            <li class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
              <strong class="text-lime-700 text-xl block mb-2 font-bold">1. Der Einstieg: Die SEO Sprechstunde</strong>
              Wir starten immer mit der <a href={`${baseUrl}/seo-sprechstunde/`} class="text-lime-700 underline font-extrabold hover:text-dark transition-colors">2-stündigen SEO Sprechstunde</a>. Ich lege deine Seite auf den Grill, wir besprechen die drängendsten Probleme live und schauen, ob die Chemie stimmt. Du gehst mit einem ersten harten Maßnahmenplan raus.
            </li>
            <li class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
              <strong class="text-lime-700 text-xl block mb-2 font-bold">2. Die Strategie: Das Setup</strong>
              Wenn wir weitermachen, nutze ich oft mein 10-Stunden Paket, um tief in die Technik abzutauchen (Deep-Dive Audit) und eine priorisierte Roadmap (nach ROI) zu bauen.
            </li>
            <li class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
              <strong class="text-lime-700 text-xl block mb-2 font-bold">3. Die Umsetzung: Flexibel oder Retainer</strong>
