---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import sprechstundeImage from '../assets/images/blog/seo-sprechstunde.jpg';
import ctaImage from '../assets/images/profile/joerg-zimmer-cta.jpg';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const faqs = [
  {
    question: "Lohnt sich SEO heute überhaupt noch für meine Nische?",
    answer: "Ja, absolut. Aber der Ansatz hat sich geändert. In der Sprechstunde analysieren wir, ob deine Nische durch KI-Antworten bedroht ist oder ob es noch genügend wertvollen Traffic gibt, den wir abgreifen können."
  },
  {
    question: "Was kostet SEO bei dir abseits der Sprechstunde?",
    answer: "Das hängt stark von der Größe deines Projekts ab. Pauschalpreise für Rankings sind oft unseriös. Meine Sprechstunde (400€) ist jedoch immer der perfekte, risikoarme Einstieg."
  },
  {
    question: "Bietest du feste SEO-Pakete und Retainer an?",
    answer: "Ja, für die konkrete Umsetzung arbeite ich mit klaren Paketen: Für fundierte Audits oder technische Setups gibt es das <strong>10-Stunden Paket für 1.600€</strong>. Für eine fortlaufende strategische Betreuung biete ich einen <strong>Monatlichen Retainer ab 1.600€ bis ca. 3.200€</strong> an. Die Pakete sind flexibel für SEO, SEA oder eine smarte Kombination anwendbar."
  },
  {
    question: "Soll ich für meinen Content voll auf KI setzen?",
    answer: "KI ist ein Werkzeug, kein kompletter Ersatz. Wir besprechen, wie du KI effizient einsetzt, ohne deine Marke zu schwächen oder von Google wegen minderwertigem Content abgestraft zu werden."
  },
  {
    question: "Kann ich auch nur 1 Stunde buchen und nur 200 € bezahlen?",
    answer: "Nein. Weil die Vorbereitung, das Kunden anlegen im System, die Rechnungstellung, die Kommunikation im Vorfeld und danach sowie das Einarbeiten ins Thema als administrativer Aufwand zählt und eingerechnet wird – daher immer 2 Stunden und 400 €."
  },
  {
    question: "Wie lange dauert es, bis ich die ersten Ergebnisse sehe?",
    answer: "Das hängt stark von der Konkurrenz und dem Zustand deiner Website ab. In der Regel sieht man bei technischen Quick-Wins Ergebnisse nach wenigen Wochen, bei Content-Strategien eher nach 3-6 Monaten."
  },
  {
    question: "Kann ich die Sprechstunde auch für einen Website-Relaunch nutzen?",
    answer: "Definitiv. Das ist sogar einer der besten Zeitpunkte, um teure Fehler bei der Struktur oder den Weiterleitungen zu vermeiden, bevor die neue Seite live geht."
  }
];
---

<Layout
  title="SEO-Sprechstunde | 2h Videocall für 400€ - Jörg Zimmer"
  description="2-stündige SEO-Sprechstunde per Videocall: Live-Analyse, sofort umsetzbare Tipps und ein konkreter Maßnahmenplan. 400€ pauschal, keine versteckten Kosten. ALOHA! 🌻"
  ogImage="/images/blog/seo-sprechstunde.jpg"
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3">
          <p class="subheadline mb-6">SEO-Sprechstunde</p>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8">
            2 Stunden geballtes
            <span class="highlight">SEO-Wissen.</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mb-10">
            Du schickst mir deine Website, ich bereite mich vor. Im Videocall gehen wir
            gemeinsam alles durch. Danach hast du einen konkreten Plan.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 items-start">
            <a href={`${baseUrl}/kontakt/`} class="btn-primary">
              Sprechstunde buchen
            </a>
            <div class="flex items-baseline gap-2">
              <span class="text-3xl font-bold text-dark">400€</span>
              <span class="text-gray-muted">pauschal</span>
            </div>
          </div>
        </div>
        <div class="md:w-1/3">
          <Image
            src={sprechstundeImage}
            alt="SEO-Sprechstunde mit Jörg Zimmer - 2 Stunden Videocall"
            width={800}
            height={800}
            class="w-full h-auto rounded-2xl shadow-lg"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- So läuft es ab -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Der Ablauf</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        In 4 Schritten zu deinem <span class="highlight">Maßnahmenplan</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl p-8">
          <div class="w-10 h-10 bg-lime-accent rounded-full flex items-center justify-center font-bold text-dark mb-4">1</div>
          <h3 class="text-xl font-bold mb-3">Termin buchen</h3>
          <p class="text-gray-muted">
            Schreib mir eine Nachricht in LinkedIn und ich schicke dir zwei drei Terminvorschläge für den Call.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8">
          <div class="w-10 h-10 bg-lime-accent rounded-full flex items-center justify-center font-bold text-dark mb-4">2</div>
          <h3 class="text-xl font-bold mb-3">Website & Fragen schicken</h3>
          <p class="text-gray-muted">
            Du schickst mir vorab deine URL und deine Fragen. Ich bereite mich gründlich vor. Bitte gib mir zur besseren Vorbereitung auch den Zugang zu deiner Google Search Konsole.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8">
          <div class="w-10 h-10 bg-lime-accent rounded-full flex items-center justify-center font-bold text-dark mb-4">3</div>
          <h3 class="text-xl font-bold mb-3">2h Videocall</h3>
          <p class="text-gray-muted">
            Live-Analyse mit Screensharing. Ich zeige dir meine SEO-Tools,
            identifiziere Lücken und Potenziale. Alle Fragen erlaubt.
          </p>
        </div>

        <div class="bg-white rounded-2xl p-8">
          <div class="w-10 h-10 bg-lime-accent rounded-full flex items-center justify-center font-bold text-dark mb-4">4</div>
          <h3 class="text-xl font-bold mb-3">Nachbereitung</h3>
          <p class="text-gray-muted">
            Du bekommst die Aufzeichnung, eine KI-Zusammenfassung und einen
            händischen Maßnahmenplan mit priorisierten Empfehlungen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Typische Inhalte -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-4">Inhalte</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        Das erwartet dich in der <span class="highlight">Sprechstunde</span>
      </h2>

      <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            SEO-Analyse deiner Website
          </h3>
          <ul class="space-y-2 text-gray-muted">
            <li class="flex items-start gap-2"><span>•</span> Technische Basics (Indexierung, Ladezeit, Core Web Vitals)</li>
            <li class="flex items-start gap-2"><span>•</span> OnPage-Optimierung (Meta-Tags, Überschriften, interne Verlinkung)</li>
            <li class="flex items-start gap-2"><span>•</span> Struktur & Informationsarchitektur</li>
            <li class="flex items-start gap-2"><span>•</span> Erste Einschätzung zu Ranking-Potenzial</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            Keyword- & Content-Strategie
          </h3>
          <ul class="space-y-2 text-gray-muted">
            <li class="flex items-start gap-2"><span>•</span> Welche Keywords sind realistisch?</li>
            <li class="flex items-start gap-2"><span>•</span> Suchintention richtig treffen</li>
            <li class="flex items-start gap-2"><span>•</span> Content-Struktur & Themencluster</li>
            <li class="flex items-start gap-2"><span>•</span> Priorisierung: Was bringt am schnellsten Ergebnisse?</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            Wettbewerbsanalyse
          </h3>
          <ul class="space-y-2 text-gray-muted">
            <li class="flex items-start gap-2"><span>•</span> Warum ranken andere besser?</li>
            <li class="flex items-start gap-2"><span>•</span> Welche Lücken kannst du nutzen?</li>
            <li class="flex items-start gap-2"><span>•</span> Quick-Wins vs. langfristige Strategie</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            Konkrete Handlungsempfehlungen
          </h3>
          <ul class="space-y-2 text-gray-muted">
            <li class="flex items-start gap-2"><span>•</span> To-Do-Liste mit Prioritäten</li>
            <li class="flex items-start gap-2"><span>•</span> Technische oder redaktionelle Maßnahmen</li>
            <li class="flex items-start gap-2"><span>•</span> Einschätzung von Aufwand vs. Nutzen</li>
          </ul>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100 lg:col-span-2">
          <h3 class="text-xl font-bold mb-4 flex items-center gap-3">
            Q&A-Format
          </h3>
          <p class="text-gray-muted mb-4">Du kannst alle Fragen stellen, zum Beispiel:</p>
          <div class="grid md:grid-cols-2 gap-4">
            <ul class="space-y-2 text-gray-muted">
              <li class="flex items-start gap-2"><span>•</span> Lohnt sich SEO noch in meiner Nische?</li>
              <li class="flex items-start gap-2"><span>•</span> Soll ich auf KI-Content setzen?</li>
            </ul>
            <ul class="space-y-2 text-gray-muted">
              <li class="flex items-start gap-2"><span>•</span> Kann ich auch nur eine Stunde buchen?</li>
              <li class="flex items-start gap-2"><span>•</span> Wie lange dauern Ergebnisse realistisch?</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Was du bekommst -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-4">Alles inklusive</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        Das bekommst du für <span class="highlight">400€</span>
      </h2>

      <div class="bg-lime-accent rounded-2xl p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-8">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">2 Stunden 1:1 Videocall</p>
                <p class="text-dark/70 text-sm">Persönlich, fokussiert, auf den Punkt</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">Gründliche Vorbereitung</p>
                <p class="text-dark/70 text-sm">Ich analysiere deine Website vorab</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">Live-Analyse mit SEO-Tools</p>
                <p class="text-dark/70 text-sm">Screensharing — du siehst alles</p>
              </div>
            </li>
          </ul>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">Aufzeichnung des Calls</p>
                <p class="text-dark/70 text-sm">Zum Nachschauen und Teilen im Team</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">KI-Zusammenfassung</p>
                <p class="text-dark/70 text-sm">Die wichtigsten Punkte auf einen Blick</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-dark flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <div>
                <p class="font-bold text-dark">Händischer Maßnahmenplan</p>
                <p class="text-dark/70 text-sm">Priorisiert — du weißt, was zuerst kommt</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section bg-gray-50">
    <div class="container-narrow">
      <p class="subheadline mb-4">Kundenstimmen</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        Was Kunden sagen
      </h2>

      <div class="space-y-8">
        <div class="bg-white rounded-2xl p-8">
          <blockquote class="text-lg text-gray-text mb-4">
            "Jörg ist herausragend: In wenigen Minuten hat er meine drängendsten Probleme
            in Sachen SEA und SEO identifiziert, Lösungsvorschläge gemacht und mich nicht,
            wie so oft bei anderen Dienstleistern erlebt, mit unklaren oder viel zu großen
            und detailversessenen Aufgaben zurückgelassen."
          </blockquote>
          <p class="font-bold text-dark">Martin Meng</p>
          <p class="text-sm text-gray-muted">CEO @konfidal</p>
        </div>

        <div class="bg-white rounded-2xl p-8">
          <blockquote class="text-lg text-gray-text mb-4">
            "Nach langem Überlegen eine 2-stündige SEO Sprechstunde mit Jörg gebucht.
            Das Gespräch war sehr gut strukturiert und Jörg war top auf unsere Website
            vorbereitet. Der Preis ist völlig gerechtfertigt und spiegelt seine
            25-jährige Erfahrung wieder."
          </blockquote>
          <p class="font-bold text-dark">Ronny A.</p>
          <p class="text-sm text-gray-muted">Local Guide, 182 Rezensionen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Für wen -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-4">Zielgruppe</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        Für wen lohnt sich die <span class="highlight">Sprechstunde?</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Selbstständige & Unternehmer</h3>
            <p class="text-gray-muted">Die verstehen wollen, wo sie SEO-technisch stehen oder bevor sie viel Budget investieren.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Website-Relaunch-Projekte</h3>
            <p class="text-gray-muted">Um von Anfang an die richtigen Weichen zu stellen und Ranking-Verluste zu vermeiden.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Shops mit stagnierendem Traffic</h3>
            <p class="text-gray-muted">Wenn die Umsätze nicht mehr wachsen und man die Ursachen im organischen Traffic finden will.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Marketing-Teams</h3>
            <p class="text-gray-muted">Die keine eigene SEO-Expertise im Haus haben oder eine unabhängige zweite Meinung brauchen.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Startups</h3>
            <p class="text-gray-muted">Die von Anfang an eine solide Basis schaffen und wissen wollen, wo sie anfangen sollen.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-lime-accent text-2xl mt-1">→</span>
          <div>
            <h3 class="font-bold text-dark mb-1">Alle mit konkreten Fragen</h3>
            <p class="text-gray-muted">Die klare Antworten und echte Handlungsempfehlungen statt allgemeines "Blabla" suchen.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema inside the Component -->
  <section class="section bg-white pt-16 pb-24" id="faq">
    <div class="container-narrow max-w-4xl mx-auto">
      <FAQAccordion faqs={faqs} />
    </div>
  </section>

  <!-- Vorbereitung -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-4">Vorbereitung</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">
        So holst du das <span class="highlight">Maximum</span> heraus
      </h2>
      
      <p class="text-lg text-gray-text mb-10 max-w-2xl">
        Damit wir in den 2 Stunden keine Zeit verlieren, empfehle ich dir folgende Vorbereitung:
      </p>

      <div class="bg-lime-accent rounded-3xl p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-8">
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-dark text-white rounded-full flex items-center justify-center flex-shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg></div>
              <div>
                <p class="font-bold text-dark text-lg">Liste deine wichtigsten Fragen vorab</p>
                <p class="text-dark/70">Was brennt dir unter den Nägeln? Was wolltest du schon immer mal wissen?</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-dark text-white rounded-full flex items-center justify-center flex-shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg></div>
              <div>
                <p class="font-bold text-dark text-lg">Definiere dein Ziel</p>
                <p class="text-dark/70">Willst du mehr Leads, mehr Traffic oder einfach nur bessere Rankings für bestimmte Keywords?</p>
              </div>
            </li>
          </ul>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-dark text-white rounded-full flex items-center justify-center flex-shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg></div>
              <div>
                <p class="font-bold text-dark text-lg">Zugriff gewähren</p>
                <p class="text-dark/70">Stelle nach Möglichkeit Zugriff auf Analytics & Search Console bereit.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-dark text-white rounded-full flex items-center justify-center flex-shrink-0 mt-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg></div>
              <div>
                <p class="font-bold text-dark text-lg">Wettbewerber nennen</p>
                <p class="text-dark/70">Sammle 2–3 direkte Wettbewerber, die wir uns gemeinsam ansehen können.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer.replace(/<[^>]*>?/gm, '')
      }
    }))
  })} />

  <!-- CTA -->
  <section class="section bg-dark text-white">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/3">
          <Image
            src={ctaImage}
            alt="Jörg Zimmer - SEO-Sprechstunde buchen"
            width={575}
            height={1020}
            class="w-48 h-48 md:w-full md:h-auto object-cover object-top rounded-2xl mx-auto"
            loading="lazy"
          />
        </div>
        <div class="md:w-2/3 text-center md:text-left">
          <p class="subheadline mb-4 text-gray-400">Bereit?</p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            Lass uns deine Website auf den Grill legen.
          </h2>
          <p class="text-gray-400 mb-4">
            2 Stunden, 400€, keine versteckten Kosten. Keine langfristige Bindung.
            Einfach 20+ Jahre SEO-Wissen, auf den Punkt gebracht.
          </p>
          <p class="text-gray-400 mb-8">
            Schreib mir eine Nachricht und wir finden einen Termin.
          </p>
          <a href={`${baseUrl}/kontakt/`} class="btn-primary">
            Jetzt Sprechstunde buchen
          </a>
