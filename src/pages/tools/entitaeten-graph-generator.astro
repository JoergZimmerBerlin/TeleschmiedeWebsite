---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import ogHeroImage from '../../assets/images/glossar/3d-light/glossar-schema-org-markup-3d.webp';
import { getGitModDate } from '../../utils/git-date';
import { getImage } from 'astro:assets';

const lastReviewed = getGitModDate('src/pages/tools/entitaeten-graph-generator.astro');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const optimizedOgImage = await getImage({ src: ogHeroImage, format: 'webp', width: 1200, height: 630 });
---

<Layout 
  title="Entitäten Graph Generator: Schema.org @graph aus Prompt (2026)"
  description="Erstelle mit nur einer Domain-Eingabe den perfekten Master-Prompt für KI-Agenten: On-Page-Crawl, 2-Punkte-Triangulation, 800+ Schema-Typen & Zero-Hallucination JSON-LD. (2026)"
  ogImage={optimizedOgImage.src}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-gray-100 py-3 border-b border-gray-200 text-sm" aria-label="Breadcrumb">
    <div class="container mx-auto px-4 max-w-4xl flex items-center gap-2 text-gray-600">
      <a href={`${baseUrl}/`} class="hover:text-dark transition-colors" title="Home">Home</a>
      <span>/</span>
      <a href={`${baseUrl}/tools/`} class="hover:text-dark transition-colors" title="Tools">Tools</a>
      <span>/</span>
      <span class="text-dark font-medium">Entitäten Graph Generator</span>
    </div>
  </nav>

  <section class="py-12 md:py-24 bg-gray-50 min-h-[80vh]">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-lime-100/80 border border-lime-300 text-lime-900 text-xs md:text-sm font-bold uppercase tracking-wider mb-4">
          <span>🧠 Universeller Multi-Schienen Generator</span>
          <span>•</span>
          <span>AI Knowledge Graph 2026</span>
        </div>
        <h1 class="font-bold mb-4 font-headings text-4xl md:text-5xl lg:text-5xl text-dark tracking-tight leading-tight">
          Entitäten Graph Generator
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          Gib einfach deine Domain ein. Unser gehärteter Multi-Schienen Master-Prompt schickt deinen KI-Agenten auf ein universelles Entity-Audit für alle Firmentypen und Webseiten-Architekturen: 
          On-Page-Crawl, 2-Punkte-Triangulation ungelinkter Profile im Web, 800+ Schema-Typen-Filter und ein 100&nbsp;% valider, vernetzter <code class="text-lime-800 bg-lime-100 px-1.5 py-0.5 rounded font-mono text-base">@graph</code> JSON-LD Code.
        </p>
      </div>

      <!-- KI Prompt Generator Box -->
      <div class="bg-white p-6 md:p-10 rounded-3xl shadow-xl border border-gray-100 mb-12">
        <h2 class="text-2xl font-bold mb-3 flex items-center gap-2">
          <svg class="w-6 h-6 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          1. Ziel-Domain eingeben
        </h2>
        <p class="text-gray-600 text-sm mb-6">
          Keine Formulare, keine Dropdowns. Der Agent analysiert dein Geschäftsmodell, den Tech-Stack und deine Entitäten vollautomatisch.
        </p>
        
        <div class="flex flex-col md:flex-row gap-4 mb-8">
          <input 
            type="url" 
            id="target-url" 
            placeholder="https://deine-website.de/" 
            class="flex-1 px-4 py-3.5 rounded-xl border-gray-300 bg-gray-50 focus:ring-lime-accent focus:border-lime-accent text-lg font-medium shadow-inner"
            aria-label="Ziel-Domain oder Website-URL"
          >
          <button 
            id="btn-generate"
            class="bg-dark text-lime-accent font-bold px-8 py-3.5 rounded-xl hover:bg-black transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-base shrink-0 cursor-pointer"
          >
            <span>Audit-Prompt generieren</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div id="output-card" class="relative group">
          <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" /></svg>
            2. Gehärteten Master-Prompt kopieren
          </h2>
          <textarea 
            id="prompt-output" 
            class="w-full h-[450px] p-6 bg-gray-900 text-gray-100 rounded-xl font-mono text-xs md:text-sm leading-relaxed resize-y border border-gray-800 focus:outline-none"
            readonly
            placeholder="Klicke oben auf 'Audit-Prompt generieren', um deinen individuellen Entitäten-Prompt zu erstellen..."
          ></textarea>
          <button 
            id="btn-copy"
            class="absolute top-12 right-4 bg-lime-accent text-dark px-4 py-2.5 rounded-lg font-bold hover:bg-lime-400 transition-all flex items-center gap-2 shadow-lg cursor-pointer"
            title="Prompt in Zwischenablage kopieren"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            <span>In Zwischenablage kopieren</span>
          </button>
          <p id="copy-success" class="text-lime-600 font-bold mt-2 hidden text-right flex items-center justify-end gap-1 text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            Kopiert! Jetzt in ChatGPT Plus, Claude 3.7 oder Antigravity einfügen.
          </p>
        </div>

        <!-- Schritt 3: Ausführung -->
        <div class="mt-8 pt-8 border-t border-gray-100">
          <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            3. Prompt in deinen KI-Agenten einfügen & Code erhalten
          </h2>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            Füge den generierten Text einfach in <strong>ChatGPT Plus (mit Web-Browsing)</strong>, <strong>Claude 3.7 Sonnet (mit Web Search)</strong>, <strong>Perplexity Pro</strong> oder in Coding-Assistenten wie <strong>Cursor / Antigravity</strong> ein. Der Agent führt den 5-Pfade-Crawl, die externe Webrecherche und die Synthese völlig autonom durch.
          </p>
          <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 text-xs text-gray-700 flex flex-wrap items-center justify-between gap-2">
            <span class="font-bold text-dark">Empfohlene Agenten:</span>
            <span class="bg-white px-2 py-1 rounded border border-gray-200 font-medium">ChatGPT Plus (GPT-4.5 / Search)</span>
            <span class="bg-white px-2 py-1 rounded border border-gray-200 font-medium">Claude 3.7 Sonnet (Extended Thinking)</span>
            <span class="bg-white px-2 py-1 rounded border border-gray-200 font-medium">Perplexity Pro</span>
            <span class="bg-white px-2 py-1 rounded border border-gray-200 font-medium">Antigravity / Cursor</span>
          </div>
        </div>
      </div>

      <!-- Erklärungen & Deep-Dive Content -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-bold mb-3 text-dark font-headings">Warum isolierte Schemas tot sind</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Klassische SEO-Plugins erzeugen oft isolierte Snippets: Ein Organization-Block auf der Startseite, ein Autor auf Blogposts und eine LocalBusiness-Angabe im Impressum. Für Suchmaschinen wie Google und KI-Engines wie Perplexity oder ChatGPT fehlen hier die semantischen Brücken.
            </p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Der <a href={`${baseUrl}/glossar/technisches-schema-markup/`} class="font-bold text-lime-700 hover:underline">technische Schema.org @graph</a> verbindet alle Entitäten flach über eindeutige <code class="bg-gray-100 text-dark px-1.5 py-0.5 rounded font-mono text-xs">@id</code>-Fragmente. So begreift die KI sofort: Wer gründete die Firma? Welche Autoren publizieren welche Fachgebiete? Welche Dienstleistungen gehören zu welchem Katalog?
            </p>
          </div>
          <div class="bg-lime-50/70 p-4 rounded-2xl border border-lime-200/80 text-xs text-lime-900 mt-4">
            <span class="font-bold">Kombinations-Tipp:</span> Ergänze deinen unsichtbaren Wissensgraphen mit einer sichtbaren Faktenseite über unseren <a href={`${baseUrl}/tools/groundingpage-generator/`} class="font-bold text-dark hover:underline">Grounding Page Generator</a>!
          </div>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-bold mb-3 text-dark font-headings">Die 2-Punkte-Triangulation</h3>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              90&nbsp;% aller Unternehmen verlinken im Footer nur einen Bruchteil ihrer wahren Online-Präsenz. Autoren haben Fachprofile, die Firmen stehen bei North Data oder im Handelsregister, Podcasts und YouTube-Interviews bleiben auf der eigenen Website unerwähnt.
            </p>
            <p class="text-gray-600 text-sm leading-relaxed">
              Unser Master-Prompt instruiert den Agenten, diese verstreuten „Dark-Matter-Daten“ aktiv im Web zu scouten. Um Halluzinationen auszuschließen, greift die <strong>2-Punkte-Triangulation</strong>: Ein externes Profil wird nur übernommen, wenn Name <em>und</em> ein zweites Merkmal (z.&nbsp;B. Arbeitgeber, Stadt oder verlinkte Domain) zweifelsfrei übereinstimmen.
            </p>
          </div>
          <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 text-xs text-gray-600 mt-4">
            <span class="font-bold text-dark">Zero-Hallucination:</span> Zweifelsfälle oder nicht zweifelsfrei zuzuordnende Profile wandern in eine Quarantäne-Tabelle und werden niemals als falscher Code ausgespielt.
          </div>
        </div>
      </div>

      <!-- Detail-Features: Die 6 Säulen der Universellen Multi-Schienen-Architektur -->
      <div class="bg-white p-8 md:p-10 rounded-3xl shadow-sm border border-gray-100 mb-12">
        <h3 class="text-2xl font-bold mb-2 text-dark font-headings">
          Universelle Multi-Schienen-Architektur: Für jedes Szenario & jede Website
        </h3>
        <p class="text-gray-600 text-sm mb-8 max-w-2xl">
          Egal ob Solopreneur, mittelständischer Handwerksbetrieb, börsennotierte Holding oder Online-Shop: Der Generator passt sich autonom an jedes Geschäftsmodell an.
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">🌐</div>
            <h4 class="font-bold text-dark text-base mb-2">Universelle Schienen-Matrix</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Beherrscht alle Organisationsformen (Freelancer, KMU, Konzerne via <code class="font-mono text-[11px]">parentOrganization</code>, Vereine, NGOs, Universitäten, SaaS & Shops) sowie Architekturen (Multi-Page, One-Pager & Subdomains).
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">🛡️</div>
            <h4 class="font-bold text-dark text-base mb-2">Anti-Homonym & Zero-Hallucination</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Strikter Domain-Anker: Die On-Page-Fakten deiner Website stechen jede externe Websuche. Verhindert fatale Verwechslungen mit namensgleichen Fremdfirmen an fremden Standorten.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">🔎</div>
            <h4 class="font-bold text-dark text-base mb-2">Dynamisches Pfad-Mining</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Kein Scheitern an unkonventionellen Pfaden: Inspiziert den Quelltext nach Impressum, Legal Notice, Sprach-Präfixen (<code class="font-mono text-[11px]">/de/impressum/</code>, <code class="font-mono text-[11px]">/imprint/</code>), Ankern & Modals.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">🌳</div>
            <h4 class="font-bold text-dark text-base mb-2">800+ Typen-Hierarchie</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Drillt bis zur tiefsten spezifischen Subklasse aus dem <a href={`${baseUrl}/glossar/schema-org-markup/`} class="text-lime-700 font-bold hover:underline">Schema.org Markup</a> (z.&nbsp;B. <code class="font-mono text-[11px]">ProfessionalService</code>, <code class="font-mono text-[11px]">OnlineStore</code> oder <code class="font-mono text-[11px]">SoftwareApplication</code>).
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">⚖️</div>
            <h4 class="font-bold text-dark text-base mb-2">Validator Pre-Flight Gate</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Prüft vor Ausgabe alle Schema.org Domain/Range-Restriktionen (<code class="font-mono text-[11px]">geo</code>, <code class="font-mono text-[11px]">openingHours</code> nur auf LocalBusiness/Place), bannt Pseudo-Typen und sichert 0 Fehler.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="text-2xl mb-2">🎯</div>
            <h4 class="font-bold text-dark text-base mb-2">2-Punkte-Triangulation & Wikidata</h4>
            <p class="text-xs text-gray-600 leading-relaxed mb-0">
              Spürt ungelinkte Register- und Profildaten im Web auf und validiert sie über 2 unabhängige Datenpunkte. Schützt den <a href={`${baseUrl}/glossar/knowledge-graph/`} class="text-lime-700 font-bold hover:underline">Knowledge Graph</a> vor Fehlinformationen.
            </p>
          </div>
        </div>
      </div>

      <!-- Offizielle Master-Zitatbox (Semantisches E-E-A-T Zitat von Jörg Zimmer) -->
      <figure class="my-12 bg-neutral-50 border border-neutral-200 p-6 md:p-8 rounded-2xl shadow-sm">
        <div class="flex items-center gap-4 mb-4">
          <Image 
            src={portraitImage} 
            alt="Jörg Zimmer - Senior SEO & AI Search Consultant" 
            class="w-14 h-14 rounded-full object-cover object-top shadow-sm border-2 border-lime-accent" 
            width={56} 
            height={56} 
            loading="lazy"
          />
          <div>
            <h4 class="font-bold text-base md:text-lg text-dark mb-0">Jörg Zimmer</h4>
            <p class="text-xs md:text-sm text-neutral-600 mb-0">Senior SEO & AI Search Consultant</p>
          </div>
        </div>
        <blockquote class="text-base md:text-lg text-dark leading-relaxed italic border-l-4 border-lime-accent pl-4 my-4 font-normal">
          „Es gibt tausende SEO Tools, die die Arbeit der Suchmaschinenoptimierer nicht überflüssig machen. Sie zeigen dir nur die Möglichkeiten und erleichtern das Leben.“
        </blockquote>
        <figcaption class="mt-4 pt-3 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-500">
          <span>Experten-Zitat • <cite class="not-italic font-semibold text-neutral-700">Jörg Zimmer</cite></span>
          <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" rel="noopener noreferrer" class="font-bold text-lime-700 hover:underline inline-flex items-center gap-1">
            Jörg Zimmer auf LinkedIn folgen →
          </a>
        </figcaption>
      </figure>

      <!-- FAQ Section -->
      <div class="mt-16 max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-8 font-headings">Häufig gestellte Fragen (FAQ)</h2>
        <div class="space-y-4">
          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Was unterscheidet diesen Generator von klassischen Schema-Tools?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
              Klassische Generatoren sind starre Formulare: Sie verlangen von dir, Namen, URLs und Beschreibungen per Hand einzutippen. Der <strong>Entitäten Graph Generator</strong> hingegen schickt einen KI-Agenten los, der deine Domain eigenständig crawlt, das Web nach verwaisten Profilen (LinkedIn, Handelsregister, Podcasts) absucht und die Entitäten über eine 2-Punkte-Triangulation verifiziert. Das spart Stunden manueller Arbeit und verhindert Halluzinationen.
            </div>
          </details>

          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Warum setzt das Tool auf einen vernetzten @graph statt einzelner Blöcke?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
              Ein flaches <code class="bg-gray-100 px-1 py-0.5 rounded font-mono text-xs">@graph</code>-Array verbindet alle Knoten (Organization, WebSite, Personen, Dienstleistungen) über eindeutige <code class="bg-gray-100 px-1 py-0.5 rounded font-mono text-xs">@id</code>-URIs. Suchmaschinen wie Google und AI-Bots wie Perplexity verstehen damit sofort die Zusammenhänge – ohne dass es zu Zirkelbezügen oder unleserlichen Verschachtelungen kommt. Dies ist das Fundament für erfolgreiches <a href={`${baseUrl}/glossar/entity-seo/`} class="font-bold text-lime-700 hover:underline">Entity SEO</a>.
            </div>
          </details>

          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Wie verhindert der Prompt falsche Social-Links und erfundene Wikidata-IDs?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
              Der Master-Prompt erzwingt das <strong>Zero-Hallucination Protocol</strong>: Social-Profile dürfen nur übernommen werden, wenn die Ziel-Domain im Profil verlinkt ist oder der Quelltext der Website den Link enthält. Bei Wikidata muss die offizielle Website (Property P856) mit der eingegebenen Domain übereinstimmen. Gibt es keinen Eintrag, verbietet der Prompt das Erfinden von IDs und empfiehlt stattdessen die saubere Neuanlage.
            </div>
          </details>

          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Wo binde ich den generierten JSON-LD Code auf meiner Website ein?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
              Kopiere den fertigen <code class="bg-gray-100 px-1 py-0.5 rounded font-mono text-xs">&lt;script type="application/ld+json"&gt;</code>-Block einfach in den <code class="bg-gray-100 px-1 py-0.5 rounded font-mono text-xs">&lt;head&gt;</code> deiner Startseite oder als globale Header-Komponente deines CMS (z.&nbsp;B. via WordPress Theme Options, Astro Layout oder Google Tag Manager).
            </div>
          </details>

          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Was passiert bei brandneuen Domains, die noch keine Webtreffer haben?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
              Findet der Agent bei der externen Webrecherche keine Bestätigungen, dichtet er keine Autorität hinzu. Er generiert einen soliden, fehlerfreien Basis-Graphen aus den On-Page-Fakten und liefert dir im Report einen <strong>5-Schritte-Fahrplan</strong>, welche Register und Profile (z.&nbsp;B. Google Unternehmensprofil, Crunchbase, Branchenkammer) du anlegen solltest, um deine Entität im Netz zu verankern.
            </div>
          </details>

          <details class="bg-white rounded-2xl shadow-sm border border-gray-100 group">
            <summary class="flex items-center justify-between cursor-pointer list-none p-6 font-bold text-lg [&::-webkit-details-marker]:hidden">
              Funktioniert das Tool auch für Solo-Selbstständige, One-Pager oder internationale Konzerne?
              <span class="transition group-open:rotate-180">
                <svg fill="none" class="h-6 w-6 text-gray-500" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </span>
            </summary>
            <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed text-sm">
