---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import { getImage } from 'astro:assets';
import ogHeroImage from '../../assets/images/blog/blog-ai-search-tools-3d.webp';
import { getGitModDate } from '../../utils/git-date';

const lastReviewed = getGitModDate('src/pages/tools/index.astro') || '2026-09-09';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const optimizedOgImage = await getImage({ src: ogHeroImage, format: 'webp', width: 1200, height: 630 });

const pageTitle = "SEO & AI Tools: Jörgs Werkzeugkasten & Empfehlungen (2026)";
