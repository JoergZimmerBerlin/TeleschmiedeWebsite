---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import portraitImage from '../../assets/images/profile/joerg-zimmer-portrait.webp';
import ogHeroImage from '../../assets/images/glossar/3d-light/glossar-schema-org-markup-3d.webp';
import { getGitModDate } from '../../utils/git-date';
import { getImage } from 'astro:assets';

const lastReviewed = getGitModDate('src/pages/tools/schema-graph-visualizer.astro');
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const optimizedOgImage = await getImage({ src: ogHeroImage, format: 'webp', width: 1200, height: 630 });
---

<Layout 
  title="Schema-Graph-Visualizer: Entity Health Check & Dateninseln-Radar (2026)"
  description="Gib deine Domain ein und visualisiere deinen gesamten Schema.org Knowledge Graph: Entlarve isolierte Dateninseln, prüfe den 3-Ebenen Entity Health Score und vergleiche Ist- mit Soll-Zustand. (2026)"
  ogImage={optimizedOgImage.src}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-gray-100 py-3 border-b border-gray-200 text-sm" aria-label="Breadcrumb">
    <div class="container mx-auto px-4 max-w-5xl flex items-center gap-2 text-gray-600">
      <a href={`${baseUrl}/`} class="hover:text-dark transition-colors" title="Home">Home</a>
      <span>/</span>
      <a href={`${baseUrl}/tools/`} class="hover:text-dark transition-colors" title="Tools">Tools</a>
      <span>/</span>
      <span class="text-dark font-medium">Schema-Graph-Visualizer</span>
    </div>
  </nav>

  <section class="py-12 md:py-20 bg-gray-50 min-h-[85vh]">
    <div class="container mx-auto px-4 max-w-5xl">
      
      <!-- Hero Header -->
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-lime-100/80 border border-lime-300 text-lime-900 text-xs md:text-sm font-bold uppercase tracking-wider mb-4 shadow-sm">
          <span>🔬 Live Entity Inspector</span>
          <span>•</span>
          <span>W3C JSON-LD 1.1 Standard (2026)</span>
        </div>
        <h1 class="font-bold mb-4 font-headings text-3xl md:text-5xl lg:text-5xl text-dark tracking-tight leading-tight">
          Schema-Graph-Visualizer
        </h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Wie gut versteht Google dein Unternehmen wirklich? Gib deine Domain ein: Mein Archetypen-Sampler scannt deine Startseite sowie repräsentative Unterseiten, entlarvt isolierte <strong class="text-dark font-semibold">Dateninseln</strong> im <a href={`${baseUrl}/glossar/schema-org-markup/`} class="text-dark font-semibold hover:text-lime-700 underline underline-offset-2">Schema.org Markup</a> und visualisiert deinen Knowledge Graph im deterministischen Vorher-Nachher-Vergleich.
        </p>
      </div>

      <!-- Eingabe-Sektion mit Tabs (Live Crawl vs. Quelltext) -->
      <div class="bg-white p-6 md:p-10 rounded-3xl shadow-xl border border-gray-100 mb-10">
        
        <!-- Tab Navigation -->
        <div class="flex items-center justify-between flex-wrap gap-4 pb-6 border-b border-gray-100 mb-6">
          <div class="inline-flex rounded-xl p-1 bg-gray-100 border border-gray-200 text-xs md:text-sm font-bold">
            <button id="tab-crawl-btn" class="px-4 py-2 rounded-lg bg-dark text-lime-accent shadow-sm transition-all cursor-pointer">
              🌐 Live-Domain-Scan
            </button>
            <button id="tab-manual-btn" class="px-4 py-2 rounded-lg text-gray-600 hover:text-dark transition-all cursor-pointer">
              💻 Quelltext / JSON-LD manuell
            </button>
          </div>

          <!-- 1-Click Demos Label -->
          <span class="text-xs font-semibold text-gray-500 hidden sm:inline">
            Oder sofort testen mit 1-Click-Demos ↓
          </span>
        </div>

        <!-- 1-Click Demo Profiles -->
        <div class="flex flex-wrap items-center gap-2 mb-8">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Demos:</span>
          <button type="button" class="demo-btn px-3 py-1.5 rounded-lg bg-lime-50 border border-lime-200 text-lime-900 text-xs font-bold hover:bg-lime-100 transition-all flex items-center gap-1.5 cursor-pointer" data-demo="teleschmiede">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Teleschmiede (Live 2026 - Score 96)
          </button>
          <button type="button" class="demo-btn px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium hover:bg-gray-100 transition-all flex items-center gap-1.5 cursor-pointer" data-demo="ecommerce">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            E-Commerce Shop (Score 42)
          </button>
          <button type="button" class="demo-btn px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium hover:bg-gray-100 transition-all flex items-center gap-1.5 cursor-pointer" data-demo="handwerk">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            Handwerksbetrieb (Score 38)
          </button>
          <button type="button" class="demo-btn px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 text-xs font-medium hover:bg-gray-100 transition-all flex items-center gap-1.5 cursor-pointer" data-demo="b2b">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            B2B SaaS / Agentur (Score 45)
          </button>
        </div>

        <!-- TAB 1: Live Crawl Input -->
        <div id="crawl-input-section">
          <label for="target-url" class="block text-sm font-bold text-dark mb-2">
            Ziel-Domain oder Website-URL eingeben:
          </label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input 
              type="url" 
              id="target-url" 
              placeholder="https://deine-website.de/" 
              class="flex-1 px-4 py-3.5 rounded-xl border border-gray-300 bg-gray-50 focus:ring-2 focus:ring-lime-accent focus:border-transparent text-base font-medium shadow-inner"
              aria-label="Ziel-Domain oder Website-URL"
            >
            <button 
              id="btn-analyze"
              class="bg-dark text-lime-accent font-bold px-8 py-3.5 rounded-xl hover:bg-black transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-base shrink-0 cursor-pointer"
            >
              <span>Domain analysieren</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-2">
            💡 Der Archetypen-Sampler analysiert deine Startseite und bis zu 3 relevante Unterseiten (Produkt, Service, Blog, Impressum).
          </p>
        </div>

        <!-- TAB 2: Manual JSON-LD Input -->
        <div id="manual-input-section" class="hidden">
          <label for="manual-json-input" class="block text-sm font-bold text-dark mb-2">
            HTML-Quelltext oder JSON-LD Snippets einfügen:
          </label>
          <textarea 
            id="manual-json-input"
            rows="6"
            placeholder='Füge hier deinen <script type="application/ld+json"> Block oder mehrere Snippets ein...'
            class="w-full p-4 rounded-xl border border-gray-300 bg-gray-50 font-mono text-xs text-gray-800 focus:ring-2 focus:ring-lime-accent focus:border-transparent shadow-inner mb-4"
          ></textarea>
          <button 
            id="btn-analyze-manual"
            class="bg-dark text-lime-accent font-bold px-8 py-3 rounded-xl hover:bg-black transition-all shadow-md flex items-center justify-center gap-2 text-sm cursor-pointer"
          >
            <span>Quelltext auswerten</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <!-- Error Container -->
        <div id="error-container" class="mt-6 p-4 rounded-xl border border-red-200 bg-red-50 text-red-700 text-sm hidden flex items-start gap-3">
          <span class="text-lg">⚠️</span>
          <div>
            <strong class="font-bold">Hinweis:</strong>
            <p id="error-text" class="mb-0 mt-0.5"></p>
          </div>
        </div>

        <!-- Analysis Progress Bar -->
        <div id="analysis-progress" class="mt-8 pt-6 border-t border-gray-100 hidden">
          <div class="flex items-center justify-between text-xs font-bold text-gray-700 mb-2">
            <span id="progress-status" class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-lime-500 animate-ping"></span>
              Initialisiere Archetypen-Scan...
            </span>
            <span class="text-gray-400">ca. 5–10 Sek.</span>
          </div>
          <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-lime-500 transition-all duration-300 rounded-full" style="width: 10%;"></div>
          </div>
        </div>

      </div>

      <!-- RESULTS CONTAINER -->
      <div id="results-container" class="space-y-8 hidden">
        
        <!-- Domain Label & Share Scan Banner -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gray-50 p-4 md:px-6 rounded-2xl border border-gray-200">
          <div class="flex items-center gap-2 text-sm text-dark font-medium truncate">
            <span class="text-gray-400">Analysierte Domain:</span>
            <strong id="analyzed-domain-label" class="font-mono text-dark truncate">-</strong>
          </div>
          <button id="btn-share-scan" type="button" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-gray-300 text-dark hover:bg-gray-100 hover:border-gray-400 text-xs font-bold transition-all shadow-sm cursor-pointer shrink-0">
            <svg class="w-4 h-4 text-lime-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
            <span id="share-scan-text">Link zu diesem Scan teilen</span>
          </button>
        </div>

        <!-- 1. KPI Score & Overview Card -->
        <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
            
            <!-- Left: Score Ring -->
            <div class="flex flex-col items-center justify-center text-center p-4 bg-gray-50 rounded-2xl border border-gray-100">
              <div class="relative w-28 h-28 flex items-center justify-center">
                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="40" stroke="#e5e7eb" stroke-width="8" fill="none" />
                  <circle id="score-ring" cx="50" cy="50" r="40" stroke="#10b981" stroke-width="8" stroke-dasharray="0, 251.2" stroke-linecap="round" fill="none" class="transition-all duration-1000" />
                </svg>
                <div class="absolute flex flex-col items-center">
                  <span id="score-value" class="text-3xl font-black text-dark leading-none">0</span>
                  <span class="text-[10px] font-bold text-gray-400 uppercase mt-0.5">Health</span>
                </div>
              </div>
              <div id="score-badge" class="mt-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/30">
                Wird berechnet...
              </div>
            </div>

            <!-- Mid: 3-Ebenen Breakdown -->
            <div class="space-y-3 md:col-span-2">
              <div>
                <div class="flex items-center justify-between text-xs font-bold text-gray-700 mb-1">
                  <span>1. Universelles Graph-Fundament</span>
                  <span id="foundation-score-txt" class="font-mono">0 / 40</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div id="foundation-bar" class="h-full bg-blue-500 rounded-full transition-all duration-700" style="width: 0%;"></div>
                </div>
                <p class="text-[11px] text-gray-500 mt-0.5">Zusammenhängender @graph, kanonische @id Fragment-URIs, inLanguage</p>
              </div>

              <div>
                <div class="flex items-center justify-between text-xs font-bold text-gray-700 mb-1">
                  <span>2. Archetypen-Benchmark (<span id="detected-archetype" class="text-lime-700">Wird ermittelt...</span>)</span>
                  <span id="archetype-score-txt" class="font-mono">0 / 35</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div id="archetype-bar" class="h-full bg-purple-500 rounded-full transition-all duration-700" style="width: 0%;"></div>
                </div>
                <p class="text-[11px] text-gray-500 mt-0.5">Branchenspezifische 12-Schienen Vollständigkeit (B2B, Shop, Handwerk, Praxis, SaaS, Konzern etc.)</p>
              </div>

              <div>
                <div class="flex items-center justify-between text-xs font-bold text-gray-700 mb-1">
                  <span>3. Entity Grounding (2026 Standards)</span>
                  <span id="grounding-score-txt" class="font-mono">0 / 25</span>
                </div>
                <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                  <div id="grounding-bar" class="h-full bg-lime-500 rounded-full transition-all duration-700" style="width: 0%;"></div>
                </div>
                <p class="text-[11px] text-gray-500 mt-0.5">Wikidata sameAs Verankerung, Person-Organization E-E-A-T Verknüpfung</p>
              </div>
            </div>

          </div>
        </div>

        <!-- 2. Issues & Dateninseln-Radar -->
        <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100">
          <h3 class="text-lg font-bold text-dark mb-4 flex items-center gap-2">
            <span class="text-xl">📡</span>
            Befund: Erkannte Dateninseln & Architektur-Lücken
          </h3>
          <div id="issues-radar-list" class="space-y-2.5">
            <!-- Dynamisch befüllt -->
          </div>
        </div>

        <!-- 3. Interaktiver Vektor-Graph (SVG) mit Vorher/Nachher Umschalter -->
        <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-100">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
            <div>
              <h3 class="text-lg font-bold text-dark mb-0.5">
                Interaktiver Wissensgraph
              </h3>
              <p class="text-xs text-gray-500">
                Klicke auf einzelne Knoten, um die Attribute im Inspektor darunter zu prüfen.
              </p>
            </div>

            <!-- Toggle Ist vs Soll -->
            <div class="inline-flex rounded-xl p-1 bg-gray-100 border border-gray-200">
              <button id="toggle-ist-btn" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-dark text-lime-accent shadow-sm transition-all cursor-pointer">
                🔍 Ist-Zustand
              </button>
              <button id="toggle-soll-btn" class="px-3 py-1.5 text-xs font-bold rounded-lg text-gray-500 hover:text-dark transition-all cursor-pointer">
                ✨ Soll-Zustand (2026 Master-Graph)
              </button>
            </div>
          </div>

          <!-- SVG Canvas Container -->
          <div class="relative w-full rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-2xl text-white">
            <!-- Legende -->
            <div class="absolute top-3 left-3 z-10 flex flex-wrap items-center gap-2.5 text-[11px] bg-slate-900/90 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/10 pointer-events-none text-white shadow-md">
              <span class="flex items-center gap-1 font-semibold text-blue-400"><span class="text-xs">👤</span> Person</span>
              <span class="flex items-center gap-1 font-semibold text-purple-400"><span class="text-xs">🏢</span> Organisation</span>
              <span class="flex items-center gap-1 font-semibold text-amber-400"><span class="text-xs">🌐</span> WebSite</span>
              <span class="flex items-center gap-1 font-semibold text-indigo-400"><span class="text-xs">🧭</span> Breadcrumbs</span>
              <span class="flex items-center gap-1 font-semibold text-pink-400"><span class="text-xs">📅</span> Event</span>
              <span class="flex items-center gap-1 font-semibold text-emerald-400"><span class="text-xs">⚙️</span> Service/Produkt</span>
              <span class="flex items-center gap-1 font-bold text-red-400 border-l border-white/20 pl-2"><span class="w-2 h-2 rounded-full bg-red-500 animate-pulse inline-block"></span> Isolierte Insel</span>
            </div>

            <svg id="visual-svg" viewBox="0 0 740 400" class="w-full h-auto select-none font-sans">
              <defs>
                <!-- Blueprint Dot Grid -->
                <pattern id="canvas-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" fill="#334155" opacity="0.35" />
                </pattern>
                <marker id="arrow-green" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 10 5 L 0 9 z" fill="#10b981" />
                </marker>
                <marker id="arrow-red" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 10 5 L 0 9 z" fill="#ef4444" />
                </marker>
              </defs>
              <rect width="100%" height="100%" fill="url(#canvas-grid)" />
              <g id="visual-svg-zones"></g>
              <g id="visual-svg-edges"></g>
              <g id="visual-svg-nodes"></g>
            </svg>
          </div>

          <!-- Node Inspector Box -->
          <div class="mt-4 p-4 rounded-2xl bg-gray-50 border border-gray-200">
            <div class="flex items-center justify-between gap-2 pb-2 border-b border-gray-200">
              <div class="flex items-center gap-2">
                <span id="inspector-node-name" class="font-bold text-sm text-dark">Knoten wählen</span>
                <span id="inspector-node-type" class="text-[10px] px-2 py-0.5 rounded bg-white border border-gray-200 text-gray-600 font-mono">Typ</span>
              </div>
              <span id="inspector-node-id" class="text-xs font-mono text-gray-500 truncate max-w-xs"></span>
            </div>
            <div id="inspector-props-list" class="mt-2 space-y-1">
              <!-- Properties -->
            </div>
          </div>
        </div>

        <!-- 4. Dreistufiger Conversion-Trichter (The Funnel) -->
        <div class="bg-dark text-white p-8 md:p-10 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-lime-accent/10 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-lime-400/20 text-lime-300 text-xs font-bold uppercase tracking-wider mb-4 border border-lime-400/30">
              🚀 Der 1-Klick-Lösungsansatz
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-3 tracking-tight">
              Möchtest du diese Dateninseln jetzt mit KI reparieren?
            </h3>
            <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6">
              Dein Analyse-Ergebnis zeigt konkrete Brüche in deinem Knowledge Graph. Mein <a href={`${baseUrl}/tools/entitaeten-graph-generator/`} class="text-lime-300 font-semibold underline hover:text-lime-200">Entitäten Graph Generator</a> übernimmt deine Domain und erzeugt für dich in Sekunden einen gehärteten KI-Master-Prompt, der alle Entitäten sauber in einem monolithischen <code class="text-lime-300 font-mono text-xs">@graph</code> nach 2026er Standard vernetzt. Ergänzend kannst du mit dem <a href={`${baseUrl}/tools/groundingpage-generator/`} class="text-lime-300 font-semibold underline hover:text-lime-200">Grounding Page Generator</a> deine Kernkompetenzen für ChatGPT und Perplexity absichern.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
              <a 
                id="btn-fix-with-ai" 
                href={`${baseUrl}/tools/entitaeten-graph-generator/`} 
                class="btn-primary"
              >
                <span>Mit KI-Prompt beheben</span>
                <span aria-hidden="true">→</span>
              </a>
              <a 
                href={`${baseUrl}/seo-sprechstunde/`} 
                class="px-6 py-3.5 rounded-xl border border-white/20 hover:border-white/40 text-white font-bold text-sm transition-all flex items-center justify-center gap-2 hover:bg-white/5"
              >
                <span>1:1 Analyse mit Jörg Zimmer buchen</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Hintergrund & Best Practices -->
        <div class="mt-12 bg-white p-6 md:p-8 rounded-3xl border border-gray-200 shadow-sm">
          <h3 class="text-xl md:text-2xl font-bold text-dark mb-3 font-headings">
            Hintergrund: Warum isolierte Dateninseln deine KI-Sichtbarkeit gefährden
          </h3>
          <p class="text-gray-600 text-sm md:text-base leading-relaxed mb-4">
            Viele SEO-Plugins generieren für jede Seite separate <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">&lt;script type="application/ld+json"&gt;</code>-Blöcke. Ohne eine verbindende <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">@id</code>-Struktur bleiben diese Informationen für Google AI Overviews, ChatGPT Search und Perplexity unzusammenhängende Bruchstücke. Im modernen <a href={`${baseUrl}/glossar/entity-seo/`} class="text-dark font-semibold hover:text-lime-700 underline">Entity SEO</a> zählt nicht die reine Masse an Schemas, sondern deren relationale Verknüpfung im Wissensgraphen.
          </p>
          <p class="text-gray-600 text-sm md:text-base leading-relaxed mb-0">
            Erfahre mehr über saubere Implementierungsmuster in unserem Leitfaden zu <a href={`${baseUrl}/glossar/technisches-schema-markup/`} class="text-dark font-semibold hover:text-lime-700 underline">technischem Schema Markup</a> oder lass deine gesamte Webseiten-Architektur von einem erfahrenen <a href={`${baseUrl}/seo-freelancer-berlin/`} class="text-dark font-semibold hover:text-lime-700 underline">SEO Freelancer in Berlin</a> prüfen.
          </p>
        </div>

      </div>

      <!-- Offizielle Master-Zitatbox (Semantisches E-E-A-T Zitat von Jörg Zimmer) -->
      <figure class="my-16 bg-neutral-50 border border-neutral-200 p-6 md:p-8 rounded-2xl shadow-sm">
        <div class="flex items-center gap-4 mb-4">
          <Image 
            src={portraitImage} 
            alt="Jörg Zimmer - Senior SEO & AI Search Consultant" 
            class="w-14 h-14 rounded-full object-cover object-top shadow-sm border-2 border-lime-accent" 
            width={56} 
            height={56} 
            loading="lazy"
          />
          <div>
            <h4 class="font-bold text-base md:text-lg text-dark mb-0">Jörg Zimmer</h4>
            <p class="text-xs md:text-sm text-neutral-600 mb-0">Senior SEO & AI Search Consultant</p>
          </div>
        </div>
        <blockquote class="text-base md:text-lg text-dark leading-relaxed italic border-l-4 border-lime-accent pl-4 my-4 font-normal">
          „An 1. Stelle steht immer die saubere Indizierung. Ja, das ist langweiliges technisches SEO, es ist aber die Grundlage für alles andere.“
        </blockquote>
        <figcaption class="mt-4 pt-3 border-t border-neutral-200/60 flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-500">
