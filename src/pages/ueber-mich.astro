            <!-- Instagram -->
            <a href="https://www.instagram.com/joerg.zimmer.berlin/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="Instagram">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              <span class="font-medium text-dark">Instagram</span>
            </a>
            <!-- Facebook -->
            <a href="https://www.facebook.com/teleschmiede" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="Facebook">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span class="font-medium text-dark">Facebook</span>
            </a>
            <!-- YouTube -->
            <a href="https://www.youtube.com/@Teleschmiede" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="YouTube">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              <span class="font-medium text-dark">YouTube</span>
            </a>
            <!-- TikTok -->
            <a href="https://www.tiktok.com/@teleschmiede" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="TikTok">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93v7.2c0 1.96-.86 3.91-2.45 5.05-1.57 1.13-3.66 1.4-5.51.79-1.94-.64-3.48-2.2-4-4.14-.49-1.83-.09-3.88 1.05-5.38 1.15-1.5 3.06-2.28 4.93-2.14v4.06c-.63-.03-1.28.16-1.78.58-.51.42-.81 1.05-.8 1.71.01.69.34 1.35.86 1.76.54.43 1.25.59 1.91.45.65-.13 1.22-.55 1.55-1.12.33-.56.46-1.23.46-1.87V.02z"/></svg>
              <span class="font-medium text-dark">TikTok</span>
            </a>
            <!-- Threads -->
            <a href="https://www.threads.com/@joerg.zimmer.berlin" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="Threads">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.1 11.234c0-2.483-1.636-4.571-4.708-4.571-3.411 0-5.717 2.457-5.717 6.16 0 3.766 2.32 6.136 5.862 6.136 2.768 0 4.67-1.393 5.372-3.413h-2.115c-.443.905-1.523 1.554-3.134 1.554-2.13 0-3.619-1.293-3.793-3.483h8.21c.015-.224.023-.464.023-.711v-.151c0-.495-.015-.99-.057-1.479l-.022-.249.006-.006c-.053-.418-.135-.826-.245-1.217-.184-.658-.458-1.282-.81-1.85-.357-.577-.8-1.092-1.31-1.52-.518-.435-1.121-.77-1.782-.988-.673-.223-1.408-.34-2.179-.34-3.714 0-6.198 2.508-6.198 6.447 0 3.864 2.404 6.357 6.126 6.357 3.398 0 5.642-1.69 6.22-4.148h1.996c-.63 3.364-3.649 5.864-8.216 5.864-4.831 0-8.256-3.197-8.256-8.156 0-4.99 3.493-8.213 8.35-8.213 4.27 0 6.945 2.616 6.945 6.079v.18h-10.22c.24-2.146 1.838-3.633 4.092-3.633 1.954 0 3.327 1.134 3.382 2.739h2.155z"/></svg>
