---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import { getGitModDate } from '../utils/git-date';

import portraitImage from '../assets/images/profile/joerg-zimmer-portrait.webp';
import rucksackImage from '../assets/images/profile/website-boosting-rucksack.webp';
import katzeHoodieImage from '../assets/images/profile/katze-seo-hoodie.webp';
import magazinImage from '../assets/images/profile/website-boosting-magazin.webp';
import lifestyleImage from '../assets/images/profile/joerg-lifestyle.webp';
import katzePortraitImage from '../assets/images/profile/joerg-zimmer-katze.webp';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const lastReviewed = getGitModDate('src/pages/ueber-mich.astro');
const portraitImageWebp = await getImage({ src: portraitImage, format: 'webp' });

const offers = [
  {
    name: "Sprechstunde (480€)",
    description: "2-stündige Live-Analyse und Strategieberatung für 480€ Pauschal."
  },
  {
    name: "SEO Troubleshooting & Live Coaching (ab 3.600€)",
    description: "Hilfe in Notfällen, bei Relaunch-Absturz oder strategischen Fragen ab 3.600€."
  },
  {
    name: "Keyword-Potenzialanalyse (ab 960€)",
    description: "Data-Mining im Google-Universum inklusive Suchvolumen und Wettbewerb für 960€."
  },
  {
    name: "10-Stunden Paket (1.920€)",
    description: "Flexibles Leistungspaket für tiefgreifende Audits und Setup-Phasen für 1.920€ Pauschal."
  },
  {
    name: "Monatlicher Retainer (ab 1.920€)",
    description: "Fortlaufende Betreuung und strategische Optimierung ab 1.920€ monatlich."
  },
  {
    name: "Zweite Meinung / Angebotsprüfung (240€/h)",
    description: "Unabhängige Einschätzung bisheriger Agenturarbeit oder aktueller SEO-Angebote. Diskret und ohne Account-Zugänge möglich."
  }
];
---

<Layout
  title="Über mich | Jörg Zimmer - SEO, GEO, AI Visibility Freelancer"
  description="Lerne Jörg Zimmer kennen: SEO, GEO, AI Visibility Freelancer aus Berlin mit 20+ Jahren Erfahrung, Fokus auf messbare Erfolge und ehrliche Beratung."
  ogImage={portraitImage.src}
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-6 flex flex-wrap items-center gap-x-3">
        <span>Über mich</span>
        {lastReviewed && (
          <span class="text-gray-muted text-xs font-normal italic border-l border-gray-200 pl-3">Zuletzt aktualisiert: {new Date(lastReviewed).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        )}
      </p>


      <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
        Digitaler Architekt & <span class="highlight">Entität</span> im Google Universum.
      </h1>

      <nav class="flex flex-wrap gap-4 mb-12 border-b border-gray-100 pb-6">
        <a href="#expertise" class="text-sm font-medium text-gray-muted hover:text-lime-600 transition-colors" title="Expertise">Expertise</a>
        <span class="text-gray-200">/</span>
        <a href="#rollen" class="text-sm font-medium text-gray-muted hover:text-lime-600 transition-colors" title="Rollen & Fokus">Rollen & Fokus</a>
        <span class="text-gray-200">/</span>
        <a href="#entity-facts" class="text-sm font-medium text-gray-muted hover:text-lime-600 transition-colors" title="Entity Facts">Entity Facts</a>
      </nav>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20">
    <div class="container-narrow">
      <div class="grid md:grid-cols-3 gap-12">
        <!-- Profile Image -->
        <div class="md:col-span-1">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer Porträt - SEO, GEO, AI Visibility Freelancer aus Berlin"
            width={256}
            height={256}
            class="w-full aspect-square object-cover object-top rounded-2xl h-auto"
            loading="eager"
            fetchpriority="high"
          />

          <!-- Quick Facts -->
          <div class="mt-8 space-y-4">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">Dessau (geboren) → Berlin Spandau</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">48 Jahre, verheiratet, 3 Töchter</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">Gegründet: 23.07.2001</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">20+ Jahre SEO/SEA</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">240€ / Stunde</span>
            </div>
          </div>

          <!-- Lifestyle Images -->
          <Image
            src={rucksackImage}
            alt="Jörg Zimmer mit Website Boosting Rucksack - SEO-Experte unterwegs"
            width={800}
            height={1422}
            class="w-full mt-8 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={katzeHoodieImage}
            alt="Katze von Jörg Zimmer im SEO-Hoodie - der heimliche SEO-Assistent"
            width={800}
            height={1066}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={magazinImage}
            alt="Jörg Zimmer im Amsterdam-Hoodie - zu Gast bei Google"
            width={800}
            height={1198}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={lifestyleImage}
            alt="Jörg Zimmer - persönliches Lifestyle-Foto des SEO-Freelancers"
            width={800}
            height={1422}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />
        </div>

        <!-- Text Content -->
        <div class="md:col-span-2 space-y-6">
          <div id="expertise" class="space-y-6">
            <p class="text-xl text-dark leading-relaxed font-medium">
              ALOHA! 🌻 Ich bin Jörg Zimmer – dein Partner im Google Universum. Seit Juli 2001 helfe ich Unternehmen, online sichtbar zu werden. Nachhaltig, nicht nur auf dem Papier.
            </p>

            <p class="text-gray-muted">
              Über 25 Jahre SEO-Praxis haben mich eines gelehrt: Google denkt in Entitäten, nicht in Keywords. Mein Job? Deine Marke als Autorität positionieren – technisch brillant, inhaltlich relevant.
            </p>
          </div>

          <div id="rollen" class="pt-12 space-y-12">
            <h2 class="text-2xl md:text-3xl font-bold border-l-4 border-lime-accent pl-6">Vier Rollen, ein Ziel: Performance.</h2>
            
            <div class="grid sm:grid-cols-2 gap-8">
              <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
                <h3 class="text-xl font-bold mb-4">1. Der Berater & Architekt</h3>
                <p class="text-sm text-gray-muted">Strategisches SEO, Relaunch-Begleitung und technische Audits. Ich baue das Fundament, auf dem dein Erfolg wächst.</p>
                <a href={`${baseUrl}/seo-freelancer-berlin/`} class="inline-block mt-4 text-sm font-bold text-lime-600 hover:text-dark transition-colors" title="SEO Freelancer Berlin →">SEO Freelancer Berlin →</a>
              </div>
              <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
                <h3 class="text-xl font-bold mb-4">2. Der Speaker & Mentor</h3>
                <p class="text-sm text-gray-muted">Vom SEO Stammtisch Berlin bis hin zu Fachkonferenzen: Ich teile mein Wissen und begleite Unternehmen als strategischer Mentor.</p>
              </div>
              <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
                <h3 class="text-xl font-bold mb-4">3. Der KI-Spezialist</h3>
                <p class="text-sm text-gray-muted">GEO & LLM-Optimierung. Ich mache deine Website fit für den <strong>Google KI-Modus</strong> und die Suche der Zukunft.</p>
              </div>
              <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
                <h3 class="text-xl font-bold mb-4">4. Der Netzwerker</h3>
                <p class="text-sm text-gray-muted">Aktiv bei Campixx, SEOpresso und als Mitgründer des Freelancer Teams. Vernetzung ist mein Treibstoff.</p>
              </div>
            </div>
          </div>



          <div id="entity-facts" class="pt-20">
            <div class="bg-dark rounded-[2.5rem] p-12 text-white relative overflow-hidden">
               <div class="absolute top-0 right-0 w-64 h-64 bg-lime-accent rounded-full opacity-10 blur-3xl -mr-32 -mt-32"></div>
               <h2 class="text-3xl font-bold mb-8 relative z-10">Entity Facts <span class="text-sm font-mono text-lime-accent opacity-50 block mt-1 uppercase tracking-widest">Knowledge Graph Data</span></h2>
               
               <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6 relative z-10">
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Full Name</p>
                   <p class="text-lg font-medium">Jörg Zimmer</p>
                 </div>
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Born</p>
                   <p class="text-lg font-medium">Dessau, Deutschland</p>
                 </div>
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Based In</p>
                   <p class="text-lg font-medium">Berlin Spandau</p>
                 </div>
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Founder Of</p>
                   <p class="text-lg font-medium">Jörg Zimmer (Freelancer seit 2001)</p>
                 </div>
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Key Expertise</p>
                   <p class="text-lg font-medium">SEO, SEA, GEO, AI Ethics</p>
                 </div>
                 <div class="border-b border-white/10 pb-4">
                   <p class="text-xs uppercase tracking-widest text-lime-accent mb-1">Memberships</p>
                   <p class="text-lg font-medium">Freelancer Team, SEO Stammtisch</p>
                 </div>
               </div>

               <p class="mt-12 text-sm text-white/50 text-center italic">
                 Diese Daten dienen der eindeutigen Identifikation im Google Knowledge Graph gemäß Schema.org/Person.
               </p>
            </div>
          </div>

          <h2 class="text-2xl font-bold pt-6">Meine Google-Expertise</h2>

          <ul class="space-y-3 text-gray-muted">
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Suchtraffic (auch international)
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Ads
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Analytics
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Search Console
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Unternehmensprofil
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              YouTube
            </li>
          </ul>

          <h2 class="text-2xl font-bold pt-6">Mein Versprechen</h2>

          <p class="text-gray-muted">
            Als Senior auf meinem Gebiet liegt mein Stundensatz bei 240 Euro.
            Dafür bekommst du alles, was ich weiß. Du kannst mich stundenweise buchen.
          </p>

          <p class="text-gray-muted">
            Fairness und Unabhängigkeit sind meine Leitmotive. Man ruft mich meist dann als spezialisierten Freelancer, wenn bereits andere Agenturen an einer tiefen Detailfrage oder einem komplexen Problem gescheitert sind.
          </p>

          <h2 class="text-2xl font-bold pt-12 border-t border-gray-100 mt-12 mb-6">Netzwerk & Profile</h2>
          <p class="text-gray-muted mb-6">Hier bin ich ebenfalls unterwegs und freue mich über Vernetzung und Austausch:</p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="LinkedIn">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              <span class="font-medium text-dark">LinkedIn</span>
            </a>
            <!-- Xing -->
            <a href="https://www.xing.com/profile/Joerg_Zimmer6" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-lime-50 hover:text-lime-700 transition-colors border border-gray-100" title="Xing">
              <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.188 0c-.517 0-.741.325-.927.66 0 0-7.455 13.224-7.702 13.657.015.024 4.919 9.023 4.919 9.023.17.308.436.66.967.66h3.454c.211 0 .375-.078.463-.22.089-.151.089-.346-.009-.536l-4.879-8.916c-.004-.006-.004-.016 0-.022L22.139.756c.095-.191.097-.387.006-.535C22.056.078 21.894 0 21.686 0h-3.498zM3.648 4.74c-.211 0-.385.074-.473.216-.09.149-.078.339.02.531l2.34 4.05c.004.01.004.016 0 .021L1.86 16.026c-.099.188-.093.381 0 .529.085.142.239.234.45.234h3.461c.518 0 .766-.348.945-.667l3.734-6.609-2.378-4.155c-.172-.315-.434-.659-.962-.659H3.648v.041z"/></svg>
              <span class="font-medium text-dark">Xing</span>
