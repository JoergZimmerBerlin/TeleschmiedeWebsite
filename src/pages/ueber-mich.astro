---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import portraitImage from '../assets/images/profile/joerg-zimmer-portrait.jpg';
import rucksackImage from '../assets/images/profile/website-boosting-rucksack.jpg';
import katzeHoodieImage from '../assets/images/profile/katze-seo-hoodie.jpg';
import magazinImage from '../assets/images/profile/website-boosting-magazin.jpg';
import lifestyleImage from '../assets/images/profile/joerg-lifestyle.jpg';
import katzePortraitImage from '../assets/images/profile/joerg-zimmer-katze.jpg';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const portraitImageWebp = await getImage({ src: portraitImage, format: 'webp' });
---

<Layout
  title="Über mich | Jörg Zimmer - SEO Freelancer Berlin"
  description="Lerne Jörg Zimmer kennen: SEO & SEA Freelancer aus Berlin mit über 20 Jahren Erfahrung. Mein Fokus liegt auf messbaren Erfolgen und ehrlicher Beratung. ALOHA! 🌻"
>
  <!-- Hero -->
  <section class="section">
    <div class="container-narrow">
      <p class="subheadline mb-6">Über mich</p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8">
        Digitaler Architekt mit
        <span class="highlight">Leidenschaft</span>
        für Suchmaschinen.
      </h1>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20">
    <div class="container-narrow">
      <div class="grid md:grid-cols-3 gap-12">
        <!-- Profile Image -->
        <div class="md:col-span-1">
          <Image
            src={portraitImage}
            alt="Jörg Zimmer - SEO & SEA Freelancer aus Berlin Spandau, Porträtfoto"
            width={1309}
            height={1020}
            class="w-full aspect-square object-cover object-top rounded-2xl h-auto"
            loading="eager"
            fetchpriority="high"
          />

          <!-- Quick Facts -->
          <div class="mt-8 space-y-4">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">Dessau (geboren) → Berlin Spandau</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">48 Jahre, verheiratet, 3 Töchter</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">Gegründet: 23.07.2001</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">20+ Jahre SEO/SEA</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 bg-lime-accent rounded-full"></span>
              <span class="text-sm text-gray-muted">200€ / Stunde</span>
            </div>
          </div>

          <!-- Lifestyle Images -->
          <Image
            src={rucksackImage}
            alt="Jörg Zimmer mit Website Boosting Rucksack - SEO-Experte unterwegs"
            width={800}
            height={1422}
            class="w-full mt-8 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={katzeHoodieImage}
            alt="Katze von Jörg Zimmer im SEO-Hoodie - der heimliche SEO-Assistent"
            width={800}
            height={1066}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={magazinImage}
            alt="Jörg Zimmer liest das Website Boosting Magazin - immer auf dem neuesten SEO-Stand"
            width={800}
            height={1198}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />

          <Image
            src={lifestyleImage}
            alt="Jörg Zimmer - persönliches Lifestyle-Foto des SEO-Freelancers"
            width={800}
            height={1422}
            class="w-full mt-4 rounded-2xl object-cover object-top h-auto"
            loading="lazy"
          />
        </div>

        <!-- Text Content -->
        <div class="md:col-span-2 space-y-6">
          <p class="text-lg">
            ALOHA! 🌻 Ich bin Jörg Zimmer – SEO- und SEA-Freelancer aus Berlin Spandau.
            Seit Juli 2001 beschäftige ich mich professionell mit allem, was Google zu bieten hat.
            Oder wie ich es oft sage: <strong>"Ich bin mit Google zusammen aufgewachsen und habe im Sandkasten gespielt."</strong>
          </p>

          <p class="text-gray-muted">
            Nach Stationen in Dessau und Stuttgart (inkl. einem Jahr als Gasthörer an der HdM) lebe ich nun seit über 15 Jahren in Berlin Spandau.
            Suchmaschinenoptimierung ist für mich kein bloßes Abhaken von Checklisten. Es ist das Zusammenspiel von technischer Präzision und maximaler Nutzererfahrung.
            Dafür entwerfe ich Konzepte, die nicht nur auf dem Papier gut aussehen, sondern sich einfach umsetzen lassen.
          </p>

          <p class="text-gray-muted">
            In der Branche bin ich vernetzt: Als aktives Mitglied im "SEO Stammtisch Berlin", Teilnehmer der "Campixx", Mitgründer vom "Freelancer Team" und regelmäßiger Gast bei Netzwerk-Abenden wie der "Überstunde Berlin" oder der "Freelance Unlocked" Konferenz.
            Dieser Austausch hält meinen Blick scharf und mein Wissen aktuell.
          </p>

          <p class="text-gray-muted italic">
            "Ich versetze mich immer in die Zielgruppe meiner Kunden. Wer versteht, wie Menschen suchen, versteht auch, wie Google rankt."
          </p>

          <h2 class="text-2xl font-bold pt-6">Meine Google-Expertise</h2>

          <ul class="space-y-3 text-gray-muted">
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Suchtraffic (auch international)
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Ads
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Analytics
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Search Console
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              Google Unternehmensprofil
            </li>
            <li class="flex items-start gap-3">
              <span class="text-lime-accent mt-1">→</span>
              YouTube
            </li>
          </ul>

          <h2 class="text-2xl font-bold pt-6">Mein Versprechen</h2>

          <p class="text-gray-muted">
            Als Senior auf meinem Gebiet liegt mein Stundensatz bei 200 Euro.
            Dafür bekommst du alles, was ich weiß. Du kannst mich stundenweise buchen –
            auch als zweite Meinung zum Einschätzen deiner bisherigen Agenturen.
          </p>

          <p class="text-gray-muted">
            Fairness und Unabhängigkeit sind meine Leitmotive. Man ruft mich meist dann als spezialisierten Freelancer, wenn bereits andere Agenturen an einer tiefen Detailfrage oder einem komplexen Problem gescheitert sind.
          </p>

          <div class="bg-gray-50 rounded-2xl p-6 mt-8">
            <div class="flex flex-col md:flex-row gap-6 items-center">
              <Image
                src={katzePortraitImage}
                alt="Jörg Zimmer mit seiner Katze - persönliche Seite des SEO-Experten"
                width={256}
                height={256}
                class="w-24 h-24 object-cover object-top rounded-full flex-shrink-0"
                loading="lazy"
              />
              <div>
                <p class="text-lg font-medium text-dark">
                  "Das Thema ist komplex und extrem wertvoll. Ich bringe es für dich auf den Punkt."
                </p>
                <p class="text-gray-muted mt-2">ALOHA! 🌻</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-gray-50">
    <div class="container-narrow text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">
        Bereit für ein Gespräch?
      </h2>
      <p class="text-gray-muted mb-8 max-w-xl mx-auto">
        Nutze die 2-stündige SEO-Sprechstunde per Videocall für 400€.
        Schreib mir eine Nachricht, wenn du so weit bist!
      </p>
      <a href={`${baseUrl}/kontakt/`} class="btn-primary">
        Jetzt Kontakt aufnehmen
      </a>
    </div>
  </section>
  <!-- Schema Markup -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://teleschmie.de/#person",
          "name": "Jörg Zimmer",
          "url": "https://teleschmie.de/ueber-mich/",
          "image": `https://teleschmie.de${portraitImageWebp.src}`,
          "jobTitle": "SEO & SEA Freelancer",
          "worksFor": { "@id": "https://teleschmie.de/#service" },
          "description": "Jörg Zimmer ist ein erfahrener Performance Marketing Spezialist und SEO & SEA Freelancer aus Berlin Spandau.",
          "knowsAbout": [
            "Search Engine Optimization (SEO)",
            "Search Engine Advertising (SEA)",
            "Google Ads",
            "Google Analytics",
            "Performance Marketing",
            "Generative Engine Optimization (GEO)",
            "AI Visibility Tracking",
            "Technical SEO Audits",
            "Conversion Rate Optimization (CRO)"
          ],
          "subjectOf": [
            {
              "@type": "CreativeWork",
              "name": "SEOpresso Podcast - Interview mit Jörg Zimmer",
              "url": "https://teleschmie.de/blog/seopresso-podcast-maximilian-muhr/"
            },
            {
              "@type": "CreativeWork",
              "name": "Interview: SEO persönlich - Antonia Blago trifft Jörg Zimmer",
              "url": "https://teleschmie.de/blog/seopresso-seo-persoenlich-interview/"
            },
            {
              "@type": "CreativeWork",
              "name": "Campixx Berlin - Speaker & Teilnehmer",
              "url": "https://www.campixx.de/"
            }
          ],
          "sameAs": [
            "https://www.linkedin.com/in/joerg-zimmer-seo-sea-freelancer-berlin-spandau/",
            "https://www.xing.com/profile/Joerg_Zimmer6",
            "https://linktr.ee/jorgzimmer",
            "https://www.instagram.com/joerg.zimmer.berlin/",
            "https://www.facebook.com/teleschmiede",
            "https://www.youtube.com/@Teleschmiede",
            "https://www.tiktok.com/@teleschmiede",
            "https://www.threads.com/@joerg.zimmer.berlin"
          ]
        },
        {
          "@type": "ProfessionalService",
          "@id": "https://teleschmie.de/#organization",
          "name": "Jörg Zimmer - Teleschmiede",
          "foundingDate": "2001-07-23",
          "url": "https://teleschmie.de",
          "logo": "https://teleschmie.de/images/logo-teleschmiede.png",
          "image": "https://teleschmie.de/images/profile/joerg-zimmer-portrait.jpg",
          "description": "Technisches SEO, Relaunch-Begleitung und ehrliche Google Ads Beratung von Jörg Zimmer.",
          "telephone": "+493049208184",
          "email": "info@teleschmie.de",
          "priceRange": "€€€",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Zu den Fichtewiesen 16",
            "addressLocality": "Berlin",
            "postalCode": "13587",
            "addressCountry": "DE"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 52.5591,
            "longitude": 13.1883
          },
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "reviewCount": "24"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [{
            "@type": "Question",
            "name": "Was kostet eine SEO-Beratung bei Jörg Zimmer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Der Stundensatz liegt bei 200€ für individuelle Beratung. Die SEO-Sprechstunde wird als 2-stündiges Paket für 400€ angeboten."
            }
          }, {
            "@type": "Question",
            "name": "Bietet Jörg Zimmer auch Google Ads (SEA) an?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja, ich habe über 10 Jahre mit Hauptfokus auf Google Ads gearbeitet und bin offizieller Google Partner."
            }
          }]
        }
      ]
    }
  </script>
</Layout>
