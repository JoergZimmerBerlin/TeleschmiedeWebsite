---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import fs from 'node:fs';
import path from 'node:path';

// Wir nutzen die originalen YouTube Thumbnails, die im Hintergrund heruntergeladen werden.
// Da Astro Importe statisch prüft, nutzen wir vorerst Platzhalter, falls die originalen noch nicht da sind,
// oder importieren sie direkt, sobald das Python-Skript fertig ist.
// Um Build-Fehler zu vermeiden, binden wir sie hier per dynamischem relativen Path oder aus dem public Ordner ein.
// Da wir sie ins src/assets/images/youtube/ laden, importieren wir sie regulär:
import imgSeopresso from '../assets/images/youtube/dVGOMAVUNQk.jpg';
import imgAntonia from '../assets/images/youtube/ZIFCXUXypSc.jpg';
import imgMagic from '../assets/images/youtube/32YkPQtOJDU.jpg';
import imgRoland from '../assets/images/youtube/tD7cXuVcRPA.jpg';

const pageTitle = "Videos & Podcast Interviews | Jörg Zimmer (2026)";
const pageDescription = "Alle Video-Interviews, Podcast-Auftritte und Live-Checks von Jörg Zimmer zum Thema SEO, GEO und KI Suche.";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const getTranscript = (id) => {
  try {
    const filePath = path.join(process.cwd(), 'src', 'data', 'transcripts', `${id}.txt`);
    if (fs.existsSync(filePath)) {
      const text = fs.readFileSync(filePath, 'utf-8');
      return text;
    }
  } catch (e) {
    // ignore
  }
  return "Transkript wird derzeit generiert oder ist für dieses Video nicht verfügbar.";
};

const formatDescription = (text, videoId) => {
  if (!text) return "";
  let formatted = text
    .replace(/\n/g, '<br/>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  
  // Match timestamps like HH:MM:SS or MM:SS
  formatted = formatted.replace(/\b(?:([0-9]{1,2}):)?([0-9]{2}):([0-9]{2})\b/g, (match, h, m, s) => {
    const hours = parseInt(h || 0, 10);
    const minutes = parseInt(m, 10);
    const seconds = parseInt(s, 10);
    const totalSeconds = (hours * 3600) + (minutes * 60) + seconds;
    return `<a href="https://www.youtube.com/watch?v=${videoId}&t=${totalSeconds}s" target="_blank" rel="noopener noreferrer" class="text-lime-600 font-bold hover:underline transition-colors">${match}</a>`;
  });
  return formatted;
};

const videos = [
  {
    id: 'tD7cXuVcRPA',
    title: 'SEO Live-Check 2026: Rankings, GEO und KI Suche erklärt mit Jörg Zimmer und Roland Golla',
    date: '2026-08-13',
    thumbnail: imgRoland,
    host: 'Roland Golla (SEO Sprechstunde)',
    description: 'Eine ausführliche Live-Analyse, wie sich die Suchergebnisse durch KI verändern und was das für die Praxis bedeutet.'
  },
  {
    id: 'ZIFCXUXypSc',
    title: 'Folge 4: SEO vs. Google Ads: Was funktioniert 2025 noch? Klartext mit Jörg Zimmer',
    date: '2025-07-20',
    thumbnail: imgAntonia,
    host: 'Antonia Blago',
    description: 'Interview über die Schnittmenge von klassischem SEO und Künstlicher Intelligenz. Wie bereiten sich Unternehmen vor?'
  },
  {
    id: 'dVGOMAVUNQk',
    title: 'SEO Persönlich mit Jörg Zimmer | Ep.207',
    date: '2025-07-04',
    thumbnail: imgSeopresso,
    host: 'Björn Darko (SEOpresso Podcast)',
    description: 'Eine Reise durch 25 Jahre SEO-Geschichte und warum die Basisarbeit immer noch das Wichtigste ist.'
  },
  {
    id: '32YkPQtOJDU',
    title: 'SEO und die digitale Welt: Ein Gespräch mit Jörg Zimmer',
    date: '2025-06-01',
    thumbnail: imgMagic,
    host: 'Magic Writing Podcast',
    description: 'Diskussion über den aktuellen Stand von SEO und warum gute Texte wichtiger sind denn je.'
  }
];

const siteUrl = import.meta.env.SITE || 'https://teleschmie.de';
const currentPath = Astro.url.pathname;

const videoItemList = {
  "@type": "ItemList",
  "itemListElement": videos.map((video, index) => {
    const fullText = getTranscript(video.id) || video.description;
    const cleanText = fullText.replace(/<[^>]*>?/gm, '');
    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "VideoObject",
        "name": video.title,
        "description": cleanText.length > 8000 ? cleanText.substring(0, 7997) + '...' : cleanText,
        "thumbnailUrl": `${siteUrl}${video.thumbnail.src}`,
        "uploadDate": video.date,
        "embedUrl": `https://www.youtube.com/embed/${video.id}`,
        "url": `https://www.youtube.com/watch?v=${video.id}`,
        "actor": [
          {
            "@type": "Person",
            "name": "Jörg Zimmer",
            "url": "https://teleschmie.de/"
          }
        ],
        "creator": {
          "@type": "Person",
          "name": video.host
        },
        "about": {
          "@type": "Person",
          "name": "Jörg Zimmer",
          "url": "https://teleschmie.de/"
        }
      }
    };
  })
};
---

<Layout title={pageTitle} description={pageDescription}>
  <Schema type="videos" title={pageTitle} description={pageDescription} mainEntity={videoItemList} />
  <!-- Hero Section (Semantisch analog zu index/leistungen) -->
  <section class="section-hero relative overflow-hidden bg-white pt-12 pb-20 md:pb-32 border-b border-gray-100">
    <div class="container-narrow">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-full text-center md:text-left">
          <p class="subheadline mb-6 inline-block uppercase text-sm tracking-widest text-dark font-bold bg-lime-accent px-4 py-1 rounded-full">Media & Wissen</p>

          <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-normal mb-8">
            Videos & <span class="highlight">Podcasts.</span>
          </h1>

          <p class="text-lg md:text-xl text-gray-muted max-w-2xl mx-auto md:mx-0">
            Live-Checks, Interviews und tiefgreifende Analysen. Hier findest du alle meine öffentlichen Auftritte 
            rund um die Themen SEO, GEO und Künstliche Intelligenz.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 bg-gray-50">
    <div class="container-narrow">
      <div class="space-y-16">
        {videos.map(video => (
          <article class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-gray-100 relative overflow-hidden" itemscope itemtype="https://schema.org/VideoObject">
            <meta itemprop="name" content={video.title} />
            <meta itemprop="description" content={video.description} />
            <meta itemprop="uploadDate" content={video.date} />
            <meta itemprop="embedUrl" content={`https://www.youtube.com/embed/${video.id}`} />
            
            <!-- Date Badge -->
            <div class="absolute top-0 right-0 bg-lime-100 text-lime-800 text-xs font-bold px-4 py-2 rounded-bl-2xl z-10">
              {new Date(video.date).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
            
            <div class="mb-6 space-y-3">
              <div class="flex items-center gap-2 text-sm text-lime-700 font-bold uppercase tracking-wide">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                  <path d="M11.25 4.533A9.707 9.707 0 006 3a9.735 9.735 0 00-3.25.555.75.75 0 00-.5.707v14.25a.75.75 0 001 .707A8.237 8.237 0 016 18.75c1.995 0 3.823.707 5.25 1.886V4.533zM12.75 20.636A8.214 8.214 0 0118 18.75c1.68 0 3.282.426 4.75 1.194.58.304 1.25-.115 1.25-.757V4.262a.75.75 0 00-.5-.707A9.735 9.735 0 0018 3a9.707 9.707 0 00-5.25 1.533v16.103z" />
                </svg>
                Gast bei: {video.host}
              </div>
              <h2 class="text-2xl md:text-3xl font-bold text-dark">{video.title}</h2>
              <p class="text-gray-muted leading-relaxed text-lg">{video.description}</p>
            </div>
            
            <div class="mb-8">
              <YouTubeFacade 
                videoId={video.id} 
                title={video.title} 
                thumbnail={video.thumbnail} 
              />
            </div>
            
            <div class="space-y-4">
              <!-- AEO Hidden Transcript / Summary -->
              <details class="group mt-8 border border-gray-200 rounded-2xl bg-white overflow-hidden shadow-sm hover:border-lime-200 transition-colors">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-5 text-dark hover:bg-gray-50 transition-colors">
                  <span class="flex items-center gap-3 text-sm md:text-base font-bold">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-lime-600">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                    YouTube Beschreibung anzeigen
                  </span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-gray-400">
                    <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </summary>
                <div class="p-5 pt-0 text-gray-muted text-sm leading-relaxed border-t border-gray-100 bg-gray-50/50">
                  <div class="pt-4 max-h-96 overflow-y-auto pr-4 custom-scrollbar whitespace-pre-wrap" itemprop="transcript" set:html={formatDescription(getTranscript(video.id), video.id)}>
                  </div>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }
</style>
